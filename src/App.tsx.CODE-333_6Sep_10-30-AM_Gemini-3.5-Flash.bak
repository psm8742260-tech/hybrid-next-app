                        </div>
                        <span className={`text-[8px] mt-1 tracking-tight transition-all ${currentWorkerScreen === 'dashboard' ? 'text-[#082c75] font-black' : 'text-gray-400 font-bold'}`}>డ్యాష్‌బోర్డ్</span>
