                        <div className="bg-white p-4 rounded-2xl border border-gray-100 shadow-xs space-y-4 text-xs">
                          {/* CREDIT CARD MOCKUP */}
                          <div className="bg-gradient-to-br from-indigo-700 to-purple-900 text-white p-4 rounded-2xl border border-white/10 shadow-lg space-y-4 relative overflow-hidden select-none">
                            <div className="absolute top-0 right-0 w-24 h-24 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                            
                            <div className="flex justify-between items-center">
                              <span className="font-extrabold text-[10px] tracking-widest text-[#FFC000]">CWRB DIGITAL CARD</span>
                              <span className="text-[9px] text-indigo-200">VISA</span>
                            </div>

                            <div className="space-y-1 py-1">
                              <span className="text-[8px] text-indigo-200 uppercase tracking-wider block">కార్డు నంబర్ / Card Number</span>
                              <div className="font-mono text-sm tracking-widest text-white">4112 •••• •••• 9810</div>
                            </div>

                            <div className="flex justify-between items-end text-[9px]">
                              <div>
                                <span className="text-[7px] text-indigo-200 block">కార్డుదారుడి పేరు</span>
                                <span className="font-bold text-white uppercase">{userPhone ? 'USER ' + userPhone.slice(-4) : 'CWRB MEMBER'}</span>
                              </div>
                              <div>
                                <span className="text-[7px] text-indigo-200 block">వ్యాలిడిటీ</span>
                                <span className="font-bold text-white">12/28</span>
                              </div>
                            </div>
                          </div>

                          {/* RATING SELECTOR */}
                          <div className="space-y-2 border-t border-gray-100 pt-3">
