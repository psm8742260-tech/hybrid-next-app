                        </div>
                        <span className={`text-[8px] mt-1 tracking-tight transition-all ${currentWorkerScreen === 'diary' ? 'text-[#082c75] font-black' : 'text-gray-400 font-bold'}`}>{t('diary', language)}</span>
                      </button>
