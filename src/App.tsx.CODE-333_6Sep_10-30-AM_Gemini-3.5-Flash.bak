export default function App() {
  const [toasts, setToasts] = useState<{id: string, message: string}[]>([]);

  useEffect(() => {
    const originalAlert = window.alert;
    window.alert = (message: string) => {
      const id = Math.random().toString();
      setToasts(prev => [...prev, { id, message }]);
      setTimeout(() => {
        setToasts(prev => prev.filter(t => t.id !== id));
      }, 3500);
    };
    return () => {
      window.alert = originalAlert;
    };
  }, []);

  // Splash & role states
  const [showSplash, setShowSplash] = useState(false);
  // PWA Firestore Sync Listener
  useEffect(() => {
    if (!db) return;
    
    // Listen for remote update signals from Admin Panel
    const unsubscribe = onSnapshot(doc(db, 'settings', 'pwa_update'), (snapshot) => {
      if (snapshot.exists()) {
        const data = snapshot.data();
        const remoteVersion = data.version;
        const localVersion = localStorage.getItem('cwb_published_cache_version');
        
        // If version changed, trigger the update flow
        if (remoteVersion && remoteVersion !== localVersion) {
          console.log("🚀 Remote update detected:", remoteVersion);
          localStorage.setItem('cwb_published_cache_version', remoteVersion);
          
          // Small delay before reload to ensure storage is set
          setTimeout(() => {
            forceUpdateApp();
          }, 1000);
        }
      }
    });
    
    return () => unsubscribe();
  }, []);

  const [showAppWalkthrough, setShowAppWalkthrough] = useState<boolean>(false);
  const [activeTab, setActiveTab] = useState<'customer' | 'worker' | 'provider'>('customer');
  const [currentWorkerScreen, setCurrentWorkerScreen] = useState<'dashboard' | 'wallet' | 'diary' | 'community' | 'entertainment'>('dashboard');
  const [activeAdminTab, setActiveAdminTab] = useState<boolean>(false);
  const [adminPanelActiveTab, setAdminPanelActiveTab] = useState<'features' | 'brahmastra' | 'support'>('features');
  const [isStandaloneOrMobile, setIsStandaloneOrMobile] = useState(() => {
    if (typeof window !== 'undefined') {
      const isStandalone = window.matchMedia('(display-mode: standalone)').matches;
      const isSmallScreen = window.innerWidth < 1024;
      const isMobileUA = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      return isStandalone || isSmallScreen || isMobileUA;
    }
    return false;
  });

  // Mobile App Settings Preferences (controlled by settings menu)
  const [showMobileSettings, setShowMobileSettings] = useState<boolean>(false);
  const [mobileSettingsIconVisible, setMobileSettingsIconVisible] = useState<boolean>(() => localStorage.getItem('cwb_mobile_settings_icon_visible') !== 'false');

  // Firestore real-time listener and initial fetch for admin_security & pwaConfig icon visibility sync
  useEffect(() => {
    if (!db) return;

    const handleData = (data: any) => {
      if (!data) return;
      const isVis = data.mobileSettingsIconVisible !== undefined 
        ? Boolean(data.mobileSettingsIconVisible) 
        : data.pwaAdminIconVisible !== undefined 
          ? Boolean(data.pwaAdminIconVisible) 
          : data.showAdminIcon !== undefined 
            ? Boolean(data.showAdminIcon) 
            : undefined;

      if (isVis !== undefined) {
        setMobileSettingsIconVisible(isVis);
        localStorage.setItem('cwb_mobile_settings_icon_visible', String(isVis));
      }
    };

    // 1. Immediate fetch on launch
    getDoc(doc(db, 'settings', 'admin_security')).then(snap => snap.exists() && handleData(snap.data())).catch((err) => { if (!err.message?.includes('offline')) console.error("Firestore Settings Error:", err); });
    getDoc(doc(db, 'settings', 'pwaConfig')).then(snap => snap.exists() && handleData(snap.data())).catch((err) => { if (!err.message?.includes('offline')) console.error("Firestore Settings Error:", err); });

    // 2. Real-time listeners
    const unsub1 = onSnapshot(doc(db, 'settings', 'admin_security'), (snap) => {
      if (snap.exists()) handleData(snap.data());
    }, (err) => console.error(err));

    const unsub2 = onSnapshot(doc(db, 'settings', 'pwaConfig'), (snap) => {
      if (snap.exists()) handleData(snap.data());
    }, (err) => console.error(err));

    return () => {
      unsub1();
      unsub2();
    };
  }, []);

  useEffect(() => {
    const handleStorage = () => {
      setMobileSettingsIconVisible(localStorage.getItem('cwb_mobile_settings_icon_visible') !== 'false');
    };
    window.addEventListener('storage', handleStorage);
    const interval = setInterval(() => {
      const val = localStorage.getItem('cwb_mobile_settings_icon_visible') !== 'false';
      if (val !== mobileSettingsIconVisible) {
        setMobileSettingsIconVisible(val);
      }
    }, 1000);
    return () => {
      window.removeEventListener('storage', handleStorage);
      clearInterval(interval);
    };
  }, [mobileSettingsIconVisible]);
  const [accentColor, setAccentColor] = useState<string>(() => localStorage.getItem('cwb_accent_color') || 'blue');
  const [language, setLanguage] = useState<'te' | 'en' | 'hi' | 'kn' | 'ta'>(() => (localStorage.getItem('cwb_lang') as any) || 'te');
  const [soundOn, setSoundOn] = useState<boolean>(() => localStorage.getItem('cwb_sound_on') !== 'false');
  const [smsOn, setSmsOn] = useState<boolean>(() => localStorage.getItem('cwb_sms_on') !== 'false');
  const [showPhoneOnMap, setShowPhoneOnMap] = useState<boolean>(() => localStorage.getItem('cwb_show_phone_on_map') !== 'false');
  const [isAgentToggleVisible, setIsAgentToggleVisible] = useState<boolean>(() => localStorage.getItem('cwb_agent_toggle_visible') !== 'false');
  const [isBrahmastraButtonVisible, setIsBrahmastraButtonVisible] = useState<boolean>(() => localStorage.getItem('cwb_brahmastra_btn_visible') !== 'false');
  const [isSystemOnline, setIsSystemOnline] = useState<boolean>(() => localStorage.getItem('cwb_system_online') !== 'false');
  const [isHybridRadioMode, setIsHybridRadioMode] = useState<boolean>(() => localStorage.getItem('cwb_hybrid_radio') === 'true');
  const [radioToggles, setRadioToggles] = useState<Record<string, boolean>>({
    sync: true, sos: true, gps: true, phone: true, media: true, walkie: true, weather: true
  });
  const [activeRadioScreen, setActiveRadioScreen] = useState<string | null>(null);
  const [showWeatherModal, setShowWeatherModal] = useState<boolean>(false);

  // User support contact states (Customer Care & Feedback Form)
  const [customerCarePhone, setCustomerCarePhone] = useState<string>(() => localStorage.getItem('cwb_customer_care_phone') || '');
  const [feedbackGoogleForm, setFeedbackGoogleForm] = useState<string>(() => localStorage.getItem('cwb_feedback_google_form') || '');
  const [supportNumbersList, setSupportNumbersList] = useState<{ id: string; name: string; phone: string }[]>(() => {
    try {
      const saved = localStorage.getItem('cwb_support_numbers_list');
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  });
  const [showSupportContactsModal, setShowSupportContactsModal] = useState<boolean>(false);

  useEffect(() => {
    localStorage.setItem('cwb_customer_care_phone', customerCarePhone);
  }, [customerCarePhone]);

  useEffect(() => {
    localStorage.setItem('cwb_feedback_google_form', feedbackGoogleForm);
  }, [feedbackGoogleForm]);

  useEffect(() => {
    localStorage.setItem('cwb_support_numbers_list', JSON.stringify(supportNumbersList));
  }, [supportNumbersList]);

  useEffect(() => {
    localStorage.setItem('cwb_accent_color', accentColor);
  }, [accentColor]);

  useEffect(() => {
    localStorage.setItem('cwb_agent_toggle_visible', String(isAgentToggleVisible));
  }, [isAgentToggleVisible]);

  useEffect(() => {
    localStorage.setItem('cwb_brahmastra_btn_visible', String(isBrahmastraButtonVisible));
  }, [isBrahmastraButtonVisible]);

  useEffect(() => {
    localStorage.setItem('cwb_system_online', String(isSystemOnline));
  }, [isSystemOnline]);

  useEffect(() => {
    localStorage.setItem('cwb_hybrid_radio', String(isHybridRadioMode));
  }, [isHybridRadioMode]);

  useEffect(() => {
    localStorage.setItem('cwb_lang', language);
  }, [language]);

  useEffect(() => {
    localStorage.setItem('cwb_sound_on', String(soundOn));
  }, [soundOn]);

  useEffect(() => {
    localStorage.setItem('cwb_sms_on', String(smsOn));
  }, [smsOn]);

  useEffect(() => {
    localStorage.setItem('cwb_show_phone_on_map', String(showPhoneOnMap));
  }, [showPhoneOnMap]);

  // Invisible Maintenance Assistant state and logs
  const [isMaintenanceEnabled, setIsMaintenanceEnabled] = useState<boolean>(() => {
    const saved = localStorage.getItem('cwb_invisible_maintenance_enabled');
    return saved !== 'false'; // Default enabled
  });

  const [maintenanceLogs, setMaintenanceLogs] = useState<{ id: string; timestamp: string; type: 'bug' | 'error'; description: string; status: 'resolved' | 'cleaned' }[]>(() => {
    try {
      const saved = localStorage.getItem('cwb_invisible_maintenance_logs');
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  });

  // Sync preference to local storage
  useEffect(() => {
    localStorage.setItem('cwb_invisible_maintenance_enabled', String(isMaintenanceEnabled));
  }, [isMaintenanceEnabled]);

  // Dynamic theme colors computed from active accent preferences
  const getThemeBgColor = () => {
    switch (accentColor) {
      case 'gold': return 'bg-[#FFC000]';
      case 'green': return 'bg-[#10b981]';
      case 'crimson': return 'bg-[#e11d48]';
      case 'blue':
      default:
        return 'bg-[#082c75]';
    }
  };

  const getThemeTextColor = () => {
    switch (accentColor) {
      case 'gold': return 'text-[#FFC000]';
      case 'green': return 'text-[#10b981]';
      case 'crimson': return 'text-[#e11d48]';
      case 'blue':
      default:
        return 'text-[#082c75]';
    }
  };

  const getThemeBorderColor = () => {
    switch (accentColor) {
      case 'gold': return 'border-[#FFC000]';
      case 'green': return 'border-[#10b981]';
      case 'crimson': return 'border-[#e11d48]';
      case 'blue':
      default:
        return 'border-[#082c75]';
    }
  };

  const getThemeRingColor = () => {
    switch (accentColor) {
      case 'gold': return 'ring-[#FFC000]';
      case 'green': return 'ring-[#10b981]';
      case 'crimson': return 'ring-[#e11d48]';
      case 'blue':
      default:
        return 'ring-[#082c75]';
    }
  };

  useEffect(() => {
    const checkDisplayMode = () => {
      const isStandalone = window.matchMedia('(display-mode: standalone)').matches;
      const isSmallScreen = window.innerWidth < 1024;
      const isMobileUA = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      setIsStandaloneOrMobile(isStandalone || isSmallScreen || isMobileUA);
    };
    checkDisplayMode();
    window.addEventListener('resize', checkDisplayMode);
    return () => window.removeEventListener('resize', checkDisplayMode);
  }, []);

  // PWA Installation state
  const [deferredPrompt, setDeferredPrompt] = useState<any>(null);
  const [showInstallBanner, setShowInstallBanner] = useState(true);
  const [showManualInstallModal, setShowManualInstallModal] = useState(false);

  useEffect(() => {
    const handleBeforeInstallPrompt = (e: Event) => {
      const pwaEnabled = localStorage.getItem('cwb_pwa_enabled') !== 'false';
      if (!pwaEnabled) return;
      e.preventDefault();
      setDeferredPrompt(e);
      setShowInstallBanner(true);
    };

    window.addEventListener('beforeinstallprompt', handleBeforeInstallPrompt as any);

    return () => {
      window.removeEventListener('beforeinstallprompt', handleBeforeInstallPrompt as any);
    };
  }, []);

  const handleInstallClick = async () => {
    const pwaEnabled = localStorage.getItem('cwb_pwa_enabled') !== 'false';
    if (!pwaEnabled) {
      alert("⚠️ అడ్మిన్ గారు PWA సిస్టమ్‌ను డిసేబుల్ (OFF) చేసారు. ప్రస్తుతం ఇన్స్టాల్ ఆప్షన్ అందుబాటులో లేదు.");
      return;
    }
    if (window.self !== window.top) {
      alert("⚠️ దయచేసి పైన ఉన్న 'ఓపెన్ ఇన్ న్యూ ట్యాబ్' (Open in New Tab) బటన్ నొక్కి, కొత్త ట్యాబ్ లో యాప్ ఓపెన్ చేసి ఇన్స్టాల్ బటన్ నొక్కండి.\n\nమొబైల్ బ్రౌజర్ల భద్రతా నిబంధనల ప్రకారం ఇక్కడ(ప్రివ్యూలో) నుండి నేరుగా ఇన్స్టాల్ చేయడం కుదరదు.");
      return;
    }

    if (deferredPrompt) {
      try {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          setDeferredPrompt(null);
          setShowInstallBanner(false);
        } else {
          setShowManualInstallModal(true);
        }
      } catch (err) {
        setShowManualInstallModal(true);
      }
    } else {
      setShowManualInstallModal(true);
    }
  };


  // Offline RF Simulation & Mesh Network State
  const [isNetworkOffline, setIsNetworkOffline] = useState(!navigator.onLine);
  
  useEffect(() => {
    const handleOnline = () => setIsNetworkOffline(false);
    const handleOffline = () => {
      setIsNetworkOffline(true);
      setIsHybridRadioMode(true);
    };
    window.addEventListener('online', handleOnline);
    window.addEventListener('offline', handleOffline);
    return () => {
      window.removeEventListener('online', handleOnline);
      window.removeEventListener('offline', handleOffline);
    };
  }, []);

  // Feature states mapping (Feature ID -> Control State)
  const [rawFeatureStates, setFeatureStates] = useState<Record<string, ControlState>>(() => {
    const saved = localStorage.getItem('cwb_features');
    if (saved) {
      const parsed = JSON.parse(saved);
      let changed = false;
      INITIAL_FEATURES.forEach(f => {
        if (parsed[f.id] === undefined) {
          parsed[f.id] = f.state;
          changed = true;
        }
      });
      if (changed) {
        localStorage.setItem('cwb_features', JSON.stringify(parsed));
      }
      return parsed;
    }
    const initial: Record<string, ControlState> = {};
    INITIAL_FEATURES.forEach(f => {
      initial[f.id] = f.state;
    });
    return initial;
  });

  // Hybrid Mode - Admin Panel Control State
  const [hybridModeEnabled, setHybridModeEnabled] = useState<boolean>(true);

  const [secretSwitchBypass, setSecretSwitchBypass] = useState<boolean>(() => {
    return localStorage.getItem('cwb_secret_switch_bypass') === 'true';
  });

  useEffect(() => {
    localStorage.setItem('cwb_hybrid_mode_enabled', String(hybridModeEnabled));
  }, [hybridModeEnabled]);

  useEffect(() => {
    localStorage.setItem('cwb_secret_switch_bypass', String(secretSwitchBypass));
  }, [secretSwitchBypass]);

  const PREMIUM_FEATURE_IDS = React.useMemo(() => [
    'feat_premium_assistant',
    'feat_premium_tracking',
    'feat_premium_radio',
    'feat_premium_invoicing',
    'feat_premium_payments',
    'feat_premium_escrow',
    'feat_premium_multilingual',
    'feat_premium_verification',
    'feat_premium_support',
    'feat_premium_analytics',
    'feat_premium_team',
    'feat_invisible_maintenance',
    'feat_hybrid_radio',
    'feat_brahmastra'
  ], []);

  const POSTPAID_FEATURE_IDS = React.useMemo(() => [
    'feat_biopower',
    'feat_bp_sugar',
    'feat_doctor_scan',
    'feat_weather_report',
    'feat_invoice_generator'
  ], []);

  // Feature Timers: mapping featureId -> Unix epoch timestamp (expiresAt)
  const [featureTimers, setFeatureTimers] = useState<Record<string, number>>(() => {
    const saved = localStorage.getItem('cwb_feature_timers');
    return saved ? JSON.parse(saved) : {};
  });

  // Handle simulating a timer expiration quickly
  const handleSimulateTimer = (featureId: string) => {
    const expiresAt = Date.now() + 10 * 1000; // Set to 10 seconds from now
    setFeatureTimers(prev => {
      const updated = { ...prev, [featureId]: expiresAt };
      localStorage.setItem('cwb_feature_timers', JSON.stringify(updated));
      return updated;
    });
  };

  // Handle manual feature timer update
  const handleUpdateFeatureTimer = (featureId: string, hours: number, isOn: boolean) => {
    if (isOn) {
      const expiresAt = Date.now() + hours * 60 * 60 * 1000;
      setFeatureTimers(prev => {
        const updated = { ...prev, [featureId]: expiresAt };
        localStorage.setItem('cwb_feature_timers', JSON.stringify(updated));
        return updated;
      });
    } else {
      setFeatureTimers(prev => {
        const updated = { ...prev };
        delete updated[featureId];
        localStorage.setItem('cwb_feature_timers', JSON.stringify(updated));
        return updated;
      });
    }
  };

  // Clock widget state & live time sync
  const [clockHour, setClockHour] = useState<number>(() => {
    const saved = localStorage.getItem('cwb_clock_hour');
    return saved ? parseInt(saved, 10) : 9;
  });
  const [clockMinute, setClockMinute] = useState<number>(() => {
    const saved = localStorage.getItem('cwb_clock_minute');
    return saved ? parseInt(saved, 10) : 41;
  });
  const [clockAmPm, setClockAmPm] = useState<string>(() => {
    const saved = localStorage.getItem('cwb_clock_ampm');
    return saved || 'AM';
  });
  const [isLiveTime, setIsLiveTime] = useState<boolean>(() => {
    return localStorage.getItem('cwb_clock_islive') === 'true';
  });

  // Alarm state & logic
  const [alarmHour, setAlarmHour] = useState<number>(() => {
    const saved = localStorage.getItem('cwb_alarm_hour');
    return saved ? parseInt(saved, 10) : 9;
  });
  const [alarmMinute, setAlarmMinute] = useState<number>(() => {
    const saved = localStorage.getItem('cwb_alarm_minute');
    return saved ? parseInt(saved, 10) : 45;
  });
  const [alarmAmPm, setAlarmAmPm] = useState<string>(() => {
    const saved = localStorage.getItem('cwb_alarm_ampm');
    return saved || 'AM';
  });
  const [alarmEnabled, setAlarmEnabled] = useState<boolean>(() => {
    return localStorage.getItem('cwb_alarm_enabled') === 'true';
  });
  const [alarmTriggered, setAlarmTriggered] = useState<boolean>(false);

  useEffect(() => {
    if (!alarmEnabled) return;
    if (clockHour === alarmHour && clockMinute === alarmMinute && clockAmPm === alarmAmPm) {
      if (!alarmTriggered) {
        setAlarmTriggered(true);
      }
    } else {
      if (alarmTriggered) {
        setAlarmTriggered(false);
      }
    }
  }, [clockHour, clockMinute, clockAmPm, alarmHour, alarmMinute, alarmAmPm, alarmEnabled, alarmTriggered]);

  useEffect(() => {
    if (!isLiveTime) return;
    const interval = setInterval(() => {
      const now = new Date();
      let h = now.getHours();
      const m = now.getMinutes();
      const ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12;
      h = h ? h : 12;
      setClockHour(h);
      setClockMinute(m);
      setClockAmPm(ampm);
    }, 1000);
    return () => clearInterval(interval);
  }, [isLiveTime]);

  // Synchronize initial timers for already active features
  useEffect(() => {
    setFeatureTimers((prev) => {
      let changed = false;
      const updatedTimers = { ...prev };
      
      INITIAL_FEATURES.forEach((feat) => {
        const state = rawFeatureStates[feat.id] || feat.state;
        if (state === 'temp_on' && !updatedTimers[feat.id]) {
          if (PREMIUM_FEATURE_IDS.includes(feat.id)) {
            updatedTimers[feat.id] = Date.now() + 24 * 60 * 60 * 1000; // 24 hours
            changed = true;
          } else if (POSTPAID_FEATURE_IDS.includes(feat.id)) {
            updatedTimers[feat.id] = Date.now() + 30 * 24 * 60 * 60 * 1000; // 30 days
            changed = true;
          }
        }
      });

      if (changed) {
        localStorage.setItem('cwb_feature_timers', JSON.stringify(updatedTimers));
        return updatedTimers;
      }
      return prev;
    });
  }, [rawFeatureStates, PREMIUM_FEATURE_IDS, POSTPAID_FEATURE_IDS]);

  // Countdown ticker that runs every second using stable non-recreated interval
  useEffect(() => {
    const interval = setInterval(() => {
      const now = Date.now();
      
      setFeatureTimers((prevTimers) => {
        let timersChanged = false;
        const updatedTimers = { ...prevTimers };
        const expiredFeatures: string[] = [];
        
        Object.keys(updatedTimers).forEach((featureId) => {
          if (updatedTimers[featureId] <= now) {
            timersChanged = true;
            expiredFeatures.push(featureId);
            delete updatedTimers[featureId];
          }
        });

        if (timersChanged) {
          localStorage.setItem('cwb_feature_timers', JSON.stringify(updatedTimers));
          
          setTimeout(() => {
            setFeatureStates((prevStates) => {
              let statesChanged = false;
              const updatedStates = { ...prevStates };
              expiredFeatures.forEach(id => {
                 updatedStates[id] = 'temp_off';
                 statesChanged = true;
              });
              if (statesChanged) {
                 localStorage.setItem('cwb_features', JSON.stringify(updatedStates));
                 return updatedStates;
              }
              return prevStates;
            });
          }, 0);
          
          return updatedTimers;
        }
        return prevTimers;
      });
    }, 1000);

    return () => clearInterval(interval);
  }, []);

  // Compute effective feature states based on Hybrid Mode and raw feature states
  // Every feature in our app runs in Hybrid Model and Hybrid Upgraded version ('perm_upgrade') when Hybrid Mode is on.
  const featureStates = React.useMemo(() => {
    const mapped: Record<string, ControlState> = {};
    Object.keys(rawFeatureStates).forEach(key => {
      let state = rawFeatureStates[key];
      if (secretSwitchBypass) {
        // Force all features to be active and working if the secret bypass is enabled!
        if (state === 'temp_off' || state === 'perm_off' || state === 'soft_delete' || state === 'hard_delete') {
          state = 'temp_on';
        }
      }
      // If hybrid mode is enabled, every active feature is promoted to the upgraded hybrid version ('perm_upgrade')!
      if (hybridModeEnabled && state !== 'soft_delete' && state !== 'hard_delete' && state !== 'temp_off' && state !== 'perm_off') {
        mapped[key] = 'perm_upgrade';
      } else {
        mapped[key] = state;
      }
    });
    return mapped;
  }, [rawFeatureStates, hybridModeEnabled, secretSwitchBypass]);

  const radioFeatureEnabled = featureStates['feat_hybrid_radio'] !== 'temp_off' && featureStates['feat_hybrid_radio'] !== 'perm_off' && featureStates['feat_hybrid_radio'] !== 'soft_delete' && featureStates['feat_hybrid_radio'] !== 'hard_delete';
  const effectiveRadioMode = isHybridRadioMode && radioFeatureEnabled;

  // Chat Assistant State
  const [isChatAssistantEnabled, setIsChatAssistantEnabled] = useState<boolean>(() => {
    return localStorage.getItem('cwb_chat_assistant_enabled') !== 'false';
  });

  useEffect(() => {
    localStorage.setItem('cwb_chat_assistant_enabled', String(isChatAssistantEnabled));
  }, [isChatAssistantEnabled]);

  // Real runtime error and rejection interceptor for Invisible Maintenance Assistant (Runs as premium hybrid service)
  useEffect(() => {
    const isEffectiveMaintenanceActive = isMaintenanceEnabled && hybridModeEnabled && (featureStates['feat_invisible_maintenance'] === 'perm_upgrade' || featureStates['feat_invisible_maintenance'] === 'perm_on');
    if (!isEffectiveMaintenanceActive) return;

    // Real-time Storage Quota Monitoring & Auto-Cache Cleanup
    if ('storage' in navigator && navigator.storage && navigator.storage.estimate) {
      navigator.storage.estimate().then(estimate => {
        if (estimate.quota && estimate.usage && (estimate.usage / estimate.quota > 0.85)) {
          const newLog = {
            id: 'err_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
            timestamp: new Date().toLocaleTimeString('te-IN'),
            type: 'bug' as const,
            description: `స్టోరేజ్ పర్యవేక్షణ: లోకల్ డెవలప్‌మెంట్ మరియు ఇమేజ్ క్యాచే ఆటోమేటిక్‌గా రీ-ఆప్టిమైజ్ చేయబడింది. (Storage quota monitored (>85%). Local storage and image caches auto-pruned to ensure zero lag.)`,
            status: 'cleaned' as const
          };
          setMaintenanceLogs(prev => {
            const updated = [newLog, ...prev].slice(0, 50);
            localStorage.setItem('cwb_invisible_maintenance_logs', JSON.stringify(updated));
            return updated;
          });
        }
      }).catch(() => {});
    }

    const handleError = (event: ErrorEvent) => {
      const errorMsg = event.message || 'Unknown javascript rendering exception';
      const newLog = {
        id: 'err_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
        timestamp: new Date().toLocaleTimeString('te-IN'),
        type: 'error' as const,
        description: `రన్‌టైమ్ స్క్రీన్ లోపం ఆటోమేటిక్‌గా గుర్తించబడింది మరియు పరిష్కరించబడింది: "${errorMsg}" (Uncaught javascript rendering exception intercepted and auto-suppressed)`,
        status: 'resolved' as const
      };
      setMaintenanceLogs(prev => {
        const updated = [newLog, ...prev].slice(0, 50);
        localStorage.setItem('cwb_invisible_maintenance_logs', JSON.stringify(updated));
        return updated;
      });
    };

    const handleRejection = (event: PromiseRejectionEvent) => {
      const reason = event.reason?.message || event.reason || 'Unhandled asynchronous rejection';
      const newLog = {
        id: 'err_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
        timestamp: new Date().toLocaleTimeString('te-IN'),
        type: 'error' as const,
        description: `నెట్‌వర్క్ అవాంఛనీయ ప్రామిస్ వైఫల్యం విజయవంతంగా పునరుద్ధరించబడింది: "${reason}" (Unhandled async network rejection intercepted and self-healed)`,
        status: 'resolved' as const
      };
      setMaintenanceLogs(prev => {
        const updated = [newLog, ...prev].slice(0, 50);
        localStorage.setItem('cwb_invisible_maintenance_logs', JSON.stringify(updated));
        return updated;
      });
    };

    const handleOnline = () => {
      const newLog = {
        id: 'err_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
        timestamp: new Date().toLocaleTimeString('te-IN'),
        type: 'bug' as const,
        description: `నెట్‌వర్క్ కనెక్షన్ పునరుద్ధరించబడింది: క్లౌడ్ సింక్ మరియు డేటాబేస్ ఛానెల్ ఆటోమేటిక్‌గా రీ-కనెక్ట్ చేయబడ్డాయి. (Network re-connected. Cloud sync status auto-verified and active.)`,
        status: 'resolved' as const
      };
      setMaintenanceLogs(prev => {
        const updated = [newLog, ...prev].slice(0, 50);
        localStorage.setItem('cwb_invisible_maintenance_logs', JSON.stringify(updated));
        return updated;
      });
    };

    window.addEventListener('error', handleError);
    window.addEventListener('unhandledrejection', handleRejection);
    window.addEventListener('online', handleOnline);
    return () => {
      window.removeEventListener('error', handleError);
      window.removeEventListener('unhandledrejection', handleRejection);
      window.removeEventListener('online', handleOnline);
    };
  }, [isMaintenanceEnabled, hybridModeEnabled, featureStates]);

  // Periodic intelligent maintenance simulation loop (Runs as premium hybrid service every 12 seconds)
  useEffect(() => {
    const isEffectiveMaintenanceActive = isMaintenanceEnabled && hybridModeEnabled && (featureStates['feat_invisible_maintenance'] === 'perm_upgrade' || featureStates['feat_invisible_maintenance'] === 'perm_on');
    if (!isEffectiveMaintenanceActive) return;

    const simulatedEvents = [
      {
        type: 'bug' as const,
        description: 'స్థానిక బ్రౌజర్ డేటా లోడ్ మరియు సిస్టమ్ కాన్ఫిగరేషన్ తనిఖీ చేయబడింది. వ్యర్థ ఫైళ్ల శుభ్రపరచడం పూర్తయింది. (Local browser storage performance audited. Corrupted schema attributes and stale JSON caches successfully cleared.)'
      },
      {
        type: 'error' as const,
        description: 'మెమరీ లీక్‌ను నివారించడానికి పాత గ్లోబల్ వేరియబెల్స్ మరియు అన్‌మౌంట్ చేయబడిన వ్యూ రిఫరెన్సులు తొలగించబడ్డాయి. (Dangling global pointer references and unmounted view nodes garbage-collected safely.)'
      },
      {
        type: 'bug' as const,
        description: 'లైవ్ చాట్ సాకెట్ లోని నిరుపయోగ నెట్‌వర్క్ లిజనర్లు నిలిపివేయబడ్డాయి. (Inactive websocket polling triggers and dangling socket descriptors closed to boost network latency.)'
      },
      {
        type: 'error' as const,
        description: 'రన్‌టైమ్ లేఅవుట్ మైక్రో-స్టేట్ సమతుల్యత పునరుద్ధరించబడింది. (Application runtime layout micro-state synchronized and balanced across active screen components.)'
      },
      {
        type: 'bug' as const,
        description: 'గూగుల్ మ్యాప్స్ ఏపీఐ లోడ్ బగ్ ఆటోమేటిక్గా నివారించబడింది. (Google Maps rendering context boundary collision resolved seamlessly to prevent UI freezes.)'
      },
      {
        type: 'error' as const,
        description: 'చెల్లింపు ప్యానెల్ ఎర్రర్ లాగ్‌లు ఆటో-రిపేర్ చేయబడ్డాయి. (Simulated Stripe/PhonePe redirection schemas verified and database offline validation state self-healed.)'
      },
      {
        type: 'bug' as const,
        description: 'ఆఫ్‌లైన్ మొబైల్ ప్రెఫరెన్సెస్ కాన్ఫిగరేషన్ ఫైల్ విజయవంతంగా ఆప్టిమైజ్ చేయబడింది. (User local-preferences data audited and auto-aligned to ensure seamless offline boot.)'
      },
      {
        type: 'error' as const,
        description: 'సిస్టమ్ పర్ఫార్మెన్స్ బూస్ట్ చేయడానికి బ్యాచ్ రెండరింగ్ క్యూ సమతుల్యం చేయబడింది. (React rendering batch queue streamlined for a ultra-smooth and responsive view refresh.)'
      },
      {
        type: 'bug' as const,
        description: 'అవాంఛనీయ ప్రైవేట్ వేరియబుల్ తాకిడి పరిష్కరించబడింది. (Dangling global state race conditions in background synchronization thread suppressed safely.)'
      },
      {
        type: 'bug' as const,
        description: 'బుక్స్ మరియు బుకింగ్స్ వ్యర్థ డేటా విజయవంతంగా శుభ్రపరచబడింది. పాత డ్రాఫ్ట్ సమాచారం క్లియర్ చేయబడింది. (Stale transaction logs and redundant draft bookings cleared to maximize database stability.)'
      },
      {
        type: 'error' as const,
        description: 'అన్ని స్క్రీన్ బటన్ల టచ్ రెస్పాన్స్ మైక్రో-సెకన్లకు ఆప్టిమైజ్ చేయబడింది. డబుల్ క్లిక్ ఫ్రీజ్ ఆటో-లాక్ విజయవంతంగా వర్తింపజేయబడింది. (All UI button click listeners optimized for high fidelity. Rapid double-clicks and debounce locks successfully implemented to ensure silky smooth response.)'
      },
      {
        type: 'bug' as const,
        description: 'సిస్టమ్ యొక్క లోపాలు మరియు తాత్కాలిక ఎర్రర్స్ విజయవంతంగా క్లియర్ చేయబడ్డాయి. బటన్స్ నొక్కినప్పుడు ఎటువంటి అంతరాయం లేదు. (Active runtime engine error registers cleared and button action paths fully self-healed.)'
      }
    ];

    // Disabled the 12s simulated event loop to prevent React root component re-renders and UI hanging
    // This makes all buttons and inputs perfectly smooth by not interrupting the main thread
    return () => {};
  }, [isMaintenanceEnabled, hybridModeEnabled, featureStates]);

  // Data states
  const [services, setServices] = useState<ServiceCategory[]>(INITIAL_SERVICES);
  const [bookings, setBookings] = useState<Booking[]>(() => {
    const saved = localStorage.getItem('cwb_bookings');
    return saved ? JSON.parse(saved) : [];
  });
  const [walletBalance, setWalletBalance] = useState<number>(850);
  const [walletTransactions, setWalletTransactions] = useState<WalletTransaction[]>(INITIAL_WALLET_TRANSACTIONS);
  const [diaryEntries, setDiaryEntries] = useState<DiaryEntry[]>(INITIAL_DIARY_ENTRIES);
  const [kycState, setKycState] = useState<KYCInterface>({
    aadhaarUploaded: false,
    panUploaded: false,
    verified: false,
  });

  // User Authentication States (Persistent PWA secure phone session)
  const [isLoggedIn, setIsLoggedIn] = useState<boolean>(() => {
    return localStorage.getItem('cwb_logged_in') === 'true';
  });
  const [userPhone, setUserPhone] = useState<string>(() => {
    return localStorage.getItem('cwb_user_phone') || '';
  });

  // Disable automatic walkthrough popup to prevent covering the Main Occupations screen on load,
  // keeping it strictly manual when the user clicks the "App Guide" button or Help icon.
  useEffect(() => {
    setShowAppWalkthrough(false);
  }, [isLoggedIn]);

  // Settings & Nested Admin Access State
  const [showSettingsModal, setShowSettingsModal] = useState<boolean>(false);

  // === ROLE-BASED ACCESS CONTROL (RBAC) ===
  const AUTHORIZED_ADMINS = ['psm8742260@gmail.com', '+918466062260', '8466062260', '+91 8466062260', 'psm8742260']; 
  const rawCleanPhone = userPhone ? userPhone.replace(/\s+/g, '').trim() : '';
  const isAdmin = isLoggedIn && AUTHORIZED_ADMINS.includes(rawCleanPhone);

  const isStandaloneApp = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone === true;
  const showSettingsIcon = isAdmin && (!isStandaloneApp || (isStandaloneApp && mobileSettingsIconVisible === true));
  const pwaAdminIconVisible = showSettingsIcon;
  const setShowAdminModal = setShowMobileSettings;

  useEffect(() => {
    if (!isAdmin) {
      if (showSettingsModal) setShowSettingsModal(false);
      if (activeAdminTab) setActiveAdminTab(false);
    }
  }, [isAdmin, showSettingsModal, activeAdminTab]);

  // Attendance Toggle State (Feature 2)
  const [attendanceOn, setAttendanceOn] = useState(false);

  // Lockscreen & App Opening / Closing simulator state (Image 2 Mandate)
  const [appClosed, setAppClosed] = useState<boolean>(false);

  // Customer panel sub-navigation flow (Image 1 Mandate)
  // 'home' | 'worker_list' | 'worker_profile' | 'booking' | 'tracking' | 'payment_review'
  const [customerFlowState, setCustomerFlowState] = useState<'home' | 'worker_list' | 'worker_profile' | 'booking' | 'tracking' | 'payment_review' | 'panchangam' | 'biopower' | 'radio' | 'ecommerce'>('home');
  const [currentScreen, setCurrentScreen] = useState<'home' | 'map' | 'entertainment' | 'vault' | 'community' | 'chat'>('home');
  const [serviceSearchQuery, setServiceSearchQuery] = useState<string>('');
  const [selectedWorker, setSelectedWorker] = useState<any | null>(null);
  const [simulatedBooking, setSimulatedBooking] = useState<any | null>(null);

  // Interaction Modals/States
  const [selectedService, setSelectedService] = useState<ServiceCategory | null>(null);
  const [geofenceRadius, setGeofenceRadius] = useState<number>(10);
  const [activeCallWorker, setActiveCallWorker] = useState<{ name: string; type: string; phone: string } | null>(null);
  const [activeRatingBooking, setActiveRatingBooking] = useState<Booking | null>(null);
  const [starRating, setStarRating] = useState<number>(5);
  const [feedbackComment, setFeedbackComment] = useState<string>('');

  // SOS Emergency Tracker state
  const [sosActive, setSosActive] = useState(false);
  
  // Postpaid and Profile Menu Custom States
  const [postpaidBills, setPostpaidBills] = useState<PostpaidBill[]>(() => {
    const saved = localStorage.getItem('cwb_postpaid_bills');
    if (saved) return JSON.parse(saved);
    return [
      {
        id: 'CWRB-PB-901',
        customerName: 'సురేష్ కుమార్ (Suresh Kumar)',
        customerPhone: '9440512345',
        workDescription: 'కొత్త ఇల్లు మేస్త్రీ పని (Mason work)',
        amount: 3500,
        date: '2026-07-15',
        dueDate: '2026-07-25',
        status: 'pending'
      },
      {
        id: 'CWRB-PB-902',
        customerName: 'రామకృష్ణ (Ramakrishna)',
        customerPhone: '9848022334',
        workDescription: 'ప్లాస్టరింగ్ & బాత్రూమ్ లీకేజ్ రిపేర్ (Plastering & leakage repair)',
        amount: 1800,
        date: '2026-07-12',
        dueDate: '2026-07-20',
        status: 'paid'
      }
    ];
  });

  useEffect(() => {
    localStorage.setItem('cwb_postpaid_bills', JSON.stringify(postpaidBills));
  }, [postpaidBills]);

  const [showProfileMenu, setShowProfileMenu] = useState<boolean>(false);
  const [showPostpaidBillsModal, setShowPostpaidBillsModal] = useState<boolean>(false);
  
  // Gesture Swipe Navigation logic for main bottom tabs (Customer view)
  const touchStartX = useRef<number | null>(null);
  const touchStartY = useRef<number | null>(null);

  const handleTouchStart = (e: React.TouchEvent) => {
    touchStartX.current = e.touches[0].clientX;
    touchStartY.current = e.touches[0].clientY;
  };

  const handleTouchEnd = (e: React.TouchEvent) => {
    if (touchStartX.current === null || touchStartY.current === null) return;

    const diffX = e.changedTouches[0].clientX - touchStartX.current;
    const diffY = e.changedTouches[0].clientY - touchStartY.current;

    // Reset touch variables
    touchStartX.current = null;
    touchStartY.current = null;

    // Must be a horizontal swipe (diffX is larger than diffY)
    // and must exceed 65px swipe threshold
    if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 65) {
      const target = e.target as HTMLElement;
      
      // Do not switch tabs if swiping inside interactive elements or maps
      if (
        target.closest('.leaflet-container') || 
        target.closest('input') || 
        target.closest('textarea') || 
        target.closest('select') || 
        target.closest('.no-swipe') ||
        target.closest('[role="slider"]') ||
        target.closest('audio') ||
        target.closest('video')
      ) {
        return;
      }

      if (activeTab === 'customer') {
        // If in customer 'home' but currently inspecting worker list/profile/booking/tracking/etc., do not swipe tabs.
        if (currentScreen === 'home' && customerFlowState !== 'home') {
          return;
        }

        const tabOrder = ['home', 'map', 'community', 'entertainment', 'vault'] as const;
        const currentIndex = tabOrder.indexOf(currentScreen as any);
        if (currentIndex !== -1) {
          if (diffX > 0) {
            // Swipe right -> Previous tab
            const prevIndex = currentIndex - 1;
            if (prevIndex >= 0) {
              setCurrentScreen(tabOrder[prevIndex]);
              if (tabOrder[prevIndex] === 'home') {
                setCustomerFlowState('home');
              }
            }
          } else {
            // Swipe left -> Next tab
            const nextIndex = currentIndex + 1;
            if (nextIndex < tabOrder.length) {
              setCurrentScreen(tabOrder[nextIndex]);
              if (tabOrder[nextIndex] === 'home') {
                setCustomerFlowState('home');
              }
            }
          }
        }
      } else if (activeTab === 'worker') {
        const tabOrder = ['dashboard', 'wallet', 'diary', 'community', 'entertainment'] as const;
        const currentIndex = tabOrder.indexOf(currentWorkerScreen);
        if (currentIndex !== -1) {
          if (diffX > 0) {
            // Swipe right -> Previous tab
            const prevIndex = currentIndex - 1;
            if (prevIndex >= 0) {
              setCurrentWorkerScreen(tabOrder[prevIndex]);
            }
          } else {
            // Swipe left -> Next tab
            const nextIndex = currentIndex + 1;
            if (nextIndex < tabOrder.length) {
              setCurrentWorkerScreen(tabOrder[nextIndex]);
            }
          }
        }
      }
    }
  };
  const [sosLocation, setSosLocation] = useState<string>('');

  // Save changes helper
  const handleBulkUpdateFeatureStates = (updates: Record<string, ControlState>) => {
    setFeatureStates(prev => {
      const updated = { ...prev, ...updates };
      localStorage.setItem('cwb_features', JSON.stringify(updated));
      return updated;
    });
  };

  const updateFeatureState = (featureId: string, newState: ControlState) => {
    const updated = { ...rawFeatureStates, [featureId]: newState };
    setFeatureStates(updated);
    localStorage.setItem('cwb_features', JSON.stringify(updated));

    // Handle timer activation/deactivation
    if (newState === 'temp_on') {
      if (PREMIUM_FEATURE_IDS.includes(featureId)) {
        const expiresAt = Date.now() + 24 * 60 * 60 * 1000; // 24 hours
        const updatedTimers = { ...featureTimers, [featureId]: expiresAt };
        setFeatureTimers(updatedTimers);
        localStorage.setItem('cwb_feature_timers', JSON.stringify(updatedTimers));
      } else if (POSTPAID_FEATURE_IDS.includes(featureId)) {
        const expiresAt = Date.now() + 30 * 24 * 60 * 60 * 1000; // 30 days
        const updatedTimers = { ...featureTimers, [featureId]: expiresAt };
        setFeatureTimers(updatedTimers);
        localStorage.setItem('cwb_feature_timers', JSON.stringify(updatedTimers));
      }
    } else {
      if (featureTimers[featureId]) {
        const updatedTimers = { ...featureTimers };
        delete updatedTimers[featureId];
        setFeatureTimers(updatedTimers);
        localStorage.setItem('cwb_feature_timers', JSON.stringify(updatedTimers));
      }
    }
  };

  const handleBooking = (newBooking: Booking) => {
    const updated = [newBooking, ...bookings];
    setBookings(updated);
    localStorage.setItem('cwb_bookings', JSON.stringify(updated));

    // Automatically deduct points from worker balance for Lead generation
    const leadCost = 50;
    setWalletBalance(prev => Math.max(0, prev - leadCost));
    const newTx: WalletTransaction = {
      id: 'tx_' + Date.now(),
      date: new Date().toISOString().split('T')[0],
      descriptionEn: `Lead Assigned - ${newBooking.serviceName}`,
      descriptionTe: `లీడ్ కేటాయించబడింది - ${newBooking.serviceName}`,
      points: -leadCost,
      type: 'debit'
    };
    setWalletTransactions(prev => [newTx, ...prev]);
  };

  const handleCustomerCareClick = (e: React.MouseEvent) => {
    e.preventDefault();
    if (!customerCarePhone && supportNumbersList.length === 0) {
      alert("కస్టమర్ కేర్ నంబర్ ఇంకా సెట్ చేయబడలేదు. అడ్మిన్ మాస్టర్ కంట్రోల్ ప్యానెల్‌లో సెట్ చేసుకోండి!");
      return;
    }
    
    // User requested to dial the phone directly without showing the modal list to the customer.
    const numberToDial = customerCarePhone || (supportNumbersList.length > 0 ? supportNumbersList[0].phone : '');
    
    if (numberToDial) {
      window.location.href = `tel:${numberToDial}`;
    } else {
      alert("సరైన కస్టమర్ కేర్ నంబర్ అందుబాటులో లేదు.");
    }
  };

  const handleAddDiaryEntry = (newEntry: Omit<DiaryEntry, 'id'>) => {
    const entry: DiaryEntry = {
      ...newEntry,
      id: 'diary_' + Date.now()
    };
    setDiaryEntries(prev => [entry, ...prev]);
  };

  const handleDeleteDiaryEntry = (id: string) => {
    setDiaryEntries(prev => prev.filter(e => e.id !== id));
  };

  const handleAddWalletFunds = (amount: number) => {
    setWalletBalance(prev => prev + amount);
    const newTx: WalletTransaction = {
      id: 'tx_' + Date.now(),
      date: new Date().toISOString().split('T')[0],
      descriptionEn: 'Points Recharge Added',
      descriptionTe: 'పాయింట్లు రీఛార్జ్ చేయబడ్డాయి',
      points: amount,
      type: 'credit'
    };
    setWalletTransactions(prev => [newTx, ...prev]);
  };

  // Trigger simulated SOS action
  const triggerSos = () => {
    setSosActive(true);
    // Simulating GPS location capture
    const lat = (17.3850 + (Math.random() - 0.5) * 0.1).toFixed(4);
    const lng = (78.4867 + (Math.random() - 0.5) * 0.1).toFixed(4);
    setSosLocation(`Lat: ${lat}, Lng: ${lng} (Hyderabad, Telangana)`);
  };

  // Quick reset all states
  const resetAllData = () => {
    localStorage.removeItem('cwb_features');
    localStorage.removeItem('cwb_bookings');
    const initial: Record<string, ControlState> = {};
    INITIAL_FEATURES.forEach(f => {
      initial[f.id] = f.state;
    });
    setFeatureStates(initial);
    setBookings([]);
    setWalletBalance(850);
    setWalletTransactions(INITIAL_WALLET_TRANSACTIONS);
    setDiaryEntries(INITIAL_DIARY_ENTRIES);
    setKycState({
      aadhaarUploaded: false,
      panUploaded: false,
      verified: false,
    });
    setAttendanceOn(false);
    setSosActive(false);
    setShowSplash(true);
  };

  // Clear Service Worker and Browser Cache to force PWA refresh
  const forceUpdateApp = () => {
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.getRegistrations().then((registrations) => {
        registrations.forEach((registration) => registration.unregister());
      });
    }
    if ('caches' in window) {
      caches.keys().then((names) => {
        names.forEach(name => caches.delete(name));
      });
    }
    
    // 🔥 Force full browser reload after clearing cache
    setTimeout(() => {
      window.location.reload();
    }, 800);
  };

  const handleLoginSuccess = (phoneNumber: string) => {
    // లాగిన్ స్థితిని వెంటనే మరియు స్థిరంగా సేవ్ చేయండి
    localStorage.setItem('cwb_logged_in', 'true');
    localStorage.setItem('cwb_user_phone', phoneNumber);
    
    // స్టేట్ అప్‌డేట్ చేయండి
    setIsLoggedIn(true);
    setUserPhone(phoneNumber);
    
    // స్ప్లాష్ స్క్రీన్‌ను ఖచ్చితంగా ఆపివేయండి
    setShowSplash(false);
    console.log("Login successful, moved to home screen.");
  };

  const handleLogout = () => {
    localStorage.removeItem('cwb_logged_in');
    localStorage.removeItem('cwb_user_phone');
    setIsLoggedIn(false);
    setUserPhone('');
    setShowSplash(true);
    setShowSettingsModal(false);
  };

  return (
          <div className="min-h-screen bg-slate-100 flex flex-col font-sans">
      
      {/* Offline RF Mesh Network Overlay Banner */}
      <AnimatePresence>
        {(isNetworkOffline && radioFeatureEnabled) && (
          <div 
            className="sticky top-0 z-[9999] w-full bg-gradient-to-r from-[#082c75] via-[#143475] to-[#082c75] shadow-2xl border-b-2 border-[#FFC000]"
          >
            <div className="max-w-md mx-auto px-4 py-2 sm:py-3 flex items-center justify-between">
              <div className="flex flex-col">
                <div className="flex items-center gap-2">
                  <div className="relative flex h-3 w-3">
                    <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#FFC000] opacity-75"></span>
                    <span className="relative inline-flex rounded-full h-3 w-3 bg-[#FFC000]"></span>
                  </div>
                  <span className="text-[#FFC000] font-black text-xs sm:text-sm tracking-widest uppercase">
                    Offline RF Synced
                  </span>
                </div>
                <span className="text-[9px] sm:text-[10px] text-white/80 font-bold ml-5 mt-0.5 leading-tight">
                  P2P Mesh via Wi-Fi/Bluetooth Active<br/>
                  Bucket Chain System: Multi-Hop Data Forwarding
                </span>
              </div>
              <div className="shrink-0 flex items-center justify-center p-2 bg-white/10 rounded-full border border-white/20 relative">
                <Radio className="w-5 h-5 sm:w-6 sm:h-6 text-[#FFC000] animate-pulse" />
                <span className="absolute -top-1 -right-1 flex h-2.5 w-2.5">
                  <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500 border border-[#082c75]"></span>
                </span>
              </div>
            </div>
            
            {/* Animated signal waves background */}
            <div className="absolute inset-0 overflow-hidden pointer-events-none opacity-20 flex justify-around">
               <div className="w-px h-full bg-white/50 animate-[ping_2s_ease-in-out_infinite]" style={{ animationDelay: '0s' }}></div>
               <div className="w-px h-full bg-white/50 animate-[ping_2s_ease-in-out_infinite]" style={{ animationDelay: '0.5s' }}></div>
               <div className="w-px h-full bg-white/50 animate-[ping_2s_ease-in-out_infinite]" style={{ animationDelay: '1s' }}></div>
               <div className="w-px h-full bg-white/50 animate-[ping_2s_ease-in-out_infinite]" style={{ animationDelay: '1.5s' }}></div>
            </div>
          </div>
        )}
      </AnimatePresence>

      {/* Dynamic Splash Screen */}
      <AnimatePresence>
        {(showSplash || !isLoggedIn) && (
          <Splash
            onComplete={() => setShowSplash(false)}
            isLoggedIn={isLoggedIn}
            onLoginSuccess={handleLoginSuccess}
          />
        )}
      </AnimatePresence>
          {/* Main Top Header Navigation Bar */}
          {!isStandaloneOrMobile && (
            <header className="bg-[#082c75] text-white py-3 px-4 md:px-6 shadow-md border-b-4 border-[#FFC000] flex flex-col sm:flex-row items-center justify-between gap-3 z-20 sticky top-0">
              <div className="flex items-center justify-between w-full sm:w-auto">
                <CWRBLogo className="scale-115 sm:scale-125 origin-left" />
              </div>

              {/* Desktop and Tablet Navigation & Compact Toggles */}
              <div className="flex items-center justify-between sm:justify-end gap-3 w-full sm:w-auto flex-wrap sm:flex-nowrap">

                {/* Utility action buttons */}
                <div className="flex items-center gap-1.5 ml-auto">
                  <button
                    onClick={handleLogout}
                    title={language === 'en' ? 'Logout & Go Back' : language === 'hi' ? 'लॉग आउट और वापस जाएं' : language === 'kn' ? 'ಲಾಗ್ ಔಟ್ ಮತ್ತು ಹಿಂತಿರುಗಿ' : language === 'ta' ? 'வெளியேறு & திரும்பு' : 'లాగౌట్ & వెనుకకు'}
                    className="flex items-center gap-1 px-3 py-1.5 rounded-full bg-rose-600 hover:bg-rose-500 text-white font-bold text-[10px] sm:text-xs transition-all active:scale-95 shadow-sm"
                  >
                    <LogOut className="w-3 h-3" />
                    <span>{t('logout', language)}</span>
                  </button>

                  <button
                    onClick={forceUpdateApp}
                    title={language === 'en' ? 'Update App & Clear Cache' : language === 'hi' ? 'ऐप अपडेट करें और कैश साफ़ करें' : language === 'kn' ? 'ಅಪ್ಲಿಕೇಶನ್ ನವೀಕರಿಸಿ ಮತ್ತು ಸಂಗ್ರಹವನ್ನು ತೆರವುಗೊಳಿಸಿ' : language === 'ta' ? 'பயன்பாட்டைப் புதுப்பித்து தற்காலிக சேமிப்பை அழிக்கவும்' : 'యాప్ అప్‌డేట్ & క్లియర్ క్యాష్'}
                    className="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-yellow-400 hover:bg-yellow-300 text-slate-950 font-black text-xs transition-all active:scale-95 shadow-[0_0_10px_rgba(250,204,21,0.4)] cursor-pointer border border-yellow-300/40"
                  >
                    <RefreshCwIcon className="w-3.5 h-3.5 animate-spin" style={{ animationDuration: '3s' }} />
                    <span>{language === 'en' ? 'Update PWA' : language === 'hi' ? 'PWA अपडेट करें' : language === 'kn' ? 'PWA ನವೀಕರಿಸಿ' : language === 'ta' ? 'PWA ஐப் புதுப்பிக்கவும்' : 'అప్‌డేట్ PWA'}</span>
                  </button>

                  <button
                    onClick={resetAllData}
                    title="రీసెట్ చేయండి / Reset App"
                    className="p-1.5 rounded-full bg-white/5 hover:bg-rose-500/20 text-gray-300 hover:text-rose-400 transition"
                  >
                    <RotateCcw className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>
            </header>
          )}



      {/* Main Application Frame Workspace */}
      <div className={isStandaloneOrMobile 
        ? "flex-1 w-full p-0 flex flex-col" 
        : "flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start"
      }>
        
        {/* =========================================================
            LEFT COLUMN: CWRB SMARTPHONE SIMULATOR (1/2 WIDTH ON DESKTOP)
            ========================================================= */}
        <div className={isStandaloneOrMobile 
          ? `w-full flex-1 flex flex-col ${activeAdminTab ? 'hidden' : 'block'}` 
          : `${isAdmin ? 'lg:col-span-6 xl:col-span-5' : 'lg:col-span-12 xl:col-span-12'} flex flex-col items-center gap-5 w-full ${activeAdminTab ? 'hidden lg:flex' : 'block'}`
        }>
          <div 
            id="cwb-phone-mockup" 
            className={isStandaloneOrMobile 
              ? "w-full max-w-full bg-transparent p-0 overflow-visible flex-1 flex flex-col" 
              : "relative w-full max-w-[420px] bg-slate-900 rounded-[40px] p-3.5 shadow-2xl border-4 border-[#082c75] overflow-hidden"
            }
          >
            
            {/* Phone Ear Speaker and Camera Notch */}
            {!isStandaloneOrMobile && (
              <div className="absolute top-0 left-1/2 -translate-x-1/2 h-6 w-36 bg-slate-900 rounded-b-2xl z-40 flex items-center justify-center">
                <div className="w-12 h-1 bg-gray-700 rounded-full mb-1"></div>
                <div className="w-2.5 h-2.5 bg-[#082c75] rounded-full ml-3 mb-1"></div>
              </div>
            )}

            {/* Simulated Glass Screen Canvas */}
            <div 
              className={isStandaloneOrMobile 
                ? "bg-white flex flex-col relative text-gray-800 min-h-screen w-full flex-1 rounded-none border-none shadow-none" 
                : "bg-white rounded-[28px] overflow-hidden min-h-[660px] flex flex-col relative text-gray-800"
              }
              onTouchStart={handleTouchStart}
              onTouchEnd={handleTouchEnd}
            >
              
              {/* Phone Status Bar */}
              {!isStandaloneOrMobile && (
                <div className={`${appClosed ? 'bg-[#082c75]' : getThemeBgColor()} text-white px-5 pt-7 pb-1.5 flex justify-between items-center text-[10px] font-bold font-mono transition-colors duration-300`}>
                  <span>09:41</span>
                  <div className="flex items-center gap-1.5">
                    <span className="text-[9px] text-[#FFC000]">● LIVE</span>
                    <div className="w-5 h-2.5 border border-white/50 rounded-sm p-0.5 flex">
                      <div className="w-3 bg-emerald-400 h-full"></div>
                    </div>
                  </div>
                </div>
              )}

              {appClosed ? (
                <div className="flex-1 bg-[#082c75] text-white flex flex-col justify-between p-6 select-none relative overflow-hidden ">
                  {/* Decorative subtle clock circle background lines */}
                  <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,192,0,0.06)_1px,transparent_1px)] bg-[size:16px_16px] opacity-40"></div>
                  
                  {/* CWRB Header Logo area */}
                  <div className="text-center pt-4 z-10">
                    <div className="w-16 h-16 bg-[#FFC000] text-[#082c75] rounded-2xl mx-auto flex items-center justify-center font-extrabold text-2xl rotate-12 shadow-[0_0_20px_rgba(255,192,0,0.4)] transition hover:rotate-0 duration-300">
                      <span className="-rotate-12 hover:rotate-0 block">CWRB</span>
                    </div>
                    <h2 className="text-sm font-extrabold text-[#FFC000] mt-3 tracking-widest">సివిల్ వర్కర్ రిలేషన్ బుక్ (CWRB)</h2>
                    <p className="text-[9px] text-gray-300 mt-0.5 font-bold">Civil Worker Relation Book</p>
                  </div>

                  {/* Visual Wall Clock with numbers (Image 2 representation) */}
                  <div className="my-auto py-4 text-center z-10 flex flex-col items-center">
                    <div className="relative w-36 h-36 rounded-full border-4 border-[#FFC000]/40 flex items-center justify-center bg-slate-900/60 shadow-[inset_0_0_15px_rgba(0,0,0,0.6)]">
                      {/* Clock ticks / numbers */}
                      <span className="absolute top-1 text-[10px] font-bold text-[#FFC000]/80">12</span>
                      <span className="absolute bottom-1 text-[10px] font-bold text-[#FFC000]/80">6</span>
                      <span className="absolute left-2 text-[10px] font-bold text-[#FFC000]/80">9</span>
                      <span className="absolute right-2 text-[10px] font-bold text-[#FFC000]/80">3</span>
                      
                      {/* Hands */}
                      <div className="absolute w-1 h-10 bg-[#FFC000] rounded-full origin-bottom bottom-1/2 left-[calc(50%-2px)] rotate-[30deg]"></div>
                      <div className="absolute w-1 h-14 bg-white/70 rounded-full origin-bottom bottom-1/2 left-[calc(50%-2px)] rotate-[120deg]"></div>
                      <div className="w-3 h-3 bg-[#FFC000] rounded-full z-20 shadow"></div>
                    </div>
                    
                    {/* Time display & Adjust Controls */}
                    <div className="mt-3 flex flex-col items-center">
                      <div className="font-mono font-black text-xl text-white tracking-widest drop-shadow-sm flex items-center gap-1 bg-slate-900/70 px-4 py-1.5 rounded-full border border-white/10 shadow-lg">
                        <span>{String(clockHour).padStart(2, '0')}:{String(clockMinute).padStart(2, '0')} {clockAmPm}</span>
                      </div>
                      
                      {/* Time Adjustment & Live Mode Buttons */}
                      <div className="flex flex-wrap items-center justify-center gap-1.5 mt-2.5">
                        <button
                          type="button"
                          onClick={() => {
                            const nextH = clockHour >= 12 ? 1 : clockHour + 1;
                            setClockHour(nextH);
                            localStorage.setItem('cwb_clock_hour', String(nextH));
                            setIsLiveTime(false);
                            localStorage.setItem('cwb_clock_islive', 'false');
                          }}
                          className="px-2 py-0.5 bg-white/10 hover:bg-white/20 text-white rounded text-[9px] font-bold border border-white/20 transition"
                          title="Hour +"
                        >
                          Hour +
                        </button>
                        <button
                          type="button"
                          onClick={() => {
                            const nextM = clockMinute >= 59 ? 0 : clockMinute + 1;
                            setClockMinute(nextM);
                            localStorage.setItem('cwb_clock_minute', String(nextM));
                            setIsLiveTime(false);
                            localStorage.setItem('cwb_clock_islive', 'false');
                          }}
                          className="px-2 py-0.5 bg-white/10 hover:bg-white/20 text-white rounded text-[9px] font-bold border border-white/20 transition"
                          title="Min +"
                        >
                          Min +
                        </button>
                        <button
                          type="button"
                          onClick={() => {
                            const nextAmPm = clockAmPm === 'AM' ? 'PM' : 'AM';
                            setClockAmPm(nextAmPm);
                            localStorage.setItem('cwb_clock_ampm', nextAmPm);
                            setIsLiveTime(false);
                            localStorage.setItem('cwb_clock_islive', 'false');
                          }}
                          className="px-2 py-0.5 bg-[#FFC000] hover:bg-[#ffca1c] text-[#082c75] rounded text-[9px] font-extrabold transition shadow"
                          title="Toggle AM/PM"
                        >
                          {clockAmPm}
                        </button>
                        <button
                          type="button"
                          onClick={() => {
                            const newLive = !isLiveTime;
                            setIsLiveTime(newLive);
                            localStorage.setItem('cwb_clock_islive', String(newLive));
                            if (newLive) {
                              const now = new Date();
                              let h = now.getHours();
                              const m = now.getMinutes();
                              const ampm = h >= 12 ? 'PM' : 'AM';
                              h = h % 12;
                              h = h ? h : 12;
                              setClockHour(h);
                              setClockMinute(m);
                              setClockAmPm(ampm);
                              localStorage.setItem('cwb_clock_hour', String(h));
                              localStorage.setItem('cwb_clock_minute', String(m));
                              localStorage.setItem('cwb_clock_ampm', ampm);
                            }
                          }}
                          className={`px-2 py-0.5 rounded text-[9px] font-bold border transition ${isLiveTime ? 'bg-emerald-500 text-white border-emerald-400' : 'bg-white/10 text-gray-300 border-white/20 hover:bg-white/20'}`}
                          title="Toggle Live/Auto Time"
                        >
                          {isLiveTime ? '● Live Time' : '⚙ Manual'}
                        </button>
                      </div>

                      {/* Alarm Section */}
                      <div className="mt-2.5 bg-slate-900/80 border border-white/15 rounded-lg p-2 max-w-[240px] mx-auto text-left shadow-md">
                        <div className="flex items-center justify-between text-[10px] font-bold text-[#FFC000] mb-1.5">
                          <span>⏰ అలారం (Alarm):</span>
                          <button
                            type="button"
                            onClick={() => {
                              const newEnabled = !alarmEnabled;
                              setAlarmEnabled(newEnabled);
                              localStorage.setItem('cwb_alarm_enabled', String(newEnabled));
                              if (!newEnabled) setAlarmTriggered(false);
                            }}
                            className={`px-2 py-0.5 rounded text-[8px] font-extrabold ${alarmEnabled ? 'bg-emerald-500 text-white' : 'bg-gray-700 text-gray-300'}`}
                          >
                            {alarmEnabled ? 'ON' : 'OFF'}
                          </button>
                        </div>
                        <div className="flex items-center justify-between text-[10px] text-white font-mono">
                          <span>{String(alarmHour).padStart(2, '0')}:{String(alarmMinute).padStart(2, '0')} {alarmAmPm}</span>
                          <div className="flex gap-1">
                            <button
                              type="button"
                              onClick={() => {
                                const nextAH = alarmHour >= 12 ? 1 : alarmHour + 1;
                                setAlarmHour(nextAH);
                                localStorage.setItem('cwb_alarm_hour', String(nextAH));
                              }}
                              className="px-1.5 py-0.5 bg-white/10 hover:bg-white/25 rounded text-[8px] font-bold"
                              title="Alarm Hour +"
                            >
                              H+
                            </button>
                            <button
                              type="button"
                              onClick={() => {
                                const nextAM = alarmMinute >= 45 ? 0 : alarmMinute + 15;
                                setAlarmMinute(nextAM);
                                localStorage.setItem('cwb_alarm_minute', String(nextAM));
                              }}
                              className="px-1.5 py-0.5 bg-white/10 hover:bg-white/25 rounded text-[8px] font-bold"
                              title="Alarm Min +"
                            >
                              M+
                            </button>
                            <button
                              type="button"
                              onClick={() => {
                                const nextAAPM = alarmAmPm === 'AM' ? 'PM' : 'AM';
                                setAlarmAmPm(nextAAPM);
                                localStorage.setItem('cwb_alarm_ampm', nextAAPM);
                              }}
                              className="px-1.5 py-0.5 bg-[#FFC000] text-[#082c75] rounded text-[8px] font-black"
                              title="Toggle AM/PM"
                            >
                              {alarmAmPm}
                            </button>
                          </div>
                        </div>
                        {alarmTriggered && (
                          <div className="mt-1.5 bg-rose-600/90 text-white text-[9px] font-black text-center py-1 rounded animate-pulse">
                            🚨 అలారం మోగుతోంది! (Alarm Ringing!)
                          </div>
                        )}
                      </div>
                    </div>
                    

                  </div>

                  {/* Golden Open Button with ripple effect */}
                  <div className="pb-4 text-center z-10">
                    <button
                      onClick={() => {
                        if (soundOn) {
                          try {
                            const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
                            const osc = audioCtx.createOscillator();
                            const gain = audioCtx.createGain();
                            osc.connect(gain);
                            gain.connect(audioCtx.destination);
                            osc.frequency.setValueAtTime(880, audioCtx.currentTime); // Beep tone
                            gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                            osc.start();
                            osc.stop(audioCtx.currentTime + 0.15);
                          } catch (e) {}
                        }
                        setAppClosed(false);
                      }}
                      className="w-full max-w-[200px] py-3 bg-[#FFC000] hover:bg-amber-400 text-[#082c75] font-black text-sm rounded-full shadow-[0_4px_15px_rgba(255,192,0,0.4)] transition-all hover:scale-105 active:scale-95 flex items-center justify-center gap-2 mx-auto cursor-pointer"
                    >
                      <span className="relative flex h-2 w-2">
                        <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#082c75] opacity-75"></span>
                        <span className="relative inline-flex rounded-full h-2 w-2 bg-[#082c75]"></span>
                      </span>
                      <span>ఓపెన్ / OPEN</span>
                    </button>
                    <p className="text-[8px] text-gray-400 mt-2">యాప్‌ను తెరవడానికి పైన ఉన్న బటన్ నొక్కండి (Press to Open App)</p>
                  </div>
                </div>
              ) : (
                <>
                  {/* Dynamic App Shell Header */}
                  <div className="bg-[#082c75] text-white px-3 sm:px-3.5 py-2.5 sm:py-3 border-b border-[#FFC000]/20 flex flex-col gap-2 sm:gap-2.5 transition-colors duration-300">
                    {/* Row 1: Logo and navigational headers */}
                    <div className="flex justify-between items-center w-full gap-2">
                      <div className="flex items-center gap-1.5 shrink-0 min-w-0 flex-1">
                        <CWRBLogo className="scale-115 sm:scale-125 origin-left" />
                      </div>

                      <div className="flex items-center gap-1 sm:gap-1.5 shrink-0">
                        {/* Dedicated Settings Button inside phone mockup header */}
                        {showSettingsIcon && (
                          <button
                            onClick={() => setShowMobileSettings(true)}
                            title="సెట్టింగ్స్ / App Settings"
                            className="p-1.5 rounded-lg bg-white/10 hover:bg-white/20 transition-all text-[#FFC000] flex items-center justify-center active:scale-90"
                          >
                            <Settings className="w-3.5 h-3.5 text-[#FFC000]" />
                          </button>
                        )}

                        {/* Back/Logout Button inside phone mockup */}
                        <button
                          onClick={handleLogout}
                          title={language === 'en' ? 'Logout & Go Back' : language === 'hi' ? 'लॉग आउट और वापस जाएं' : language === 'kn' ? 'ಲಾಗ್ ಔಟ್ ಮತ್ತು ಹಿಂತಿರುಗಿ' : language === 'ta' ? 'வெளியேறு & திரும்பு' : 'లాగౌట్ & వెనుకకు'}
                          className="px-2 py-1.5 rounded-lg bg-rose-600/20 hover:bg-rose-600/30 text-white border border-rose-500/20 transition-colors flex items-center justify-center gap-1 text-[10px] font-bold active:scale-95"
                        >
                          <LogOut className="w-3 h-3 text-[#FFC000]" />
                          <span>{language === 'en' ? 'Back' : language === 'hi' ? 'पीछे' : language === 'kn' ? 'ಹಿಂದೆ' : language === 'ta' ? 'பின்னால்' : 'వెనుకకు'}</span>
                        </button>
                      </div>
                    </div>

                    {/* Row 2: Highly visible system status and action control bar (Update PWA, SOS, Radio) */}
                    <div className="flex justify-center items-center bg-slate-950/45 p-1 sm:p-1.5 rounded-xl border border-white/5 w-full gap-1.5 sm:gap-2">
                      <div className="flex items-center gap-1.5 sm:gap-2 shrink-0">
                        {/* PWA Direct Cache Buster Button for phone mockup */}
                        <button
                          onClick={forceUpdateApp}
                          title={language === 'en' ? 'Clear Cache & Update App' : language === 'hi' ? 'कैश साफ़ करें और ऐप अपडेट करें' : language === 'kn' ? 'ಸಂಗ್ರಹವನ್ನು ತೆರವುಗೊಳಿಸಿ మరియు ಅಪ್ಲಿಕೇಶನ್ ನವೀಕರಿಸಿ' : language === 'ta' ? 'தற்காலிக சேமிப்பை அழித்து பயன்பாட்டைப் புதுப்பிக்கவும்' : 'క్లియర్ క్యాష్ & అప్‌డేట్ / Clear Cache & Update App'}
                          className="px-1.5 sm:px-2 py-1 sm:py-1.5 rounded-md sm:rounded-lg bg-yellow-400 hover:bg-yellow-300 text-slate-950 transition-all flex items-center justify-center gap-1 shadow-md animate-pulse text-[8px] sm:text-[9px] font-black cursor-pointer border border-yellow-300/40 shrink-0"
                        >
                          <RefreshCwIcon className="w-2.5 h-2.5 sm:w-3 sm:h-3 animate-spin" style={{ animationDuration: '4s' }} />
                          <span>{language === 'en' ? 'Update PWA' : language === 'hi' ? 'PWA अपडेट करें' : language === 'kn' ? 'PWA ನವೀಕರಿಸಿ' : language === 'ta' ? 'PWA ஐப் புதுப்பிக்கவும்' : 'అప్‌డేట్ PWA'}</span>
                        </button>

                        {/* FEATURE 7: SOS Emergency Tracker button (pulsing crimson red top right) */}
                        <button
                          onClick={() => {
                            if (radioFeatureEnabled) setIsHybridRadioMode(!isHybridRadioMode);
                          }}
                          title="హైబ్రిడ్ రేడియో ఫ్రీక్వెన్సీ (Offline Radio)"
                          className={`px-1.5 sm:px-2 py-1 sm:py-1.5 rounded-md sm:rounded-lg text-[8px] sm:text-[9px] font-black tracking-wider transition-all border flex items-center gap-1 shadow-sm shrink-0 ${
                            effectiveRadioMode 
                              ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40 shadow-emerald-500/10' 
                              : 'bg-slate-800 text-slate-400 border-slate-700'
                          } ${!radioFeatureEnabled ? 'opacity-50 cursor-not-allowed' : ''}`}
                        >
                          <Radio className={`w-2.5 h-2.5 sm:w-3 sm:h-3 ${effectiveRadioMode ? 'animate-pulse' : ''}`} />
                          <span>{effectiveRadioMode ? 'LIVE RADIO' : 'RADIO OFF'}</span>
                        </button>

                        {featureStates['feat_sos'] !== 'soft_delete' && featureStates['feat_sos'] !== 'hard_delete' && (
                          <div className="relative shrink-0">
                            {featureStates['feat_sos'] === 'temp_off' || featureStates['feat_sos'] === 'perm_off' ? (
                              <button disabled className="px-1.5 sm:px-2 py-1 sm:py-1.5 rounded-md sm:rounded-lg bg-gray-500 text-gray-300 opacity-50 cursor-not-allowed text-[8px] sm:text-[9px] font-bold">
                                SOS OFF
                              </button>
                            ) : (
                              <button
                                onClick={triggerSos}
                                className="px-2 sm:px-2.5 py-1 sm:py-1.5 rounded-md sm:rounded-lg bg-rose-600 text-white font-black text-[9px] sm:text-[10px] shadow-[0_0_12px_rgba(225,29,72,0.4)] flex items-center gap-1 active:scale-95 hover:bg-rose-700 shrink-0"
                              >
                                <span className="w-1 h-1 sm:w-1.5 sm:h-1.5 rounded-full bg-white animate-ping shrink-0"></span>
                                <span>SOS</span>
                              </button>
                            )}
                          </div>
                        )}

                        {/* Weather Report Button next to SOS button */}
                        {featureStates['feat_weather_report'] !== 'soft_delete' && featureStates['feat_weather_report'] !== 'hard_delete' && (
                          <div className="relative shrink-0">
                            {featureStates['feat_weather_report'] === 'temp_off' || featureStates['feat_weather_report'] === 'perm_off' ? (
                              <button disabled className="px-1.5 sm:px-2 py-1 sm:py-1.5 rounded-md sm:rounded-lg bg-gray-500 text-gray-300 opacity-50 cursor-not-allowed text-[8px] sm:text-[9px] font-bold">
                                WEATHER OFF
                              </button>
                            ) : (
                              <button
                                onClick={() => setShowWeatherModal(true)}
                                className="px-2 sm:px-2.5 py-1 sm:py-1.5 rounded-md sm:rounded-lg bg-sky-600 text-white font-black text-[9px] sm:text-[10px] shadow-[0_0_12px_rgba(14,165,233,0.4)] flex items-center gap-1 active:scale-95 hover:bg-sky-700 shrink-0"
                              >
                                <CloudSun className="w-3 h-3 text-sky-200 animate-pulse" />
                                <span>{language === 'en' ? '32°C Weather' : language === 'hi' ? '32°C मौसम' : language === 'kn' ? '32°C ಹವಾಮಾನ' : language === 'ta' ? '32°C வானிலை' : '32°C వాతావరణం'}</span>
                              </button>
                            )}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>

              {/* FEATURE: ChatAssistant (Placed near SOS) */}
              <ChatAssistant 
                enabled={isChatAssistantEnabled} 
                isAgentToggleVisible={isAgentToggleVisible} 
                isBrahmastraButtonVisible={isBrahmastraButtonVisible} 
                isSystemOnline={isSystemOnline}
                language={language}
              />


              {/* Role Switch Tabs (FEATURE 2: Single App Multi-User setup) */}
              <div className="grid grid-cols-3 bg-gray-100 p-1">
                <button
                  onClick={() => setActiveTab('customer')}
                  className={`py-1.5 text-[10px] font-black rounded-lg transition-all text-center flex flex-col items-center justify-center gap-0.5 ${
                    activeTab === 'customer'
                      ? `${getThemeBgColor()} text-[#FFC000] shadow-sm`
                      : 'text-gray-600 hover:text-gray-900'
                  }`}
                >
                  <User className="w-4 h-4" />
                  <span>కస్టమర్ / Customer</span>
                </button>
                <button
                  onClick={() => setActiveTab('worker')}
                  className={`py-1.5 text-[10px] font-black rounded-lg transition-all text-center flex flex-col items-center justify-center gap-0.5 ${
                    activeTab === 'worker'
                      ? `${getThemeBgColor()} text-[#FFC000] shadow-sm`
                      : 'text-gray-600 hover:text-gray-900'
                  }`}
                >
                  <ShieldCheck className="w-4 h-4" />
                  <span>వర్కర్ / Worker</span>
                </button>
                <button
                  onClick={() => setActiveTab('provider')}
                  className={`py-1.5 text-[10px] font-black rounded-lg transition-all text-center flex flex-col items-center justify-center gap-0.5 ${
                    activeTab === 'provider'
                      ? `${getThemeBgColor()} text-[#FFC000] shadow-sm`
                      : 'text-gray-600 hover:text-gray-900'
                  }`}
                >
                  <Store className="w-4 h-4" />
                  <span>వెండర్ / Vendor</span>
                </button>
              </div>

              {/* Smartphone Viewport Main Scroll Area */}
              <div 
                key={customerFlowState}
                className={`p-4 space-y-5 w-full ${isStandaloneOrMobile ? 'flex-1 max-h-none' : 'flex-1 overflow-y-auto max-h-[500px]'}`}
              >

                {/* Smartphone Viewport Main Scroll Area */}
                {/* This will hold all content */}


                {/* CUSTOMER PANEL SCREEN VIEW */}
                {activeTab === 'customer' && (
                  <div className="space-y-5 animate-fade-in">
                    
                    {currentScreen === 'home' && customerFlowState === 'home' && (
                      <>
                        {/* Welcome banner */}
                        <div className="bg-gradient-to-r from-blue-50 to-indigo-50 p-3.5 rounded-2xl border border-blue-100/60 text-xs flex flex-col items-start gap-2.5 shadow-xs w-full">
                          <div className="space-y-0.5">
                            <div className="font-extrabold text-[#082c75] flex items-center gap-1.5">
                              <span>{language === 'en' ? 'Welcome!' : language === 'hi' ? 'स्वागत है!' : language === 'kn' ? 'ಸ್ವಾಗತ!' : language === 'ta' ? 'வரவேற்கிறோம்!' : 'స్వాగతం!'}</span>
                              <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
                            </div>
                            <div className="text-[10px] text-gray-600 font-medium leading-relaxed">
                              {language === 'en' 
                                ? 'Choose workers from the main categories below. Open the guide to learn how the app works.' 
                                : language === 'hi' 
                                ? 'नीचे दी गई मुख्य श्रेणियों में से श्रमिकों को चुनें। ऐप कैसे काम करता है यह जानने के लिए गाइड खोलें।' 
                                : language === 'kn' 
                                ? 'ಕೆಳಗಿನ ಪ್ರಮುಖ ವರ್ಗಗಳಿಂದ ಕಾರ್ಮಿಕರನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಅಪ್ಲಿಕೇಶನ್ ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ ಎಂದು ತಿಳಿಯಲು ಮಾರ್ಗದರ್ಶಿಯನ್ನು ತೆರೆಯಿರಿ.' 
                                : language === 'ta' 
                                ? 'கீழே உள்ள முக்கிய பிரிவுகளில் இருந்து பணியாளர்களைத் தேர்ந்தெடுக்கவும். பயன்பாடு எவ்வாறு செயல்படுகிறது என்பதை அறிய வழிகாட்டியைத் திறக்கவும்।' 
                                : 'కింద ఉన్న ప్రధాన కేటగిరీల నుండి వర్కర్లను ఎంచుకోండి. యాప్ ఎలా పనిచేస్తుందో తెలుసుకోవడానికి గైడ్ ఓపెన్ చేయండి.'}
                            </div>
                          </div>
                          <div className="w-full flex flex-col gap-2">
                            <button
                              onClick={() => setShowAppWalkthrough(true)}
                              className="w-full bg-amber-400 hover:bg-amber-300 text-slate-900 font-extrabold text-[10px] py-2.5 rounded-xl border border-amber-300 transition active:scale-95 flex items-center justify-center gap-1.5 shadow-xs cursor-pointer"
                            >
                              📖 {t('app_guide', language)}
                            </button>
                            
                            <div className="grid grid-cols-2 gap-2 w-full">
                              <a
                                href={`tel:${customerCarePhone}`}
                                onClick={handleCustomerCareClick}
                                className="bg-[#082c75] hover:bg-opacity-90 text-white font-extrabold text-[9px] sm:text-[10px] py-2.5 rounded-xl border border-blue-900/30 transition active:scale-95 flex items-center justify-center gap-1.5 shadow-xs cursor-pointer text-center"
                              >
                                <Phone className="w-3.5 h-3.5 text-[#FFC000]" />
                                <span>{t('customer_care', language)}</span>
                              </a>
                              <a
                                href={feedbackGoogleForm || "#"}
                                target={feedbackGoogleForm ? "_blank" : undefined}
                                rel="noopener noreferrer"
                                onClick={(e) => {
                                  if (!feedbackGoogleForm) {
                                    e.preventDefault();
                                    alert("ఫీడ్‌బ్యాక్ ఫారం లింక్ ఇంకా సెట్ చేయబడలేదు. అడ్మిన్ మాస్టర్ కంట్రోల్ ప్యానెల్‌లో సెట్ చేసుకోండి!");
                                  }
                                }}
                                className="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-[9px] sm:text-[10px] py-2.5 rounded-xl border border-emerald-500/30 transition active:scale-95 flex items-center justify-center gap-1.5 shadow-xs cursor-pointer text-center"
                              >
                                <MessageSquare className="w-3.5 h-3.5 text-white" />
                                <span>{t('feedback', language)}</span>
                              </a>
                            </div>
                          </div>
                        </div>

                        {/* FEATURE 3: 24 Core Service Categories Grid */}
                        <div className="space-y-2 w-full h-auto">
                          <div className="flex justify-between items-center">
                            <h3 className="font-bold text-xs text-[#082c75] uppercase tracking-wide">{t('main_occupations', language)}</h3>
                          </div>

                          <div className="grid grid-cols-3 sm:grid-cols-4 gap-2 sm:gap-2.5">
                            {services.map((service, index) => {
                              const featureId = `feat_service_${index + 1}`;
                              const serviceState = featureStates[featureId] || 'temp_on';
                              
                              if (serviceState === 'soft_delete' || serviceState === 'hard_delete') {
                                return null;
                              }

                              const isServiceDisabled = serviceState === 'temp_off' || serviceState === 'perm_off';

                              return (
                              <button
                                key={service.id}
                                type="button"
                                onClick={() => {
                                  if (isServiceDisabled) {
                                    alert("⚠️ ఈ సేవ ప్రస్తుతం ఆఫ్ చేయబడింది. (This service is currently disabled)");
                                    return;
                                  }
                                  if (service.id === 'ecommerce') {
                                    setCustomerFlowState('ecommerce');
                                  } else if (service.id === 'astrology') {
                                    setCustomerFlowState('panchangam');
                                  } else if (service.id === 'biopower') {
                                    setCustomerFlowState('biopower');
                                  } else if (service.id === 'radio') {
                                    setCustomerFlowState('radio');
                                  } else {
                                    setSelectedService(service);
                                    setCustomerFlowState('worker_list');
                                  }
                                }}
                                className={`relative p-1 rounded-xl text-center transition-all duration-300 bg-gradient-to-b from-[#1c4491] to-[#143475] border-2 flex flex-col items-center justify-between min-h-[58px] sm:min-h-[66px] shadow-[0_4px_10px_rgba(0,0,0,0.15)] ${isServiceDisabled ? 'opacity-40 cursor-not-allowed border-[#FFC000]/10 grayscale' : 'hover:from-[#254A9E] hover:to-[#1c4491] border-[#FFC000]/25 hover:border-[#FFC000] hover:scale-[1.04] active:scale-95 hover:shadow-[0_4px_15px_rgba(255,192,0,0.25)] cursor-pointer'}`}
                              >
                                {/* Number Badge - beautifully styled */}
                                <span className={`absolute top-1 right-1.5 text-[7px] sm:text-[9px] font-mono font-black ${isServiceDisabled ? 'text-gray-400' : 'text-[#FFC000]/70'}`}>
                                  {String(index + 1).padStart(2, '0')}
                                </span>
                                
                                {/* Icon Container with nice gold glassmorphism */}
                                <div className={`w-6 h-6 rounded-lg flex items-center justify-center shrink-0 mb-0.5 ${isServiceDisabled ? 'bg-gray-500/10 text-gray-400' : 'bg-[#FFC000]/10 text-[#FFC000] shadow-[inset_0_0_8px_rgba(255,192,0,0.15)]'}`}>
                                  {getCategoryIcon(service.icon)}
                                </div>
                                
                                {/* Highly legible bilingual labels */}
                                <div className="w-full text-center flex flex-col items-center justify-center flex-1 px-1">
                                  <div className={`font-extrabold text-[10px] sm:text-[12px] tracking-tight leading-tight w-full break-words ${isServiceDisabled ? 'text-gray-300' : 'text-white'}`}>
                                    {language === 'en' ? service.nameEn :
                                     language === 'hi' ? service.nameHi :
                                     language === 'kn' ? service.nameKn :
                                     language === 'ta' ? service.nameTa :
                                     service.nameTe}
                                  </div>
                                </div>
                              </button>
                              );
                            })}
                          </div>
                        </div>

                      </>
                    )}

                    {/* PANCHANGAM SCREEN */}
                    {currentScreen === 'home' && customerFlowState === 'panchangam' && (
                      <TeluguCalendar onBack={() => setCustomerFlowState('home')} />
                    )}
                    
                    
                    {/* ECOMMERCE SCREEN */}
                    {currentScreen === 'home' && customerFlowState === 'ecommerce' && (
                      <div className="space-y-4  -mx-4 -mt-5">
                         <EcommerceCustomerView onBack={() => setCustomerFlowState('home')} />
                      </div>
                    )}

                    {/* BIO-POWER SCREEN */}
                    {currentScreen === 'home' && customerFlowState === 'biopower' && (
                      <div className="space-y-4 ">
                        <div className="flex items-center justify-between bg-[#082c75] text-white p-2.5 rounded-xl border border-white/10">
                          <button
                            onClick={() => {
                              if (activeRadioScreen) {
                                setActiveRadioScreen(null);
                              } else {
                                setCustomerFlowState('home');
                              }
                            }}
                            className="text-xs font-bold text-[#FFC000] flex items-center gap-1 hover:underline"
                          >
                            <ChevronRight className="w-3.5 h-3.5 rotate-180" /> వెనుకకు (Back)
                          </button>
                        </div>
                        <BioPowerManager 
                          controlState={featureStates['feat_biopower']} 
                          onToggleActive={() => {
                            const updated = { ...rawFeatureStates, feat_biopower: 'temp_on' as const };
                            setFeatureStates(updated);
                            localStorage.setItem('cwb_features', JSON.stringify(updated));
                          }}
                        />
                      </div>
                    )}
                    
                    {/* OFFLINE RADIO SCREEN */}
                    {currentScreen === 'home' && customerFlowState === 'radio' && (
                      <div className="space-y-4 ">
                        <div className="flex items-center justify-between bg-[#082c75] text-white p-2.5 rounded-xl border border-white/10">
                          <button
                            onClick={() => {
                              if (activeRadioScreen) {
                                setActiveRadioScreen(null);
                              } else {
                                setCustomerFlowState('home');
                              }
                            }}
                            className="text-xs font-bold text-[#FFC000] flex items-center gap-1 hover:underline"
                          >
                            <ChevronRight className="w-3.5 h-3.5 rotate-180" /> వెనుకకు (Back)
                          </button>
                        </div>
                        
                        {!activeRadioScreen ? (
                          <div className={`bg-slate-900 border ${effectiveRadioMode ? 'border-emerald-500/50 shadow-[0_0_15px_rgba(16,185,129,0.15)]' : 'border-slate-800'} rounded-2xl p-4 overflow-hidden relative`}>
                            <div className="flex justify-between items-start mb-4 relative z-10">
                              <div>
                                <h3 className="font-black text-white text-sm flex items-center gap-1.5">
                                  <Radio className={`w-4 h-4 ${effectiveRadioMode ? 'text-emerald-400 animate-pulse' : 'text-slate-500'}`} />
                                  <span>హైబ్రిడ్ రేడియో సిస్టమ్</span>
                                </h3>
                                <p className="text-[9px] text-slate-400 mt-0.5 uppercase tracking-wide">Offline Radio Network</p>
                              </div>
                              <div className={`px-2 py-1 rounded-full text-[9px] font-bold flex items-center gap-1 border ${effectiveRadioMode ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' : 'bg-slate-800 text-slate-400 border-slate-700'}`}>
                                <span className={`w-1.5 h-1.5 rounded-full ${effectiveRadioMode ? 'bg-emerald-400 animate-ping' : 'bg-slate-500'}`}></span>
                                <span>{effectiveRadioMode ? 'NETWORK ACTIVE' : 'OFFLINE'}</span>
                              </div>
                            </div>
                            
                            <div className="space-y-3 relative z-10">
                              <p className="text-[11px] text-slate-300 leading-relaxed mb-4">
                                ఇంటర్నెట్ అందుబాటులో లేని ప్రాంతాల్లో ఈ ఫీచర్ ద్వారా మన యాప్ పనిచేస్తుంది. దీని ద్వారా కింది సేవలు కంట్రోల్ చేయబడతాయి:
                              </p>
                              
                              <div className="grid grid-cols-1 gap-2">
                                {[
                                  { id: 'sync', title: 'వర్కర్లతో కనెక్షన్ (Worker Sync)', desc: 'ఆఫ్‌లైన్‌లో ఉన్న వర్కర్లకు సిగ్నల్ పంపడం.', icon: Users, colorClasses: { activeBorder: 'border-blue-500/50', shadow: 'shadow-[0_0_10px_rgba(59,130,246,0.2)]', iconBg: 'bg-blue-500/10', iconText: 'text-blue-400' } },
                                  { id: 'sos', title: 'ఎమర్జెన్సీ అలర్ట్స్ (SOS Radio)', desc: 'ప్రమాద సమయంలో రేడియో ఫ్రీక్వెన్సీ ద్వారా SOS పంపడం.', icon: AlertCircle, colorClasses: { activeBorder: 'border-rose-500/50', shadow: 'shadow-[0_0_10px_rgba(244,63,94,0.2)]', iconBg: 'bg-rose-500/10', iconText: 'text-rose-400' } },
                                  { id: 'gps', title: 'ఆఫ్‌లైన్ లొకేషన్ (Offline GPS)', desc: 'రేడియో తరంగాల ద్వారా వర్కర్ ఉన్న ప్రదేశం గుర్తింపు.', icon: MapPin, colorClasses: { activeBorder: 'border-amber-500/50', shadow: 'shadow-[0_0_10px_rgba(245,158,11,0.2)]', iconBg: 'bg-amber-500/10', iconText: 'text-amber-400' } },
                                  { id: 'phone', title: 'ఆఫ్‌లైన్ కాలింగ్ (Offline Phone)', desc: 'మొబైల్ సిగ్నల్ లేకపోయినా కాల్స్ మాట్లాడుకునే సదుపాయం.', icon: Phone, colorClasses: { activeBorder: 'border-emerald-500/50', shadow: 'shadow-[0_0_10px_rgba(16,185,129,0.2)]', iconBg: 'bg-emerald-500/10', iconText: 'text-emerald-400' } },
                                  { id: 'media', title: 'యూట్యూబ్ & ఫేస్‌బుక్ సింక్', desc: 'ఇంటర్నెట్ లేకుండానే వీడియోలు మరియు సోషల్ మీడియా డేటా సింక్.', icon: Play, colorClasses: { activeBorder: 'border-purple-500/50', shadow: 'shadow-[0_0_10px_rgba(168,85,247,0.2)]', iconBg: 'bg-purple-500/10', iconText: 'text-purple-400' } },
                                  { id: 'walkie', title: 'వాకీ-టాకీ కనెక్షన్ (Walkie-Talkie)', desc: 'ఇంటర్నెట్ లేకపోయినా రేడియో ఫ్రీక్వెన్సీ ద్వారా వాయిస్ కమ్యూనికేషన్.', icon: Radio, colorClasses: { activeBorder: 'border-cyan-500/50', shadow: 'shadow-[0_0_10px_rgba(6,182,212,0.2)]', iconBg: 'bg-cyan-500/10', iconText: 'text-cyan-400' } },
                                  { id: 'weather', title: 'వాతావరణ నివేదిక (Weather Radio)', desc: 'రేడియో తరంగాల ద్వారా లభించే వాతావరణ అప్‌డేట్స్ మరియు అలర్ట్స్.', icon: CloudSun, colorClasses: { activeBorder: 'border-sky-500/50', shadow: 'shadow-[0_0_10px_rgba(14,165,233,0.2)]', iconBg: 'bg-sky-500/10', iconText: 'text-sky-400' } },
                                ].map((item) => (
                                  <div
                                    key={item.id}
                                    onClick={() => {
                                      if (!effectiveRadioMode) return;
                                      if (radioToggles[item.id]) {
                                        setActiveRadioScreen(item.id);
                                      }
                                    }}
                                    className={`w-full text-left bg-slate-950 p-2.5 rounded-xl border flex items-center justify-between gap-3 transition-all ${
                                      radioToggles[item.id]
                                        ? `${item.colorClasses.activeBorder} ${item.colorClasses.shadow} bg-slate-900` 
                                        : 'border-slate-800 hover:border-slate-700 hover:bg-slate-900'
                                    } ${!effectiveRadioMode ? 'opacity-60 cursor-not-allowed' : 'cursor-pointer'}`}
                                  >
                                    <div className="flex items-center gap-3">
                                      <div className={`${item.colorClasses.iconBg} p-2 rounded-lg ${item.colorClasses.iconText} ${radioToggles[item.id] && effectiveRadioMode ? 'animate-pulse' : ''}`}>
                                        <item.icon className="w-4 h-4" />
                                      </div>
                                      <div>
                                        <div className="text-[10px] font-bold text-white flex items-center gap-2">
                                          {item.title}
                                        </div>
                                        <div className="text-[8px] text-slate-400">{item.desc}</div>
                                      </div>
                                    </div>
                                    
                                    <div className="flex items-center gap-2 px-1" onClick={(e) => { e.stopPropagation(); if (effectiveRadioMode) setRadioToggles(prev => ({...prev, [item.id]: !prev[item.id]})); }}>
                                      <span className={`text-[8px] font-bold ${radioToggles[item.id] ? 'text-emerald-400' : 'text-slate-500'}`}>
                                        {radioToggles[item.id] ? 'ON' : 'OFF'}
                                      </span>
                                      <div className={`w-8 h-4 rounded-full relative transition-colors ${radioToggles[item.id] && effectiveRadioMode ? 'bg-emerald-500' : 'bg-slate-700'}`}>
                                        <div className={`absolute top-0.5 left-0.5 w-3 h-3 rounded-full bg-white transition-transform ${radioToggles[item.id] && effectiveRadioMode ? 'translate-x-4' : 'translate-x-0'}`}></div>
                                      </div>
                                    </div>
                                  </div>
                                ))}
                              </div>
                              
                              {!radioFeatureEnabled ? (
                                <div className="mt-4 text-[9px] text-rose-500/80 text-center bg-rose-500/10 p-2 rounded-lg border border-rose-500/20 font-bold">
                                  అడ్మిన్ ద్వారా ఆఫ్ చేయబడింది (ADMIN DISABLED)
                                </div>
                              ) : (
                                <div className="mt-4 text-[9.5px] text-amber-500 text-center bg-amber-500/10 p-2.5 rounded-lg border border-amber-500/20 leading-relaxed font-bold">
                                  గమనిక: ఈ ఫీచర్లన్నీ మరియు సదుపాయాలన్నీ కేవలం పోస్ట్ పెయిడ్ వినియోగదారులకు (Postpaid Users) మాత్రమే అందుబాటులో ఉంటాయి.
                                </div>
                              )}
                            </div>
                          </div>
                        ) : (
                          <div className="bg-slate-900 border border-slate-700 rounded-2xl overflow-hidden min-h-[400px] flex flex-col">
                            {/* Render sub-screens */}
                            {activeRadioScreen === 'media' && (
                              <div className="flex-1 w-full h-full bg-black flex flex-col relative">
                                <div className="p-3 bg-zinc-900 border-b border-zinc-800 flex items-center justify-between">
                                  <div className="flex items-center gap-2">
                                    <Play className="w-4 h-4 text-red-500" />
                                    <span className="text-white text-xs font-bold">YouTube (Offline Sync)</span>
                                  </div>
                                  <div className="text-[8px] bg-red-500/20 text-red-400 px-1.5 py-0.5 rounded border border-red-500/30">OFFLINE MODE</div>
                                </div>
                                <div className="flex-1 w-full flex flex-col">
                                  <iframe 
                                    className="w-full h-[220px]"
                                    src="https://www.youtube.com/embed/jfKfPfyJRdk?autoplay=1&mute=1" 
                                    title="YouTube video player" 
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                    allowFullScreen
                                  ></iframe>
                                  <div className="p-4 space-y-3">
                                    <h4 className="text-white font-bold text-sm">lofi hip hop radio - beats to relax/study to</h4>
                                    <div className="flex items-center gap-3 text-slate-400 text-xs">
                                      <span>Lofi Girl</span>
                                      <span>•</span>
                                      <span>10M Views</span>
                                    </div>
                                    <div className="bg-zinc-800/50 p-3 rounded-xl border border-zinc-700">
                                      <p className="text-slate-300 text-xs leading-relaxed">
                                        This video is playing via offline radio sync. Your connection is secured through the local radio frequency network.
                                      </p>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            )}
                            
                            {activeRadioScreen === 'phone' && (
                              <div className="flex-1 flex flex-col items-center justify-center p-6 bg-slate-950 text-center space-y-6">
                                <div className="w-20 h-20 rounded-full bg-emerald-500/20 flex items-center justify-center border-4 border-emerald-500/30 relative">
                                  <div className="absolute inset-0 rounded-full border-2 border-emerald-500 animate-ping opacity-50"></div>
                                  <Phone className="w-8 h-8 text-emerald-400" />
                                </div>
                                <div className="space-y-2">
                                  <h3 className="text-white font-bold text-lg">Offline Calling Ready</h3>
                                  <p className="text-slate-400 text-xs px-4">Connect to any worker using secure radio frequencies without cellular network.</p>
                                </div>
                                
                                <div className="grid grid-cols-3 gap-4 w-full max-w-[200px] mx-auto mt-6">
                                  {[1, 2, 3, 4, 5, 6, 7, 8, 9, '*', 0, '#'].map((num, i) => (
                                    <div key={i} className="aspect-square rounded-full bg-slate-800 flex items-center justify-center text-white font-bold text-xl active:bg-slate-700 transition-colors">
                                      {num}
                                    </div>
                                  ))}
                                </div>
                                <div className="mt-6">
                                  <button className="w-16 h-16 rounded-full bg-emerald-500 flex items-center justify-center shadow-[0_0_20px_rgba(16,185,129,0.4)]">
                                    <Phone className="w-6 h-6 text-white" />
                                  </button>
                                </div>
                              </div>
                            )}
                            
                            {activeRadioScreen === 'walkie' && (
                              <div className="flex-1 w-full bg-slate-950 p-4 relative overflow-y-auto">
                                <WalkieTalkie controlState={featureStates['feat_walkietalkie']} />
                              </div>
                            )}
                            
                            {activeRadioScreen === 'gps' && (
                              <div className="flex-1 w-full h-[450px] bg-slate-900 relative">
                                <GeofenceMap radiusKm={geofenceRadius} onRadiusChange={setGeofenceRadius} controlState={featureStates['feat_geofencing']} />
                                <div className="absolute top-4 left-4 right-4 bg-amber-500/90 text-white text-[10px] p-2 rounded-lg font-bold shadow-lg flex items-center gap-2 backdrop-blur-sm z-50">
                                  <Radio className="w-4 h-4 animate-pulse" />
                                  <span>RADIO NETWORK GPS MODE ACTIVE</span>
                                </div>
                              </div>
                            )}
                            
                            {activeRadioScreen === 'sos' && (
                              <div className="flex-1 flex flex-col items-center justify-center p-6 bg-rose-950 text-center space-y-8 min-h-[400px]">
                                <div className="space-y-3">
                                  <AlertCircle className="w-12 h-12 text-rose-500 mx-auto" />
                                  <h3 className="text-white font-bold text-xl uppercase tracking-wider">Emergency SOS</h3>
                                  <p className="text-rose-200/70 text-xs">Transmitting distress signal over all available radio frequencies.</p>
                                </div>
                                
                                <button className="w-40 h-40 rounded-full bg-gradient-to-b from-rose-500 to-rose-700 flex flex-col items-center justify-center shadow-[0_0_50px_rgba(244,63,94,0.6)] border-4 border-rose-400 active:scale-95 transition-transform relative overflow-hidden">
                                  <div className="absolute inset-0 bg-white/20 animate-pulse"></div>
                                  <Radio className="w-10 h-10 text-white mb-2" />
                                  <span className="text-white font-black text-2xl tracking-widest">SOS</span>
                                </button>
                                
                                <div className="flex items-center gap-2 text-rose-400 text-xs font-mono bg-rose-900/50 px-4 py-2 rounded-lg border border-rose-500/30">
                                  <span className="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                                  BROADCASTING...
                                </div>
                              </div>
                            )}
                            
                            {activeRadioScreen === 'sync' && (
                              <div className="flex-1 flex flex-col p-4 bg-slate-950 text-white min-h-[400px]">
                                <div className="flex items-center gap-3 mb-6 p-4 bg-blue-900/20 rounded-xl border border-blue-500/30">
                                  <div className="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center">
                                    <Users className="w-5 h-5 text-blue-400" />
                                  </div>
                                  <div>
                                    <h3 className="font-bold text-sm text-blue-300">Radio Worker Sync</h3>
                                    <p className="text-[9px] text-blue-200/70">Syncing data over 433MHz frequency</p>
                                  </div>
                                </div>
                                
                                <div className="space-y-3 flex-1 overflow-y-auto pr-2">
                                  {[1, 2, 3, 4].map(i => (
                                    <div key={i} className="bg-slate-900 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
                                      <div className="flex items-center gap-3">
                                        <div className="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center">
                                          <User className="w-4 h-4 text-slate-400" />
                                        </div>
                                        <div>
                                          <div className="text-xs font-bold">Worker {i}</div>
                                          <div className="text-[9px] text-slate-500">Last sync: Just now</div>
                                        </div>
                                      </div>
                                      <div className="text-[9px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-1 rounded">SYNCED</div>
                                    </div>
                                  ))}
                                </div>
                                
                                <button className="mt-4 w-full py-3 bg-blue-600 hover:bg-blue-500 rounded-xl text-white font-bold text-xs flex items-center justify-center gap-2 transition-colors">
                                  <RotateCcw className="w-4 h-4" />
                                  SYNC NOW
                                </button>
                              </div>
                            )}

                            {activeRadioScreen === 'weather' && (
                              <div className="flex-1 flex flex-col p-4 bg-slate-950 text-white min-h-[400px] space-y-4">
                                <div className="flex items-center gap-3 p-4 bg-sky-950/40 rounded-xl border border-sky-500/30">
                                  <div className="w-10 h-10 rounded-full bg-sky-500/20 flex items-center justify-center text-sky-400">
                                    <CloudSun className="w-5 h-5 animate-bounce" />
                                  </div>
                                  <div>
                                    <h3 className="font-bold text-sm text-sky-300">వాతావరణ రేడియో నివేదిక</h3>
                                    <p className="text-[9px] text-sky-200/70">Weather Radio Band: 162.400 MHz VHF</p>
                                  </div>
                                </div>

                                <div className="bg-slate-900/80 p-4 rounded-xl border border-slate-800 space-y-3 relative overflow-hidden">
                                  <div className="absolute top-0 right-0 p-1 px-2 text-[8px] font-bold bg-sky-500/10 border-l border-b border-sky-500/20 text-sky-400 rounded-bl-lg font-mono">
                                    OFFLINE RX LIVE
                                  </div>

                                  <div className="flex justify-between items-center">
                                    <div>
                                      <div className="text-2xl font-black font-mono text-white">32°C</div>
                                      <div className="text-[10px] text-slate-400">ప్రస్తుత ఉష్ణోగ్రత / Current Temp</div>
                                    </div>
                                    <div className="text-right">
                                      <div className="text-xs font-bold text-amber-400">పాక్షికంగా మేఘావృతం</div>
                                      <div className="text-[9px] text-slate-400">Partly Cloudy</div>
                                    </div>
                                  </div>

                                  <div className="h-1 bg-slate-800 rounded-full overflow-hidden">
                                    <div className="h-full bg-gradient-to-r from-sky-400 to-amber-400 w-2/3 animate-pulse"></div>
                                  </div>

                                  <div className="grid grid-cols-2 gap-2 text-center pt-1">
                                    <div className="bg-slate-950/50 p-2 rounded-lg border border-slate-800/60">
                                      <span className="text-[9px] text-slate-400 block">గాలి వేగం (Wind)</span>
                                      <span className="text-xs font-bold font-mono text-slate-200">14 km/h</span>
                                    </div>
                                    <div className="bg-slate-950/50 p-2 rounded-lg border border-slate-800/60">
                                      <span className="text-[9px] text-slate-400 block">తేమ శాతం (Humidity)</span>
                                      <span className="text-xs font-bold font-mono text-slate-200">62%</span>
                                    </div>
                                  </div>
                                </div>

                                <div className="space-y-2">
                                  <h4 className="text-[10px] font-bold text-sky-400 uppercase tracking-wider">స్థానిక రేడియో హెచ్చరికలు / RF Weather Alerts:</h4>
                                  
                                  <div className="bg-amber-500/10 border border-amber-500/30 p-3 rounded-xl space-y-1">
                                    <div className="flex items-center justify-between">
                                      <span className="text-[9px] font-bold text-amber-400 uppercase flex items-center gap-1">
                                        <span className="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
                                        YELLOW ALERT (పసుపు హెచ్చరిక)
                                      </span>
                                      <span className="text-[8px] text-slate-400 font-mono">11:30 AM</span>
                                    </div>
                                    <p className="text-xs text-slate-200 leading-normal">
                                      నేడు మధ్యాహ్నం 1 గంట నుండి 4 గంటల మధ్య ఎండ తీవ్రత ఎక్కువగా ఉంటుంది. వర్కర్లు నీడన విశ్రాంతి తీసుకోవాల్సిందిగా కోరుతున్నాము.
                                    </p>
                                    <p className="text-[9px] text-slate-400">
                                      High temperature forecast this afternoon. Outdoor workers are advised to rest under shade periodically and stay hydrated.
                                    </p>
                                  </div>

                                  <div className="bg-emerald-500/10 border border-emerald-500/20 p-2.5 rounded-xl text-[10px] text-emerald-400 flex items-center gap-2">
                                    <span className="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
                                    <span>వర్ష సూచన లేదు. పనులు సజావుగా సాగవచ్చు. (No immediate rain forecast. Perfect for outdoor work.)</span>
                                  </div>
                                </div>

                                <button 
                                  onClick={() => {
                                    if (typeof window !== 'undefined') {
                                      // Optional nice sound feedback or notification simulation
                                      const utterance = new SpeechSynthesisUtterance("వాతావరణ రేడియో సింక్ పూర్తయింది. వాతావరణం పాక్షికంగా మేఘావృతం.");
                                      utterance.lang = "te-IN";
                                      window.speechSynthesis?.speak(utterance);
                                    }
                                    alert("వాతావరణ సమాచారం రేడియో వేవ్స్ ద్వారా విజయవంతంగా అప్‌డేట్ చేయబడింది! / Weather synced over RF!");
                                  }}
                                  className="mt-2 w-full py-2.5 bg-gradient-to-r from-sky-600 to-sky-500 hover:from-sky-500 hover:to-sky-400 rounded-xl text-white font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-sky-500/10 transition-all active:scale-[0.98]"
                                >
                                  <RotateCcw className="w-3.5 h-3.5 animate-spin-slow" />
                                  రేడియో ద్వారా వాతావరణం అప్‌డేట్ చేయి (Sync over RF)
                                </button>
                              </div>
                            )}
                          </div>
                        )}
                      </div>
                    )}

                    {/* SCREEN 2: వర్కర్ల శోధన మరియు రేట్లు (Worker Search & Rates) */}
                    {currentScreen === 'home' && customerFlowState === 'worker_list' && selectedService && (
                      <div className="space-y-4 ">
                        <div className="flex items-center justify-between bg-[#082c75] text-white p-2.5 rounded-xl border border-white/10">
                          <button
                            onClick={() => {
                              setSelectedService(null);
                              setCustomerFlowState('home');
                            }}
                            className="text-xs font-bold text-[#FFC000] flex items-center gap-1 hover:underline"
                          >
                            ← హోమ్ (Home)
                          </button>
                          <span className="text-xs font-extrabold">{selectedService.nameTe} వర్కర్స్</span>
                          <span className="w-2" />
                        </div>

                        {/* COOLIE RATES BLUEPRINT - IMAGE 3 ALIGNMENT */}
                        <div className="bg-[#082c75] text-white p-4 rounded-2xl border-2 border-dashed border-[#FFC000] shadow-md relative overflow-hidden">
                          <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,192,0,0.05)_1px,transparent_1px)] bg-[size:12px_12px] opacity-40"></div>
                          
                          <div className="relative z-10 space-y-3">
                            <div className="flex items-center gap-2 pb-2 border-b border-white/10">
                              <span className="p-1 bg-[#FFC000] rounded text-[#082c75] text-[10px] font-black">CWRB</span>
                              <h4 className="font-extrabold text-xs text-[#FFC000] uppercase tracking-wider">కూలీ రేట్ల బ్లూప్రింట్ (Official Rates)</h4>
                            </div>

                            <div className="grid grid-cols-2 gap-2 text-[10.5px]">
                              <div className="bg-white/5 p-2 rounded-xl border border-white/5">
                                <div className="text-gray-400 font-semibold">రోజువారీ కూలీ (Daily):</div>
                                <div className="text-[#FFC000] font-black text-xs mt-0.5">₹800 - ₹1200</div>
                              </div>
                              <div className="bg-white/5 p-2 rounded-xl border border-white/5">
                                <div className="text-gray-400 font-semibold">గంటకు కూలీ (Hourly):</div>
                                <div className="text-[#FFC000] font-black text-xs mt-0.5">₹150 - ₹200</div>
                              </div>
                            </div>

                            <div className="bg-white/5 p-2 rounded-xl border border-white/5 text-[10.5px] space-y-1">
                              <div className="text-[#FFC000] font-bold">నిర్దిష్ట పనుల రేట్లు (Specific Tasks):</div>
                              <div className="flex justify-between text-gray-300">
                                <span>ప్లాస్టరింగ్ (SFTకి):</span>
                                <span className="font-bold text-white">₹15 - ₹20</span>
                              </div>
                              <div className="flex justify-between text-gray-300">
                                <span>ఇటుక పని (CFTకి):</span>
                                <span className="font-bold text-white">₹30 - ₹40</span>
                              </div>
                            </div>
                          </div>
                        </div>

                        {/* WORKER PROFILES LIST */}
                        {selectedService.id === 'abacus' ? (
                          <SecureVault />
                        ) : (
                          <div className="space-y-3">
                            <h4 className="text-xs font-extrabold text-gray-700">లభ్యత గల వర్కర్లు / Available Workers:</h4>
                            {MOCK_WORKERS.map((worker) => (
                              <div key={worker.id} className="p-3 bg-white rounded-2xl border border-gray-100 shadow-xs flex gap-3 items-center">
                                <img loading="lazy" decoding="async" src={worker.avatar} alt={worker.name} className="w-12 h-12 rounded-full object-cover border-2 border-[#082c75]/20" />
                                <div className="flex-1 min-w-0">
                                  <div className="flex justify-between items-start">
                                    <h5 className="font-black text-xs text-[#082c75]">{worker.nameTe} ({worker.name})</h5>
                                    <span className="text-[10px] font-bold text-amber-500 flex items-center gap-0.5">
                                      ★ {worker.rating}
                                    </span>
                                  </div>
                                  <p className="text-[9px] text-gray-500">{worker.experience} అనుభవం • {worker.location}</p>
                                  
                                  <div className="flex gap-1.5 mt-2">
                                    <button
                                      onClick={() => {
                                        setSelectedWorker(worker);
                                        setCustomerFlowState('worker_profile');
                                      }}
                                      className="px-2 py-1 rounded bg-[#082c75]/10 hover:bg-[#082c75]/20 text-[#082c75] text-[9px] font-bold transition"
                                    >
                                      వివరాలు / Profile
                                    </button>
                                    <button
                                      onClick={() => {
                                        setActiveCallWorker({
                                          name: worker.nameTe,
                                          type: selectedService.nameTe,
                                          phone: '+91 8466062260'
                                        });
                                      }}
                                      className="px-2 py-1 rounded bg-emerald-600 text-white text-[9px] font-bold flex items-center gap-0.5 hover:bg-emerald-700 transition"
                                    >
                                      <Phone className="w-2.5 h-2.5" />
                                      <span>కాల్ నౌ</span>
                                    </button>
                                    <button
                                      onClick={() => {
                                        setSelectedWorker(worker);
                                        setCustomerFlowState('booking');
                                      }}
                                      className="px-2 py-1 rounded bg-[#FFC000] text-[#082c75] text-[9px] font-black hover:bg-amber-400 transition"
                                    >
                                      బుక్ నా
                                    </button>
                                  </div>
                                </div>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    )}

                    {/* SCREEN 3: వర్కర్ వివరాల ప్రొఫైల్ (Worker Details) */}
                    {currentScreen === 'home' && customerFlowState === 'worker_profile' && selectedWorker && (
                      <div className="space-y-4 ">
                        <div className="flex items-center justify-between bg-[#082c75] text-white p-2.5 rounded-xl">
                          <button
                            onClick={() => setCustomerFlowState('worker_list')}
                            className="text-xs font-bold text-[#FFC000] flex items-center gap-1 hover:underline"
                          >
                            ← బ్యాక్ (Back)
                          </button>
                          <span className="text-xs font-extrabold">వర్కర్ వివరాలు</span>
                          <span className="w-2" />
                        </div>

                        <div className="bg-white p-4 rounded-2xl border border-gray-100 shadow-xs space-y-4">
                          <div className="flex gap-3 items-center">
                            <img loading="lazy" decoding="async" src={selectedWorker.avatar} alt={selectedWorker.name} className="w-14 h-14 rounded-full object-cover border-2 border-[#082c75]" />
                            <div>
                              <h4 className="font-black text-sm text-[#082c75]">{selectedWorker.nameTe}</h4>
                              <p className="text-[10px] text-gray-500">{selectedWorker.experience} అనుభవం • {selectedWorker.location}</p>
                              <div className="flex items-center gap-1.5 mt-0.5 text-xs">
                                <span className="text-amber-500 font-bold">★ {selectedWorker.rating}</span>
                                <span className="bg-emerald-100 text-emerald-800 text-[8px] font-bold px-1.5 py-0.5 rounded-full">KYC వెరిఫైడ్</span>
                              </div>
                            </div>
                          </div>

                          <div className="space-y-1">
                            <h5 className="text-[10.5px] font-extrabold text-gray-700">పరిచయం / Biography:</h5>
                            <p className="text-[10px] text-gray-600 leading-relaxed">{selectedWorker.bio}</p>
                          </div>

                          {/* WORK PORTFOLIO IMAGES */}
                          <div className="space-y-1.5">
                            <h5 className="text-[10.5px] font-extrabold text-gray-700">పనుల గ్యాలరీ / Work Portfolio:</h5>
                            <div className="grid grid-cols-3 gap-2">
                              {selectedWorker.portfolio.map((img, i) => (
                                <img loading="lazy" decoding="async" key={i} src={img} alt="portfolio" className="w-full h-16 rounded-lg object-cover border border-gray-100 hover:scale-105 transition" />
                              ))}
                            </div>
                          </div>

                          {/* CUSTOMER REVIEWS */}
                          <div className="space-y-1.5">
                            <h5 className="text-[10.5px] font-extrabold text-gray-700">సమీక్షలు / Customer Reviews:</h5>
                            <div className="space-y-1.5">
                              {selectedWorker.reviews.map((rev, i) => (
                                <div key={i} className="p-2 bg-slate-50 rounded-xl text-[9px] space-y-0.5">
                                  <div className="flex justify-between text-gray-700 font-bold">
                                    <span>{rev.author}</span>
                                    <span className="text-amber-500">★ {rev.stars}</span>
                                  </div>
                                  <p className="text-gray-500">{rev.text}</p>
                                </div>
                              ))}
                            </div>
                          </div>

                          <div className="grid grid-cols-2 gap-3 pt-2 border-t border-gray-100">
                            <button
                              onClick={() => {
                                setActiveCallWorker({
                                  name: selectedWorker.nameTe,
                                  type: selectedService?.nameTe || 'వర్కర్',
                                  phone: '+91 8466062260'
                                });
                              }}
                              className="w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold rounded-xl text-xs flex items-center justify-center gap-1 transition"
                            >
                              <Phone className="w-3.5 h-3.5" />
                              <span>కాల్ నా</span>
                            </button>
                            <button
                              onClick={() => setCustomerFlowState('booking')}
                              className="w-full py-2 bg-[#FFC000] hover:bg-amber-400 text-[#082c75] font-black rounded-xl text-xs transition"
                            >
                              బుక్ నా
                            </button>
                          </div>
                        </div>
                      </div>
                    )}

                    {/* SCREEN 4: పని బుకింగ్ (Task Booking / Calendar) */}
                    {currentScreen === 'home' && customerFlowState === 'booking' && selectedWorker && selectedService && (
                      <div className="space-y-4 ">
                        <div className="flex items-center justify-between bg-[#082c75] text-white p-2.5 rounded-xl">
                          <button
                            onClick={() => setCustomerFlowState('worker_profile')}
                            className="text-xs font-bold text-[#FFC000] flex items-center gap-1 hover:underline"
                          >
                            ← వెనుకకు (Back)
                          </button>
                          <span className="text-xs font-extrabold">పని బుకింగ్ / Task Booking</span>
                          <span className="w-2" />
                        </div>

                        <form
                          onSubmit={(e) => {
                            e.preventDefault();
                            const formData = new FormData(e.currentTarget);
                            const desc = formData.get('description') as string;
                            const urgency = formData.get('urgency') === 'on';
                            const date = formData.get('date') as string;
                            const slot = formData.get('slot') as 'morning' | 'afternoon';
                            
                            setSimulatedBooking({
                              service: selectedService,
                              date: date || '2026-07-20',
                              time: slot === 'morning' ? 'ఉదయం / Morning' : 'మధ్యాహ్నం / Afternoon',
                              desc: desc || 'ప్లాస్టరింగ్ పనులు',
                              urgency
                            });
                            
                            // Book real backend / lead assignment
                            handleBooking({
                              id: 'sim_b_' + Date.now(),
                              serviceId: selectedService.id,
                              serviceName: selectedService.nameTe,
                              date: date || '2026-07-20',
                              slot: slot || 'morning',
                              status: 'confirmed',
                              customerName: selectedWorker.nameTe,
                              customerPhone: '+91 8466062260'
                            });

                            setCustomerFlowState('tracking');
                          }}
                          className="bg-white p-4 rounded-2xl border border-gray-100 shadow-xs space-y-4 text-xs"
                        >
                          <div>
                            <label className="block text-gray-500 font-bold mb-1">ఎంచుకున్న వర్కర్:</label>
                            <div className="bg-slate-50 p-2 rounded-lg font-black text-[#082c75]">
                              {selectedWorker.nameTe} ({selectedService.nameTe})
                            </div>
                          </div>

                          <div>
                            <label className="block text-gray-500 font-bold mb-1">పని ప్రారంభ తేదీ (Date of work):</label>
                            <input type="date" required name="date" defaultValue="2026-07-20" className="w-full p-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#082c75]" />
                          </div>

                          <div>
                            <label className="block text-gray-500 font-bold mb-1">సమయ స్లాట్ (Time Slot):</label>
                            <select name="slot" className="w-full p-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#082c75]">
                              <option value="morning">ఉదయం (09:00 AM - 12:00 PM)</option>
                              <option value="afternoon">మధ్యాహ్నం (02:00 PM - 05:00 PM)</option>
                            </select>
                          </div>

                          <div>
                            <label className="block text-gray-500 font-bold mb-1">పని వివరణ (Task Description):</label>
                            <textarea name="description" placeholder="చేయించాల్సిన పని వివరాలు ఇక్కడ రాయండి..." rows={3} className="w-full p-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#082c75]"></textarea>
                          </div>

                          <div className="flex items-center gap-2">
                            <input type="checkbox" name="urgency" id="urgency" className="w-4 h-4 rounded text-[#082c75] focus:ring-[#082c75]" />
                            <label htmlFor="urgency" className="font-extrabold text-rose-600">మానవతాత్వర ఉంది (Urgent Work needed)</label>
                          </div>

                          <button
                            type="submit"
                            className="w-full py-2.5 bg-[#FFC000] hover:bg-amber-400 text-[#082c75] font-black rounded-xl text-xs text-center transition shadow-md"
                          >
                            పని ఆర్డర్ పంపించండి / Send Work Order
                          </button>
                        </form>
                      </div>
                    )}

                    {/* SCREEN 5: పని ట్రాకింగ్ మరియు స్థితి (Task Tracking & Status) */}
                    {currentScreen === 'home' && customerFlowState === 'tracking' && simulatedBooking && selectedWorker && (
                      <div className="space-y-4  -mx-4 -mt-5">
                        <div className="bg-[#082c75] p-4 pb-6 shadow-md rounded-b-3xl mb-4">
                          <div className="flex items-center gap-3">
                            <button
                              onClick={() => setCustomerFlowState('home')}
                              className="p-1.5 bg-white/10 rounded-full border border-white/20 text-white"
                            >
                              <ChevronLeft className="w-5 h-5" />
                            </button>
                            <h2 className="text-white font-black text-lg">ట్రాకింగ్ (Task Tracker)</h2>
                          </div>
                        </div>

                        <div className="bg-white p-4 rounded-2xl border border-gray-100 shadow-xs space-y-4 text-xs">
                          <div className="bg-blue-50 border border-blue-100 p-3 rounded-xl flex items-center justify-between">
                            <div>
                              <div className="font-bold text-[#082c75]">వర్కర్ స్థితి: మార్గంలో ఉన్నారు</div>
                              <div className="text-[10px] text-gray-500 mt-0.5">మొబైల్ నంబర్: +91 8466062260</div>
                            </div>
                            <span className="w-2.5 h-2.5 bg-blue-500 rounded-full animate-ping block"></span>
                          </div>

                          {/* SIMULATED LIVE ROUTE MAP */}
                          <div className="h-28 bg-slate-100 rounded-xl relative overflow-hidden border border-gray-200">
                            <div className="absolute inset-0 bg-cover bg-center opacity-30" style={{ backgroundImage: "url('https://images.unsplash.com/photo-1524661135-423995f22d0b?w=400&q=80')" }}></div>
                            <div className="absolute top-2 left-2 bg-white/90 p-1 rounded font-bold text-[8px] border border-gray-200">లైవ్ జిపిఎస్ మ్యాప్ / Live GPS</div>
                            
                            {/* Route Line Drawing */}
                            <svg className="absolute inset-0 w-full h-full">
                              <path d="M 40 80 Q 150 20, 250 80 T 360 40" fill="none" stroke="#082c75" strokeWidth="3" strokeDasharray="5" className="animate-[dash_2s_linear_infinite]" />
                            </svg>
                            
                            {/* Worker Marker */}
                            <div className="absolute left-[200px] top-[40px] -translate-x-1/2 -translate-y-1/2 flex flex-col items-center">
                              <div className="bg-[#082c75] text-[#FFC000] p-1 rounded-lg border border-[#FFC000] text-[8px] font-bold flex items-center gap-1 shadow-md">
                                <span className="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse block"></span>
                                <span>{selectedWorker.name}</span>
                              </div>
                              <div className="w-2.5 h-2.5 bg-[#082c75] rounded-full border-2 border-white mt-1 shadow-xs"></div>
                            </div>

                            {/* Home Destination Marker */}
                            <div className="absolute right-[40px] top-[40px] -translate-x-1/2 -translate-y-1/2 flex flex-col items-center">
                              <div className="bg-rose-600 text-white px-1 rounded text-[8px] font-bold shadow">మీ ఇల్లు</div>
                              <div className="w-3 h-3 bg-rose-600 rounded-full border-2 border-white mt-1 shadow-xs"></div>
                            </div>
                          </div>

                          {/* CHECKLIST TRACKER */}
                          <div className="space-y-2 border-t border-gray-100 pt-3">
                            <h5 className="font-extrabold text-gray-700">పని పురోగతి తనిఖీ జాబితా / Progress Checklist:</h5>
                            <div className="space-y-1.5">
                              <div className="flex items-center gap-2 text-emerald-700 font-bold">
                                <span className="bg-emerald-100 p-0.5 rounded-full">✓</span>
                                <span>పని ప్రారంభమైంది (Work Started)</span>
                              </div>
                              <div className="flex items-center gap-2 text-emerald-700 font-bold">
                                <span className="bg-emerald-100 p-0.5 rounded-full">✓</span>
                                <span>ప్లాస్టరింగ్ జరుగుతోంది (Plastering In Progress)</span>
                              </div>
                              <div className="flex items-center gap-2 text-gray-400">
                                <span className="border border-gray-300 w-4 h-4 rounded-full flex items-center justify-center text-[10px]">●</span>
                                <span>టైలింగ్ అడుగుతోంది (Tiling Update Pending)</span>
                              </div>
                            </div>
                          </div>

                          <button
                            onClick={() => setCustomerFlowState('payment_review')}
                            className="w-full py-2 bg-[#082c75] text-[#FFC000] font-bold rounded-xl text-center text-xs hover:bg-[#001040] transition shadow-xs mt-2"
                          >
                            చెల్లింపు మరియు సమీక్షకు వెళ్ళండి / Go to Pay & Review
                          </button>
                        </div>
                      </div>
                    )}

                    {/* SCREEN 6: చెల్లింపు మరియు సమీక్ష (Payment and feedback review) */}
                    {currentScreen === 'home' && customerFlowState === 'payment_review' && selectedWorker && (
                      <div className="space-y-4  -mx-4 -mt-5">
                        <div className="bg-[#082c75] p-4 pb-6 shadow-md rounded-b-3xl mb-4">
                          <div className="flex items-center gap-3">
                            <button
                              onClick={() => setCustomerFlowState('home')}
                              className="p-1.5 bg-white/10 rounded-full border border-white/20 text-white"
                            >
                              <ChevronLeft className="w-5 h-5" />
