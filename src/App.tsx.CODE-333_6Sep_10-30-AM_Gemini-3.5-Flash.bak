// Category icon map helper
const getCategoryIcon = (iconName: string) => {
  if (iconName && (iconName.match(/[\uD800-\uDFFF\u2600-\u27BF]/) || iconName.length <= 2)) {
    return <span className="text-[20px] sm:text-[22px] filter drop-shadow-[0_4px_5px_rgba(0,0,0,0.3)] transform hover:scale-110 transition-transform duration-200 inline-block select-none leading-none">{iconName}</span>;
  }
  switch (iconName) {
    case 'Zap': return <ZapIcon className="w-5 h-5 text-[#FFC000]" />;
    case 'Pipette': return <WrenchIcon className="w-5 h-5 text-[#FFC000]" />;
    case 'Hammer': return <HammerIcon className="w-5 h-5 text-[#FFC000]" />;
    case 'Paintbrush': return <PaintbrushIcon className="w-5 h-5 text-[#FFC000]" />;
    case 'Wrench': return <WrenchIcon className="w-5 h-5 text-[#FFC000]" />;
    case 'Flame': return <FlameIcon className="w-5 h-5 text-[#FFC000]" />;
    case 'Grid': return <GridIcon className="w-5 h-5 text-[#FFC000]" />;
    case 'Layers': return <LayersIcon className="w-5 h-5 text-[#FFC000]" />;
    case 'RefreshCw': return <RefreshCwIcon className="w-5 h-5 text-[#FFC000]" />;
    case 'Construction': return <ConstructionIcon className="w-5 h-5 text-[#FFC000]" />;
    default: return <WrenchIcon className="w-5 h-5 text-[#FFC000]" />;
  }
};

