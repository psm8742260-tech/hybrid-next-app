                              setFeedbackComment('');
                              setStarRating(5);
                              setCustomerFlowState('home');
                              setSelectedService(null);
                              setSelectedWorker(null);
                              setSimulatedBooking(null);
                            }}
                            className="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold rounded-xl text-center text-xs transition shadow-xs"
                          >
                            సమర్పించండి & ముగించండి / Submit Review
                          </button>
                        </div>
                      </div>
                    )}

                    {/* Active bookings with Call & Feedback options (Regular) */}
                    {customerFlowState === 'home' && bookings.length > 0 && (
                      <div className="space-y-2">
                        <h3 className="font-bold text-xs text-[#082c75] uppercase tracking-wide">నా బుకింగ్స్ / Your Bookings</h3>
                        
                        <div className="space-y-2">
                          {bookings.map((b) => (
                            <div key={b.id} className="p-3 bg-white rounded-xl border border-gray-100 space-y-2 shadow-xs">
                              <div className="flex justify-between items-center text-xs">
                                <span className="font-bold text-gray-800">{b.serviceName}</span>
                                <span className="bg-emerald-100 text-emerald-800 px-1.5 py-0.5 rounded text-[9px] font-bold">
                                  కన్ఫర్మ్ అయింది
                                </span>
                              </div>
                              <div className="text-[10px] text-gray-500 font-mono">
                                తేదీ: {b.date} • స్లాట్: {b.slot === 'morning' ? 'ఉదయం' : 'మధ్యాహ్నం'}
                              </div>

                              <div className="flex gap-2 pt-1">
                                {/* FEATURE 6: Direct Intent Phone call */}
                                {featureStates['feat_calling'] !== 'soft_delete' && featureStates['feat_calling'] !== 'hard_delete' && (
                                  <button
                                    onClick={() => {
                                      if (featureStates['feat_calling'] === 'temp_off' || featureStates['feat_calling'] === 'perm_off') {
                                        alert('Calling is disabled by Admin.');
                                        return;
                                      }
                                      setActiveCallWorker({
                                        name: b.customerName,
                                        type: b.serviceName,
                                        phone: b.customerPhone
                                      });
                                    }}
                                    className={`flex-1 py-1 px-2.5 rounded bg-[#082c75] text-[#FFC000] text-[10px] font-bold flex items-center justify-center gap-1 active:scale-95 ${
                                      featureStates['feat_calling'] === 'temp_off' || featureStates['feat_calling'] === 'perm_off' ? 'opacity-40 cursor-not-allowed' : ''
                                    }`}
                                  >
                                    <Phone className="w-3 h-3" />
                                    <span>ఉచిత కాల్ / Direct Call</span>
                                  </button>
                                )}

                                {/* FEATURE 10: Ratings Widget Trigger */}
                                {featureStates['feat_ratings'] !== 'soft_delete' && featureStates['feat_ratings'] !== 'hard_delete' && (
                                  <button
                                    onClick={() => {
                                      if (featureStates['feat_ratings'] === 'temp_off' || featureStates['feat_ratings'] === 'perm_off') {
                                        alert('Ratings are disabled by Admin.');
                                        return;
                                      }
                                      setActiveRatingBooking(b);
                                      setStarRating(5);
                                      setFeedbackComment('');
                                    }}
                                    className={`flex-1 py-1 px-2.5 rounded border border-[#082c75] text-[#082c75] text-[10px] font-bold flex items-center justify-center gap-1 hover:bg-[#082c75]/5 active:scale-95 ${
                                      featureStates['feat_ratings'] === 'temp_off' || featureStates['feat_ratings'] === 'perm_off' ? 'opacity-40 cursor-not-allowed' : ''
                                    }`}
                                  >
                                    <Star className="w-3 h-3 fill-current" />
                                    <span>రేటింగ్ / Review</span>
                                  </button>
                                )}
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* FEATURE: Chat Assistant */}
                    {currentScreen === 'chat' && (
