                    {/* FEATURE: Social Hub Sharing & Community Feed */}
                    {currentScreen === 'community' && (
                      <SocialHub 
                        controlState={featureStates['feat_social']} 
                        userPhone={userPhone || ''} 
                      />
                    )}

                    {/* FEATURE: Entertainment & Media Hub */}
                    {currentScreen === 'entertainment' && (
                      <EntertainmentHub 
                        controlState={featureStates['feat_social']} 
                      />
                    )}

                    {/* FEATURE: Secure Vault */}
                    {currentScreen === 'vault' && (
                      <SecureVault />
                    )}

                    {/* FEATURE 5: Dynamic KM Geofencing Map */}
                    {currentScreen === 'map' && (
                      <GeofenceMap 
                        radiusKm={geofenceRadius} 
                        onRadiusChange={setGeofenceRadius} 
                        controlState={featureStates['feat_geofencing']} 
                      />
                    )}



                  </div>
                )}

              </div>

              {/* Customer Bottom Navigation Bar */}
              {activeTab === 'customer' && (
                <div className="border-t border-gray-200 bg-white grid grid-cols-7 py-2 px-1 select-none shrink-0 z-30 shadow-[0_-4px_10px_rgba(0,0,0,0.03)]">
                  <button 
                    onClick={() => { setCurrentScreen('home'); setCustomerFlowState('home'); }} 
                    className="flex flex-col items-center justify-center py-0.5 transition-all active:scale-95"
                  >
                    <div className={`relative w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 ${
                      currentScreen === 'home' 
                        ? 'bg-gradient-to-tr from-amber-600 via-amber-400 to-yellow-300 text-white shadow-[inset_0_2px_4px_rgba(255,255,255,0.85),_0_4px_8px_rgba(217,119,6,0.4),_0_1px_2px_rgba(0,0,0,0.15)] border-b-2 border-amber-700 scale-110 -translate-y-1.5' 
                        : 'bg-gradient-to-tr from-slate-100 to-white text-gray-400 shadow-[inset_0_1.5px_2px_rgba(255,255,255,1),_0_1px_2px_rgba(0,0,0,0.05)] border border-slate-200'
                    }`}>
                      {currentScreen === 'home' && (
                        <div className="absolute top-0.5 left-1 w-2.5 h-1.5 rounded-full bg-white/40 blur-[0.3px]" />
                      )}
                      <Grid className={`w-4.5 h-4.5 ${currentScreen === 'home' ? 'drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] text-white' : 'text-gray-500'}`} />
                    </div>
                    <span className={`text-[8px] mt-1 tracking-tight transition-all ${currentScreen === 'home' ? 'text-[#082c75] font-black' : 'text-gray-400 font-bold'}`}>వృత్తులు</span>
                  </button>
                  <button 
                    onClick={() => setCurrentScreen('map')} 
                    className="flex flex-col items-center justify-center py-0.5 transition-all active:scale-95"
                  >
                    <div className={`relative w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 ${
                      currentScreen === 'map' 
                        ? 'bg-gradient-to-tr from-emerald-600 via-emerald-400 to-teal-300 text-white shadow-[inset_0_2px_4px_rgba(255,255,255,0.85),_0_4px_8px_rgba(5,150,105,0.4),_0_1px_2px_rgba(0,0,0,0.15)] border-b-2 border-emerald-700 scale-110 -translate-y-1.5' 
                        : 'bg-gradient-to-tr from-slate-100 to-white text-gray-400 shadow-[inset_0_1.5px_2px_rgba(255,255,255,1),_0_1px_2px_rgba(0,0,0,0.05)] border border-slate-200'
                    }`}>
                      {currentScreen === 'map' && (
                        <div className="absolute top-0.5 left-1 w-2.5 h-1.5 rounded-full bg-white/40 blur-[0.3px]" />
                      )}
                      <MapPin className={`w-4.5 h-4.5 ${currentScreen === 'map' ? 'drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] text-white' : 'text-gray-500'}`} />
                    </div>
                    <span className={`text-[8px] mt-1 tracking-tight transition-all ${currentScreen === 'map' ? 'text-[#082c75] font-black' : 'text-gray-400 font-bold'}`}>మ్యాప్</span>
                  </button>
                  <button 
                    onClick={() => setCurrentScreen('community')} 
                    className="flex flex-col items-center justify-center py-0.5 transition-all active:scale-95"
                  >
                    <div className={`relative w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 ${
                      currentScreen === 'community' 
                        ? 'bg-gradient-to-tr from-blue-600 via-blue-400 to-sky-300 text-white shadow-[inset_0_2px_4px_rgba(255,255,255,0.85),_0_4px_8px_rgba(37,99,235,0.4),_0_1px_2px_rgba(0,0,0,0.15)] border-b-2 border-blue-700 scale-110 -translate-y-1.5' 
                        : 'bg-gradient-to-tr from-slate-100 to-white text-gray-400 shadow-[inset_0_1.5px_2px_rgba(255,255,255,1),_0_1px_2px_rgba(0,0,0,0.05)] border border-slate-200'
                    }`}>
                      {currentScreen === 'community' && (
                        <div className="absolute top-0.5 left-1 w-2.5 h-1.5 rounded-full bg-white/40 blur-[0.3px]" />
                      )}
                      <Users className={`w-4.5 h-4.5 ${currentScreen === 'community' ? 'drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] text-white' : 'text-gray-500'}`} />
                    </div>
                    <span className={`text-[8px] mt-1 tracking-tight transition-all ${currentScreen === 'community' ? 'text-[#082c75] font-black' : 'text-gray-400 font-bold'}`}>కమ్యూనిటీ</span>
                  </button>
                  <button 
                    onClick={() => setCurrentScreen('entertainment')} 
                    className="flex flex-col items-center justify-center py-0.5 transition-all active:scale-95"
                  >
                    <div className={`relative w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 ${
                      currentScreen === 'entertainment' 
                        ? 'bg-gradient-to-tr from-pink-600 via-pink-400 to-indigo-400 text-white shadow-[inset_0_2px_4px_rgba(255,255,255,0.85),_0_4px_8px_rgba(219,39,119,0.4),_0_1px_2px_rgba(0,0,0,0.15)] border-b-2 border-pink-700 scale-110 -translate-y-1.5' 
                        : 'bg-gradient-to-tr from-slate-100 to-white text-gray-400 shadow-[inset_0_1.5px_2px_rgba(255,255,255,1),_0_1px_2px_rgba(0,0,0,0.05)] border border-slate-200'
                    }`}>
                      {currentScreen === 'entertainment' && (
                        <div className="absolute top-0.5 left-1 w-2.5 h-1.5 rounded-full bg-white/40 blur-[0.3px]" />
                      )}
                      <Music className={`w-4.5 h-4.5 ${currentScreen === 'entertainment' ? 'drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] text-white' : 'text-gray-500'}`} />
                    </div>
                    <span className={`text-[8px] mt-1 tracking-tight transition-all ${currentScreen === 'entertainment' ? 'text-[#082c75] font-black' : 'text-gray-400 font-bold'}`}>వినోదం</span>
                  </button>
                  <button 
                    onClick={() => setCurrentScreen('vault')} 
                    className="flex flex-col items-center justify-center py-0.5 transition-all active:scale-95"
                  >
                    <div className={`relative w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 ${
                      currentScreen === 'vault' 
                        ? 'bg-gradient-to-tr from-rose-600 via-orange-500 to-amber-400 text-white shadow-[inset_0_2px_4px_rgba(255,255,255,0.85),_0_4px_8px_rgba(225,29,72,0.4),_0_1px_2px_rgba(0,0,0,0.15)] border-b-2 border-rose-700 scale-110 -translate-y-1.5' 
                        : 'bg-gradient-to-tr from-slate-100 to-white text-gray-400 shadow-[inset_0_1.5px_2px_rgba(255,255,255,1),_0_1px_2px_rgba(0,0,0,0.05)] border border-slate-200'
                    }`}>
                      {currentScreen === 'vault' && (
                        <div className="absolute top-0.5 left-1 w-2.5 h-1.5 rounded-full bg-white/40 blur-[0.3px]" />
                      )}
                      <Lock className={`w-4.5 h-4.5 ${currentScreen === 'vault' ? 'drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] text-white' : 'text-gray-500'}`} />
                    </div>
                    <span className={`text-[8px] mt-1 tracking-tight transition-all ${currentScreen === 'vault' ? 'text-[#082c75] font-black' : 'text-gray-400 font-bold'}`}>వాల్ట్</span>
                  </button>
                  {/* APK PWA Mobile Bottom Bar Admin Button */}
                  {isLoggedIn && (
                    <button 
                      onClick={() => {
                        if (soundOn) {
                          try {
                            const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
                            const osc = audioCtx.createOscillator();
                            const gain = audioCtx.createGain();
                            osc.connect(gain);
                            gain.connect(audioCtx.destination);
                            osc.frequency.setValueAtTime(523.25, audioCtx.currentTime);
                            gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                            osc.start();
                            osc.stop(audioCtx.currentTime + 0.1);
                          } catch (e) {}
                        }
                        setShowAdminModal(true);
                      }} 
                      className="flex flex-col items-center justify-center py-0.5 transition-all active:scale-95"
                      title="సెట్టింగ్స్ / Settings"
                    >
                      <div className={`relative w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 ${
                        showMobileSettings 
                          ? 'bg-gradient-to-tr from-indigo-600 via-indigo-400 to-purple-300 text-white shadow-[inset_0_2px_4px_rgba(255,255,255,0.85),_0_4px_8px_rgba(79,70,229,0.4),_0_1px_2px_rgba(0,0,0,0.15)] border-b-2 border-indigo-700 scale-110 -translate-y-1.5' 
                          : 'bg-gradient-to-tr from-slate-100 to-white text-gray-400 shadow-[inset_0_1.5px_2px_rgba(255,255,255,1),_0_1px_2px_rgba(0,0,0,0.05)] border border-slate-200'
                      }`}>
                        {showMobileSettings && (
                          <div className="absolute top-0.5 left-1 w-2.5 h-1.5 rounded-full bg-white/40 blur-[0.3px]" />
                        )}
                        <Settings className={`w-4.5 h-4.5 ${showMobileSettings ? 'drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] text-white animate-spin' : 'text-gray-500'}`} style={showMobileSettings ? { animationDuration: '6s' } : undefined} />
                      </div>
                      <span className={`text-[8px] mt-1 tracking-tight transition-all ${showMobileSettings ? 'text-[#082c75] font-black' : 'text-gray-400 font-bold'}`}>సెట్టింగ్స్</span>
                    </button>
                  )}
                  <button 
                    onClick={() => {
                      if (soundOn) {
                        try {
                          const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
                          const osc = audioCtx.createOscillator();
                          const gain = audioCtx.createGain();
                          osc.connect(gain);
                          gain.connect(audioCtx.destination);
                          osc.frequency.setValueAtTime(440, audioCtx.currentTime);
                          gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                          osc.start();
                          osc.stop(audioCtx.currentTime + 0.1);
                        } catch (e) {}
                      }
                      setAppClosed(true);
                    }}
                    className="flex flex-col items-center justify-center py-0.5 transition-all active:scale-95"
                    title="యాప్ మూసివేయండి / Close App"
                  >
                    <div className="relative w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 bg-gradient-to-tr from-rose-600 via-rose-500 to-red-400 text-white shadow-[inset_0_2px_4px_rgba(255,255,255,0.85),_0_4px_8px_rgba(225,29,72,0.4),_0_1px_2px_rgba(0,0,0,0.15)] border-b-2 border-rose-700 scale-100 hover:scale-110">
                      <LogOut className="w-4.5 h-4.5 text-white drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)]" />
                    </div>
                    <span className="text-[8px] mt-1 tracking-tight text-rose-600 font-bold">మూసివేయి</span>
                  </button>
                </div>
              )}

                
                {/* VENDOR PANEL SCREEN VIEW */}
                {activeTab === 'provider' && (
                  <div className="flex-1 overflow-y-auto space-y-5">
                    <EcommerceVendorDashboard />
                  </div>
                )}

                {/* CIVIL WORKER PANEL SCREEN VIEW */}
                {activeTab === 'worker' && (
                  <>
                    {/* Worker Content Area with its own smooth scroll and swipe capability */}
                    <div className={`p-4 space-y-5 w-full ${isStandaloneOrMobile ? 'flex-1 max-h-none' : 'flex-1 overflow-y-auto max-h-[500px]'}`}>
                      
                      {currentWorkerScreen === 'dashboard' && (
                        <div className="space-y-5  relative">
                          
                          {/* Profile Page Header with Hamburger icon */}
                          <div className="flex justify-between items-center bg-white p-3 rounded-2xl border border-gray-100 shadow-xs">
                            <div className="flex items-center gap-2">
                              <div className="w-8 h-8 rounded-full bg-[#082c75]/10 flex items-center justify-center text-[#082c75] font-black text-xs">
                                👤
                              </div>
                              <div>
                                <h3 className="font-extrabold text-xs text-[#082c75]">వర్కర్ ప్రొఫైల్ వివరాలు</h3>
                                <p className="text-[9px] text-gray-500 font-medium">Worker Profile Dashboard</p>
                              </div>
                            </div>
                            
                            {/* Hamburger Button (only shown if feature is not disabled/deleted by admin) */}
                            {featureStates['feat_profile_menu'] !== 'soft_delete' && featureStates['feat_profile_menu'] !== 'hard_delete' && (
                              <button
                                onClick={() => {
                                  if (featureStates['feat_profile_menu'] === 'temp_off' || featureStates['feat_profile_menu'] === 'perm_off') {
                                    alert("ప్రొఫైల్ మెనూ అందుబాటులో లేదు. అడ్మిన్ ద్వారా నిలిపివేయబడింది. (Profile Menu Suspended by Admin)");
                                    return;
                                  }
                                  setShowProfileMenu(true);
                                }}
                                className="p-2 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-700 hover:text-[#082c75] border border-gray-100 transition duration-200 active:scale-95"
                                title="ప్రొఫైల్ మెనూ / Profile Menu"
                              >
                                <Menu className="w-5 h-5" />
                              </button>
                            )}
                          </div>
                          {/* Worker Welcome Banner */}
                          <div className="bg-gradient-to-r from-blue-50 to-indigo-50 p-3.5 rounded-2xl border border-blue-100/60 text-xs flex flex-col items-start gap-2.5 shadow-xs w-full">
                            <div className="space-y-0.5">
                              <div className="font-extrabold text-[#082c75] flex items-center gap-1.5">
                                <span>వర్కర్ డ్యాష్‌బోర్డ్ / Worker Panel!</span>
                                <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
                              </div>
                              <div className="text-[10px] text-gray-600 font-medium leading-relaxed">
                                మీ హాజరును ఆన్ చేసుకోండి, క్వాలిటీ స్కోర్ ని పరిశీలించండి. యాప్ స్క్రీన్ల వివరణను గైడ్ లో చూడండి.
                              </div>
                            </div>
                            <div className="w-full flex flex-col gap-2">
                              <button
                                onClick={() => setShowAppWalkthrough(true)}
                                className="w-full bg-amber-400 hover:bg-amber-300 text-slate-900 font-extrabold text-[10px] py-2.5 rounded-xl border border-amber-300 transition active:scale-95 flex items-center justify-center gap-1.5 shadow-xs cursor-pointer"
                              >
                                📖 యాప్ గైడ్ / Guide
                              </button>

                              <div className="grid grid-cols-2 gap-2 w-full">
                                <a
                                  href={`tel:${customerCarePhone}`}
                                  onClick={handleCustomerCareClick}
                                  className="bg-[#082c75] hover:bg-opacity-90 text-white font-extrabold text-[9px] sm:text-[10px] py-2.5 rounded-xl border border-blue-900/30 transition active:scale-95 flex items-center justify-center gap-1.5 shadow-xs cursor-pointer text-center"
                                  title="కస్టమర్ కేర్ కాల్ / Call Support"
                                >
                                  <Phone className="w-3.5 h-3.5 text-[#FFC000]" />
                                  <span>కస్టమర్ కేర్ / Care</span>
                                </a>
                                <a
                                  href={feedbackGoogleForm || "#"}
                                  target={feedbackGoogleForm ? "_blank" : undefined}
                                  rel="noopener noreferrer"
                                  onClick={(e) => {
                                    if (!feedbackGoogleForm) {
                                      e.preventDefault();
                                      alert("ఫీడ్‌బ్యాక్ ఫారం లింక్ ఇంకా సెట్ చేయబడలేదు. అడ్మిన్ మాస్టర్ కంట్రోల్ ప్యానెల్‌లో సెట్ చేసుకోండి!");
                                    }
                                  }}
                                  className="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-[9px] sm:text-[10px] py-2.5 rounded-xl border border-emerald-500/30 transition active:scale-95 flex items-center justify-center gap-1.5 shadow-xs cursor-pointer text-center"
                                  title="గూగుల్ ఫామ్ ఫీడ్‌బ్యాక్ / Give Feedback"
                                >
                                  <MessageSquare className="w-3.5 h-3.5 text-white" />
                                  <span>ఫీడ్బ్యాక్ / Feedback</span>
                                </a>
                              </div>
                            </div>
                          </div>

                          {/* FEATURE 2: Worker Attendance Switch (ON/OFF circular button) */}
                          {featureStates['feat_attendance'] !== 'soft_delete' && featureStates['feat_attendance'] !== 'hard_delete' && (
                            <div className={`p-4 rounded-2xl flex items-center justify-between shadow-xs transition-all ${
                              attendanceOn ? 'bg-emerald-50 border border-emerald-200' : 'bg-gray-50 border border-gray-200'
                            }`}>
                              <div>
                                <div className="font-bold text-xs text-gray-800">పనికి హాజరు / Attendance Register</div>
                                <div className="text-[10px] text-gray-500 mt-0.5">
                                  {attendanceOn ? 'హాజరయ్యారు (ఆన్) / Active Online' : 'సెలవులో ఉన్నారు (ఆఫ్) / Offline'}
                                </div>
                              </div>

                              {featureStates['feat_attendance'] === 'temp_off' || featureStates['feat_attendance'] === 'perm_off' ? (
                                <span className="text-[9px] font-bold text-red-500">ATTENDANCE OFF BY ADMIN</span>
                              ) : (
                                <button
                                  onClick={() => setAttendanceOn(!attendanceOn)}
                                  className={`w-14 h-7 rounded-full p-0.5 transition-all duration-300 ${
                                    attendanceOn ? 'bg-emerald-500' : 'bg-gray-300'
                                  }`}
                                >
                                  <div className={`w-6 h-6 rounded-full bg-white shadow-md transform transition-all duration-300 flex items-center justify-center text-[8px] font-bold ${
                                    attendanceOn ? 'translate-x-7 text-emerald-600' : 'translate-x-0 text-gray-400'
                                  }`}>
                                    {attendanceOn ? 'ON' : 'OFF'}
                                  </div>
                                </button>
                              )}
                            </div>
                          )}

                          {/* WORKER QUALITY SCORE CARD */}
                          {(() => {
                            // Calculate dynamic score
                            let score = 0;
                            if (kycState.verified) {
                              score += 40;
                            } else {
                              if (kycState.aadhaarUploaded) score += 15;
                              if (kycState.panUploaded) score += 15;
                            }
                            if (attendanceOn) {
                              score += 20;
                            }
                            score += Math.min(20, diaryEntries.length * 5);
                            score += Math.min(20, Math.floor(walletBalance / 50));

                            let badgeName = "🥉 కంచు స్థాయి వర్కర్ (Bronze)";
                            let badgeColor = "from-amber-600/20 to-amber-700/10 text-amber-900 border-amber-300";
                            let progressColor = "stroke-amber-500";
                            if (score >= 90) {
                              badgeName = "💎 డైమండ్ స్థాయి వర్కర్ (Diamond)";
                              badgeColor = "from-blue-600/20 to-indigo-600/10 text-blue-900 border-blue-300 animate-pulse";
                              progressColor = "stroke-blue-500";
                            } else if (score >= 70) {
                              badgeName = "🥇 బంగారు స్థాయి వర్కర్ (Gold)";
                              badgeColor = "from-yellow-500/20 to-yellow-600/10 text-yellow-900 border-yellow-400";
                              progressColor = "stroke-yellow-500";
                            } else if (score >= 40) {
                              badgeName = "🥈 వెండి స్థాయి వర్కర్ (Silver)";
                              badgeColor = "from-slate-400/20 to-slate-500/10 text-slate-900 border-slate-300";
                              progressColor = "stroke-slate-500";
                            }

                            // SVG dashoffset calculation
                            const radius = 30;
                            const circumference = 2 * Math.PI * radius;
                            const offset = circumference - (score / 100) * circumference;

                            return (
                              <div className="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 flex items-center justify-between gap-4">
                                <div className="space-y-1.5 flex-1">
                                  <div className="text-[10px] uppercase tracking-wider text-gray-400 font-bold">క్వాలిటీ & పర్ఫార్మెన్స్ ఇండెక్స్ / Quality Index</div>
                                  <div className="flex items-center gap-1.5">
                                    <span className={`text-[11px] font-black px-2.5 py-1 rounded-full border bg-gradient-to-r ${badgeColor}`}>
                                      {badgeName}
                                    </span>
                                  </div>
                                  <div className="text-[10px] text-gray-500 leading-relaxed pt-0.5">
                                    KYC, హాజరు, డైరీ మరియు వాలెట్ బ్యాలెన్స్ ద్వారా మీ స్కోర్ పెరుగుతుంది.
                                  </div>
                                </div>

                                <div className="relative w-20 h-20 flex items-center justify-center shrink-0">
                                  <svg className="w-20 h-20 transform -rotate-90">
                                    {/* Background Circle */}
                                    <circle cx="40" cy="40" r={radius} className="stroke-gray-100 fill-none" strokeWidth="6" />
                                    {/* Progress Circle */}
                                    <circle 
                                      cx="40" 
                                      cy="40" 
                                      r={radius} 
                                      className={`${progressColor} fill-none transition-all duration-500`} 
                                      strokeWidth="6" 
                                      strokeDasharray={circumference} 
                                      strokeDashoffset={offset}
                                      strokeLinecap="round"
                                    />
                                  </svg>
                                  <div className="absolute text-center">
                                    <span className="text-sm font-black text-gray-800 font-mono">{score}</span>
                                    <span className="text-[9px] text-gray-400 font-bold block -mt-1">/100</span>
                                  </div>
                                </div>
                              </div>
                            );
                          })()}

                          {/* FEATURE 8: KYC Identity Uploader */}
                          <WorkerKYC 
                            kycState={kycState} 
                            onUpdateKYC={(upd) => setKycState(prev => ({ ...prev, ...upd }))}
                            controlState={featureStates['feat_kyc']}
                          />

                          {/* FEATURE 12: Gaming-Style Walkie-Talkie */}
                          <WalkieTalkie controlState={featureStates['feat_walkietalkie']} />

                          {/* FEATURE 13: Business Subscription Tiers */}
                          <SubscriptionTiers controlState={featureStates['feat_subscriptions']} />


                        </div>
                      )}

                      {currentWorkerScreen === 'wallet' && (
                        <div className="space-y-5 animate-fade-in">
                          {/* FEATURE 9: Worker Wallet Ledger System */}
                          <WalletLedger 
                            balance={walletBalance} 
                            transactions={walletTransactions}
                            onAddFunds={handleAddWalletFunds}
                            controlState={featureStates['feat_wallet']}
                          />

                          {/* PRIVATE EXPENSE DIARY INSIDE WALLET PAGE */}
                          <PrivateDiary 
                            entries={diaryEntries}
                            onAddEntry={handleAddDiaryEntry}
                            onDeleteEntry={handleDeleteDiaryEntry}
                            controlState={featureStates['feat_diary']}
                          />

                          {/* INVOICE GENERATOR & POSTPAID SYSTEM (FEATURE 15) */}
                          {(() => {
                            const controlState = featureStates['feat_invoice_generator'] || 'temp_on';
                            if (controlState === 'temp_off' || controlState === 'perm_off') {
                              return (
                                <div className="bg-white rounded-2xl p-6 text-center border border-gray-100 shadow-md">
                                  <FileText className="w-12 h-12 text-gray-300 mx-auto mb-3 animate-pulse" />
                                  <h4 className="text-gray-900 font-bold">ఇన్‌వాయిస్ జనరేటర్ అందుబాటులో లేదు</h4>
                                  <p className="text-xs text-red-500 font-semibold">Invoice Generator Suspended</p>
                                  <p className="text-gray-500 text-xs mt-2">అడ్మినిస్ట్రేటర్ ద్వారా ఈ ఫీచర్ ప్రస్తుతం ఆఫ్ చేయబడింది.</p>
                                </div>
                              );
                            }
                            if (controlState === 'soft_delete' || controlState === 'hard_delete') {
                              return null;
                            }

                            const isUpgraded = controlState === 'perm_upgrade';
                            return (
                              <InvoiceGeneratorComponent 
                                isUpgraded={isUpgraded}
                                postpaidBills={postpaidBills}
                                onAddPostpaidBill={(newBill) => {
                                  setPostpaidBills(prev => [newBill, ...prev]);
                                  // Also add to Private Diary as expected income
                                  handleAddDiaryEntry({
                                    date: newBill.date,
                                    description: `పోస్ట్‌పెయిడ్ బిల్లు: ${newBill.customerName} - ${newBill.workDescription}`,
                                    amount: newBill.amount,
                                    type: 'income'
                                  });
                                }}
                              />
                            );
                          })()}
                        </div>
                      )}

                      {currentWorkerScreen === 'diary' && (
                        <div className="space-y-5 animate-fade-in">
                          {/* FEATURE 14: Manual Payment Private Diary */}
                          <PrivateDiary 
                            entries={diaryEntries}
                            onAddEntry={handleAddDiaryEntry}
                            onDeleteEntry={handleDeleteDiaryEntry}
                            controlState={featureStates['feat_diary']}
                          />

                          {/* DATA EXPORTER & CONVERTER SECTION */}
                          <div className="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 space-y-3.5">
                            <div>
                              <h4 className="font-bold text-xs text-[#082c75] flex items-center gap-1.5">
                                <span className="text-base">📁</span>
                                <span>డేటా కన్వర్టర్ & ఎక్స్‌పోర్టర్ (File Converter)</span>
                              </h4>
                              <p className="text-[10px] text-gray-500">మీ రికార్డులను ఎక్సెల్/CSV మరియు ప్రింట్ PDF లోకి మార్చుకోండి</p>
                            </div>

                            <div className="grid grid-cols-1 gap-2">
                              {/* 1. Private Diary Excel Export */}
                              <button
                                onClick={() => {
                                  if (diaryEntries.length === 0) {
                                    alert("ఎగుమతి చేయడానికి ఎటువంటి డేటా లేదు!");
                                    return;
                                  }
                                  const headers = "Date,Description,Amount,Type\n";
                                  const rows = diaryEntries.map(e => 
                                    `"${e.date}","${e.description.replace(/"/g, '""')}",${e.amount},"${e.type}"`
                                  ).join("\n");
                                  const blob = new Blob([headers + rows], { type: 'text/csv;charset=utf-8;' });
                                  const url = URL.createObjectURL(blob);
                                  const link = document.createElement("a");
                                  link.setAttribute("href", url);
                                  link.setAttribute("download", `CWRB_Private_Diary_${new Date().toISOString().split('T')[0]}.csv`);
                                  document.body.appendChild(link);
                                  link.click();
                                  document.body.removeChild(link);
                                }}
                                className="w-full py-2 px-3 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-[11px] font-bold rounded-xl border border-emerald-200 flex items-center justify-between transition active:scale-95"
                              >
                                <span className="flex items-center gap-2">
                                  <span>📊</span>
                                  <span>వ్యక్తిగత డైరీని Excel / CSV లోకి మార్చండి</span>
                                </span>
                                <span className="bg-emerald-600 text-white text-[9px] px-1.5 py-0.5 rounded font-mono">.CSV</span>
                              </button>

                              {/* 2. Customer Bookings CSV Export */}
                              <button
                                onClick={() => {
                                  if (bookings.length === 0) {
                                    alert("ఎగుమతి చేయడానికి బుకింగ్స్ ఏవీ లేవు!");
                                    return;
                                  }
                                  const headers = "BookingID,ServiceName,Date,Slot,CustomerName,CustomerPhone,Status\n";
                                  const rows = bookings.map(b => 
                                    `"${b.id}","${b.serviceName}","${b.date}","${b.slot}","${b.customerName}","${b.customerPhone}","${b.status}"`
                                  ).join("\n");
                                  const blob = new Blob([headers + rows], { type: 'text/csv;charset=utf-8;' });
                                  const url = URL.createObjectURL(blob);
                                  const link = document.createElement("a");
                                  link.setAttribute("href", url);
                                  link.setAttribute("download", `CWRB_Bookings_Leads_${new Date().toISOString().split('T')[0]}.csv`);
                                  document.body.appendChild(link);
                                  link.click();
                                  document.body.removeChild(link);
                                }}
                                className="w-full py-2 px-3 bg-blue-50 hover:bg-blue-100 text-blue-800 text-[11px] font-bold rounded-xl border border-blue-200 flex items-center justify-between transition active:scale-95"
                              >
                                <span className="flex items-center gap-2">
                                  <span>📋</span>
                                  <span>కస్టమర్ బుకింగ్స్ ని CSV లోకి మార్చండి</span>
                                </span>
                                <span className="bg-blue-600 text-white text-[9px] px-1.5 py-0.5 rounded font-mono">.CSV</span>
                              </button>

                              {/* 3. Styled HTML / PDF Print Ledger */}
                              <button
                                onClick={() => {
                                  const printWindow = window.open('', '_blank');
                                  if (printWindow) {
                                    const html = `
                                      <html>
                                        <head>
                                          <title>CWRB Civil Worker statement - July 2026</title>
                                          <style>
                                            body { font-family: sans-serif; padding: 40px; color: #1e293b; background-color: #fafafa; }
                                            .container { max-width: 800px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
                                            h1 { color: #082c75; font-size: 24px; text-align: center; border-bottom: 4px solid #FFC000; padding-bottom: 15px; margin-bottom: 20px; }
                                            .meta { display: flex; justify-content: space-between; font-size: 13px; color: #64748b; margin-bottom: 30px; }
                                            table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 30px; }
                                            th, td { border: 1px solid #e2e8f0; padding: 12px 14px; text-align: left; font-size: 13px; }
                                            th { background-color: #082c75; color: white; font-weight: bold; }
                                            .income { color: #10b981; font-weight: bold; }
                                            .expense { color: #f43f5e; font-weight: bold; }
                                            .badge { display: inline-block; padding: 3px 8px; border-radius: 9999px; font-size: 11px; font-weight: bold; }
                                            .badge-success { background-color: #d1fae5; color: #065f46; }
                                            .footer { text-align: center; font-size: 11px; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 20px; margin-top: 40px; }
                                          </style>
                                        </head>
                                        <body>
                                          <div class="container">
                                            <h1>CWRB - సివిల్ వర్కర్ ఖర్చుల & సర్వీస్ లెడ్జర్ స్టేట్‌మెంట్</h1>
                                            <div class="meta">
                                              <p><strong>అకౌంట్ ఈమెయిల్:</strong> psm8742260@gmail.com</p>
                                              <p><strong>సిస్టమ్ రికార్డులు:</strong> July 2026</p>
                                              <p><strong>ప్రింట్ చేసిన తేదీ:</strong> ${new Date().toLocaleDateString()}</p>
                                              <p><strong>స్టేటస్:</strong> <span class="badge badge-success">యాక్టివ్ / ACTIVE</span></p>
                                            </div>
                                            
                                            <h3 style="color: #082c75; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px;">1. రోజువారీ ఆదాయ-వ్యయాల డైరీ (Private Expense Diary)</h3>
                                            <table>
                                              <thead>
                                                <tr>
                                                  <th>తేదీ (Date)</th>
                                                  <th>వివరం (Description)</th>
                                                  <th>ఆదాయం (Income)</th>
                                                  <th>ఖర్చు (Expense)</th>
                                                </tr>
                                              </thead>
                                              <tbody>
                                                ${diaryEntries.length === 0 ? '<tr><td colspan="4" style="text-align: center; color: #94a3b8;">డేటా ఏదీ లేదు</td></tr>' : 
                                                  diaryEntries.map(e => `
                                                    <tr>
                                                      <td>${e.date}</td>
                                                      <td>${e.description}</td>
                                                      <td class="income">${e.type === 'income' ? '₹' + e.amount : '-'}</td>
                                                      <td class="expense">${e.type === 'expense' ? '₹' + e.amount : '-'}</td>
                                                    </tr>
                                                  `).join('')
                                                }
                                              </tbody>
                                            </table>

                                            <h3 style="color: #082c75; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; margin-top: 40px;">2. కస్టమర్ బుకింగ్స్ లిస్టు (Service Bookings List)</h3>
                                            <table>
                                              <thead>
                                                <tr>
                                                  <th>サーヴィス (Service)</th>
                                                  <th>తేదీ (Date)</th>
                                                  <th>స్లాట్ (Slot)</th>
                                                  <th>కస్టమర్ పేరు (Customer)</th>
                                                  <th>మొబైల్ (Phone)</th>
                                                </tr>
                                              </thead>
                                              <tbody>
                                                ${bookings.length === 0 ? '<tr><td colspan="5" style="text-align: center; color: #94a3b8;">బుకింగ్స్ ఏవీ లేవు</td></tr>' : 
                                                  bookings.map(b => `
                                                    <tr>
                                                      <td>${b.serviceName}</td>
                                                      <td>${b.date}</td>
                                                      <td>${b.slot === 'morning' ? 'ఉదయం' : 'మధ్యాహ్నం'}</td>
                                                      <td>${b.customerName}</td>
                                                      <td>${b.customerPhone}</td>
                                                    </tr>
                                                  `).join('')
                                                }
                                              </tbody>
                                            </table>

                                            <div class="footer">
                                              <p>© 2026 Civil Worker Relation Book (CWRB). Designed with Dual Control System.</p>
                                            </div>
                                          </div>
                                          <script>
                                            window.onload = function() { window.print(); }
                                          </script>
                                        </body>
                                      </html>
                                    `;
                                    printWindow.document.write(html);
                                    printWindow.document.close();
                                  }
                                }}
                                className="w-full py-2 px-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-800 text-[11px] font-bold rounded-xl border border-indigo-200 flex items-center justify-between transition active:scale-95"
                              >
                                <span className="flex items-center gap-2">
                                  <span>🖨️</span>
                                  <span>ఖాతా లెడ్జర్‌ని ప్రింట్ / PDF లోకి మార్చండి</span>
                                </span>
                                <span className="bg-indigo-600 text-white text-[9px] px-1.5 py-0.5 rounded font-mono">PDF / PRINT</span>
                              </button>
                            </div>
                          </div>
                        </div>
                      )}

