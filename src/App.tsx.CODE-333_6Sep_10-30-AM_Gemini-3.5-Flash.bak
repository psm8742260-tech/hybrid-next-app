                  <div>పర్మనెంట్ ఆఫ్</div>
                  <div className="text-[7px] opacity-80 mt-0.5">P-OFF</div>
                </div>
                <div className="p-1 rounded-lg bg-slate-100 text-slate-800 border border-slate-300">
                  <div>టెంపరరీ డిలీట్</div>
                  <div className="text-[7px] opacity-80 mt-0.5">S-DEL</div>
                </div>
                <div className="p-1 rounded-lg bg-black text-white">
                  <div>పర్మనెంట్ డిలీట్</div>
                  <div className="text-[7px] opacity-80 mt-0.5">H-DEL</div>
                </div>
              </div>

              {/* Feature Matrix Control Table */}
              <div className="overflow-x-auto">
                <table className="w-full text-left border-collapse text-[11px]">
                  <thead>
                    <tr className="border-b border-gray-200 bg-gray-50/50 text-gray-500 font-bold uppercase tracking-wider text-[9px] sm:text-[10px]">
                      <th className="py-2 px-2">ఫీచర్ పేరు / Feature Name</th>
                      <th className="py-2 px-2">ప్రస్తుత స్థితి / State</th>
                      <th className="py-2 px-2 text-center">7 మాస్టర్ కంట్రోల్స్ / 7 Master Controls</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-100 font-medium text-gray-700">
                    {INITIAL_FEATURES.map((feat) => {
                      const currState = rawFeatureStates[feat.id] || 'temp_on';

                      return (
                        <tr key={feat.id} className="hover:bg-slate-50/40 transition">
                          <td className="py-1.5 px-2">
                            <div className="font-bold text-gray-900 text-xs">{feat.nameTe}</div>
                            <div className="text-[8.5px] text-gray-400 font-mono">{feat.nameEn}</div>
                          </td>
                          
                          <td className="py-1.5 px-2">
                            <span className={`inline-block px-1.5 py-0.5 rounded text-[8px] font-black uppercase tracking-wider ${
                              currState === 'temp_on' ? 'bg-emerald-100 text-emerald-800' :
                              currState === 'temp_off' ? 'bg-amber-100 text-amber-800 animate-pulse' :
                              currState === 'perm_upgrade' ? 'bg-[#FFC000]/30 text-[#082c75] font-black' :
                              currState === 'perm_on' ? 'bg-teal-100 text-teal-800' :
                              currState === 'perm_off' ? 'bg-red-100 text-red-800' :
                              currState === 'soft_delete' ? 'bg-slate-100 text-slate-800' : 'bg-black text-white'
                            }`}>
                              {currState}
                            </span>
                          </td>

                          <td className="py-1.5 px-2">
                            <div className="flex justify-center items-center gap-0.5">
                              
                              {/* 1. Temp ON */}
                              <button
                                type="button"
                                onClick={() => updateFeatureState(feat.id, 'temp_on')}
                                title="Temporary ON"
                                className={`w-5.5 h-5.5 rounded-full font-black text-[7.5px] flex items-center justify-center transition ${
                                  currState === 'temp_on' 
                                    ? 'bg-emerald-600 text-white shadow-sm shadow-emerald-500/30' 
                                    : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
                                }`}
                              >
                                T-ON
                              </button>

                              {/* 2. Temp OFF */}
                              <button
                                type="button"
                                onClick={() => updateFeatureState(feat.id, 'temp_off')}
                                title="Temporary OFF"
                                className={`w-5.5 h-5.5 rounded-full font-black text-[7.5px] flex items-center justify-center transition ${
                                  currState === 'temp_off' 
                                    ? 'bg-amber-500 text-white shadow-sm shadow-amber-500/30' 
                                    : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
                                }`}
                              >
                                T-OF
                              </button>

                              {/* 3. Perm Upgrade */}
                              <button
                                type="button"
                                onClick={() => updateFeatureState(feat.id, 'perm_upgrade')}
                                title="Permanent Upgrade"
                                className={`w-5.5 h-5.5 rounded-full font-black text-[7.5px] flex items-center justify-center transition ${
                                  currState === 'perm_upgrade' 
                                    ? 'bg-[#FFC000] text-[#082c75] shadow-sm shadow-yellow-500/30' 
                                    : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
                                }`}
                              >
                                UPG
                              </button>

                              {/* 4. Perm ON */}
                              <button
                                type="button"
                                onClick={() => updateFeatureState(feat.id, 'perm_on')}
                                title="Permanent ON"
                                className={`w-5.5 h-5.5 rounded-full font-black text-[7.5px] flex items-center justify-center transition ${
                                  currState === 'perm_on' 
                                    ? 'bg-teal-600 text-white shadow-sm shadow-teal-500/30' 
                                    : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
                                }`}
                              >
                                P-ON
                              </button>

                              {/* 5. Perm OFF */}
                              <button
                                type="button"
                                onClick={() => updateFeatureState(feat.id, 'perm_off')}
                                title="Permanent OFF"
                                className={`w-5.5 h-5.5 rounded-full font-black text-[7.5px] flex items-center justify-center transition ${
                                  currState === 'perm_off' 
                                    ? 'bg-red-600 text-white shadow-sm shadow-red-500/30' 
                                    : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
                                }`}
                              >
                                P-OF
                              </button>

                              {/* 6. Soft Delete */}
                              <button
                                type="button"
                                onClick={() => updateFeatureState(feat.id, 'soft_delete')}
                                title="Soft Delete"
                                className={`w-5.5 h-5.5 rounded-full font-black text-[7.5px] flex items-center justify-center transition ${
                                  currState === 'soft_delete' 
                                    ? 'bg-slate-600 text-white shadow-sm' 
                                    : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
                                }`}
                              >
                                S-DL
                              </button>

                              {/* 7. Hard Delete */}
                              <button
                                type="button"
                                onClick={() => updateFeatureState(feat.id, 'hard_delete')}
                                title="Hard Delete"
                                className={`w-5.5 h-5.5 rounded-full font-black text-[7.5px] flex items-center justify-center transition ${
                                  currState === 'hard_delete' 
                                    ? 'bg-black text-white shadow-sm' 
                                    : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
                                }`}
                              >
                                H-DL
                              </button>

                            </div>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>

              <div className="mt-6 p-4 bg-[#082c75] text-white rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
                <div>
                  <h4 className="font-bold text-sm text-[#FFC000]">హైబ్రిడ్ సిస్టం లైవ్ సమాచారం / System Status</h4>
                  <p className="text-[10px] text-gray-300 mt-0.5">అడ్మిన్ డాష్బోర్డ్ మరియు యూజర్ ఇంటర్ఫేస్ పూర్తి సమకాలీకరణలో పనిచేస్తున్నాయి.</p>
                </div>
                <div className="flex gap-2 shrink-0">
                  <span className="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse block"></span>
                  <span className="text-[10px] font-mono tracking-wider font-bold">CORE SYNC: OK</span>
                </div>
              </div>
            </div>
          )}

          {adminPanelActiveTab === 'brahmastra' && (
            <div className="">
              {/* AI Brahmastra Coding System */}
              <BrahmastraSystemComponent 
                isAgentToggleVisible={isAgentToggleVisible}
                onToggleAgentVisibility={setIsAgentToggleVisible}
                isBrahmastraButtonVisible={isBrahmastraButtonVisible}
                onToggleBrahmastraButton={setIsBrahmastraButtonVisible}
                isSystemOnline={isSystemOnline}
                onToggleSystemOnline={setIsSystemOnline}
                isHybridRadioMode={isHybridRadioMode}
                onToggleHybridRadioMode={setIsHybridRadioMode}
              />
            </div>
          )}

          {adminPanelActiveTab === 'support' && (
            <div className="space-y-6  text-[11px] sm:text-[12px] p-1">
              <div className="p-4 bg-emerald-50 rounded-2xl border border-emerald-100 flex items-start gap-3">
                <span className="text-xl">📞</span>
                <div>
                  <h4 className="font-extrabold text-emerald-800 text-xs">కస్టమర్ కేర్ & సపోర్ట్ కాన్ఫిగరేషన్ (Support Setup)</h4>
                  <p className="text-[10px] text-emerald-700/80 mt-0.5 leading-relaxed">
                    ఇక్కడ మీరు అప్లికేషన్‌లో కనిపించే కస్టమర్ కేర్ ఫోన్ నెంబర్ మరియు గూగుల్ ఫారం ఫీడ్‌బ్యాక్ లింకులను అప్డేట్ చేసుకోవచ్చు. అదనపు ఫోన్ నంబర్లను కూడా యాడ్ చేయవచ్చు.
                  </p>
                </div>
              </div>

              {/* SECTION 1: Primary Controls */}
              <div className="bg-slate-50 p-4 rounded-2xl border border-slate-100 space-y-4">
                <h3 className="font-bold text-[#082c75] uppercase tracking-wide text-[10px] sm:text-xs">ప్రధాన లింకులు / Primary Links</h3>
                
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="space-y-1">
                    <label className="block text-[11px] font-bold text-gray-700">కస్టమర్ కేర్ మొబైల్ నెంబర్ / Customer Care Phone</label>
                    <input
                      type="text"
                      className="w-full p-2.5 bg-white border border-gray-200 rounded-xl font-mono text-xs focus:ring-1 focus:ring-emerald-500 focus:outline-none text-gray-800 font-bold"
                      placeholder="మొబైల్ నెంబర్ ఎంటర్ చేయండి (లేదా ఖాళీగా ఉంచండి)"
                      value={customerCarePhone}
                      onChange={(e) => setCustomerCarePhone(e.target.value)}
                    />
                    <span className="text-[9px] text-gray-400 block">కస్టమర్ 'Care' బటన్ నొక్కినప్పుడు ఈ నంబర్‌కి నేరుగా డయల్ వెళ్తుంది.</span>
                  </div>

                  <div className="space-y-1">
                    <label className="block text-[11px] font-bold text-gray-700">గూగుల్ ఫారం ఫీడ్‌బ్యాక్ లింక్ / Google Form Link</label>
                    <input
                      type="url"
                      className="w-full p-2.5 bg-white border border-gray-200 rounded-xl font-mono text-xs focus:ring-1 focus:ring-emerald-500 focus:outline-none text-gray-800 font-bold"
                      placeholder="https://forms.gle/..."
                      value={feedbackGoogleForm}
                      onChange={(e) => setFeedbackGoogleForm(e.target.value)}
                    />
                    <span className="text-[9px] text-gray-400 block">కస్టమర్ 'Feedback' బటన్ నొక్కినప్పుడు ఈ గూగుల్ ఫారం ఓపెన్ అవుతుంది.</span>
                  </div>
                </div>
              </div>

              {/* SECTION 2: Add Additional Phone Numbers */}
              <div className="bg-slate-50 p-4 rounded-2xl border border-slate-100 space-y-4">
                <h3 className="font-bold text-[#082c75] uppercase tracking-wide text-[10px] sm:text-xs">అదనపు నంబర్లు / Add Other Phone Numbers</h3>
                
                {/* Form to add */}
                <div className="bg-white p-3 rounded-xl border border-slate-100 grid grid-cols-1 sm:grid-cols-3 gap-2.5 items-end">
                  <div className="space-y-1">
                    <label className="block text-[10px] font-bold text-gray-500 uppercase">పేరు / Contact Name</label>
                    <input
                      type="text"
                      id="new-contact-name"
                      placeholder="ఉదా: సూపర్వైజర్ ప్రసాద్"
                      className="w-full p-2 bg-slate-50 border border-gray-200 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500 text-gray-800 font-semibold"
                    />
                  </div>
                  <div className="space-y-1">
                    <label className="block text-[10px] font-bold text-gray-500 uppercase">ఫోన్ నెంబర్ / Phone Number</label>
                    <input
                      type="text"
                      id="new-contact-phone"
                      placeholder="ఉదా: 9876543210"
                      className="w-full p-2 bg-slate-50 border border-gray-200 rounded-lg text-xs font-mono focus:outline-none focus:ring-1 focus:ring-emerald-500 text-gray-800 font-bold"
                    />
                  </div>
                  <button
                    type="button"
                    onClick={() => {
                      const nameInput = document.getElementById('new-contact-name') as HTMLInputElement;
                      const phoneInput = document.getElementById('new-contact-phone') as HTMLInputElement;
                      if (nameInput && phoneInput) {
                        const name = nameInput.value.trim();
                        const phone = phoneInput.value.trim();
                        if (!name || !phone) {
                          alert("దయచేసి పేరు మరియు సరైన ఫోన్ నెంబర్ రెండింటినీ ఎంటర్ చేయండి!");
                          return;
                        }
                        const newContact = {
                          id: 'contact_' + Date.now(),
                          name,
                          phone
                        };
                        setSupportNumbersList(prev => [...prev, newContact]);
                        nameInput.value = '';
                        phoneInput.value = '';
                      }
                    }}
                    className="w-full p-2 bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs rounded-lg transition active:scale-95 text-center cursor-pointer"
                  >
                    నంబర్ యాడ్ చేయి / Add Number
                  </button>
                </div>

                {/* List of other numbers */}
                <div className="space-y-2">
                  <span className="block text-[10px] font-bold text-gray-500 uppercase tracking-wide">ప్రస్తుతం ఉన్న సహాయక నంబర్లు / Contact List</span>
                  {supportNumbersList.length === 0 ? (
                    <div className="text-center py-4 text-xs text-gray-400 bg-white rounded-xl border border-dashed border-gray-200">
                      ఇతర అదనపు ఫోన్ నంబర్లు ఏవీ యాడ్ చేయబడలేదు. పైన యాడ్ చేసుకోవచ్చు.
                    </div>
                  ) : (
                    <div className="overflow-hidden border border-gray-150 rounded-xl bg-white">
                      <table className="w-full text-left border-collapse text-xs">
                        <thead>
                          <tr className="bg-slate-50 text-gray-500 font-bold border-b border-gray-150 text-[10px] uppercase">
                            <th className="py-2 px-3">పేరు / Name</th>
                            <th className="py-2 px-3">ఫోన్ నెంబర్ / Phone</th>
                            <th className="py-2 px-3 text-right">చర్యలు / Action</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-gray-100">
                          {supportNumbersList.map((contact) => (
                            <tr key={contact.id} className="hover:bg-slate-50/50 transition">
                              <td className="py-2 px-3 font-bold text-[#082c75]">{contact.name}</td>
                              <td className="py-2 px-3 font-mono font-medium text-gray-600">{contact.phone}</td>
                              <td className="py-2 px-3 text-right">
                                <button
                                  type="button"
                                  onClick={() => {
                                    setSupportNumbersList(prev => prev.filter(c => c.id !== contact.id));
                                  }}
                                  className="px-2.5 py-1 bg-red-50 text-red-600 font-bold text-[10px] rounded-lg hover:bg-red-100 transition border border-red-200/40"
                                >
                                  డిలీట్ / Delete
                                </button>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                </div>
              </div>
            </div>
          )}
        </div>

      </div>


      {/* =========================================================
          GLOBAL OVERLAY INTERACTIVE MODALS
          ========================================================= */}

      {/* 1. FEATURE 4: Scheduling Calendar Overlay popup */}
      {selectedService && (
        <ServiceCalendar 
          service={selectedService}
          onClose={() => setSelectedService(null)}
          onBook={handleBooking}
          controlState={featureStates['feat_calendar']}
        />
      )}

      {/* 2. FEATURE 6: Simulated Dialer / Direct Calling Modal popup */}
      {activeCallWorker && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-[#082c75] text-white rounded-3xl p-6 max-w-sm w-full text-center border border-[#FFC000]/40 shadow-2xl relative">
            <div className="w-16 h-16 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-4 animate-pulse">
              <Phone className="w-8 h-8 text-[#FFC000]" />
            </div>

            <div className="text-sm font-semibold uppercase tracking-wider text-gray-300">సిమ్యులేటెడ్ కాల్ / CWRB CALL INTENT</div>
            <h3 className="text-xl font-black mt-2 text-[#FFC000]">{activeCallWorker.name}</h3>
            <p className="text-xs text-gray-300">{activeCallWorker.type}</p>
            
            <div className="my-6 p-3 bg-white/5 rounded-xl text-center">
              <div className="text-xs text-gray-400">డైలర్ ప్యాడ్ లోకి పంపే నెంబర్ / Dialer Intent:</div>
              <div className="text-lg font-mono font-bold text-white mt-1 tracking-widest">{activeCallWorker.phone}</div>
            </div>

            <div className="text-xs text-[#FFC000]/90 font-semibold mb-6">
              (₹0 కాల్ సిమ్యులేటర్ - Direct ACTION_DIAL Triggers)
            </div>

            <div className="flex gap-3">
              <button
                onClick={() => setActiveCallWorker(null)}
                className="flex-1 py-2 bg-white/10 rounded-xl font-bold text-xs hover:bg-white/20 transition text-white"
              >
                రద్దు / Close
              </button>
              <button
                onClick={() => {
                  alert(`Dialing ${activeCallWorker.phone} via simulated intent...`);
                  setActiveCallWorker(null);
                }}
                className="flex-1 py-2 bg-[#FFC000] text-[#082c75] rounded-xl font-bold text-xs hover:brightness-105 transition"
              >
                కాల్ చేయండి / Call
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Weather Report Modal */}
      {showWeatherModal && (
        <div className="fixed inset-0 z-50 bg-black/75 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-slate-950 text-white rounded-3xl p-5 max-w-md w-full border-4 border-sky-500 shadow-2xl relative overflow-hidden">
            
            {/* Top Bar Close Button */}
            <button
              onClick={() => setShowWeatherModal(false)}
              className="absolute top-4 right-4 p-2 bg-white/10 hover:bg-white/20 rounded-full transition flex items-center justify-center focus:outline-hidden"
              title="మూసివేయండి / Close"
            >
              <ArrowLeft className="w-5 h-5 text-white rotate-180" />
            </button>

            <div className="flex items-center gap-3 p-3 bg-sky-950/40 rounded-2xl border border-sky-500/30 mb-4 mt-6">
              <div className="w-10 h-10 rounded-full bg-sky-500/20 flex items-center justify-center text-sky-400">
                <CloudSun className="w-6 h-6 animate-bounce" />
              </div>
              <div>
                <h3 className="font-bold text-sm text-sky-300">వాతావరణ రేడియో నివేదిక</h3>
                <p className="text-[10px] text-sky-200/70">Weather Radio Band: 162.400 MHz VHF</p>
              </div>
            </div>

            <div className="bg-slate-900/80 p-4 rounded-2xl border border-slate-800 space-y-3 relative overflow-hidden mb-4">
              <div className="absolute top-0 right-0 p-1 px-2.5 text-[8px] font-bold bg-sky-500/20 border-l border-b border-sky-500/30 text-sky-400 rounded-bl-lg font-mono">
                OFFLINE RX LIVE
              </div>

              <div className="flex justify-between items-center">
                <div>
                  <div className="text-3xl font-black font-mono text-white">32°C</div>
                  <div className="text-[10px] text-slate-400 mt-0.5">ప్రస్తుత ఉష్ణోగ్రత / Current Temp</div>
                </div>
                <div className="text-right">
                  <div className="text-sm font-bold text-amber-400">పాక్షికంగా మేఘావృతం</div>
                  <div className="text-[10px] text-slate-400">Partly Cloudy</div>
                </div>
              </div>

              <div className="h-1 bg-slate-800 rounded-full overflow-hidden">
                <div className="h-full bg-gradient-to-r from-sky-400 to-amber-400 w-2/3 animate-pulse"></div>
              </div>

              <div className="grid grid-cols-2 gap-2 text-center pt-1">
                <div className="bg-slate-950/50 p-2.5 rounded-xl border border-slate-800/60">
                  <span className="text-[9px] text-slate-400 block mb-0.5">గాలి వేగం (Wind)</span>
                  <span className="text-xs font-bold font-mono text-slate-200">14 km/h</span>
                </div>
                <div className="bg-slate-950/50 p-2.5 rounded-xl border border-slate-800/60">
                  <span className="text-[9px] text-slate-400 block mb-0.5">తేమ శాతం (Humidity)</span>
                  <span className="text-xs font-bold font-mono text-slate-200">62%</span>
                </div>
              </div>
            </div>

            <div className="space-y-2.5 mb-4">
              <h4 className="text-[10px] font-bold text-sky-400 uppercase tracking-wider">స్థానిక రేడియో హెచ్చరికలు / RF Weather Alerts:</h4>
              
              <div className="bg-amber-500/10 border border-amber-500/30 p-3 rounded-2xl space-y-1">
                <div className="flex items-center justify-between mb-1">
                  <span className="text-[9px] font-bold text-amber-400 uppercase flex items-center gap-1">
                    <span className="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
                    YELLOW ALERT (పసుపు హెచ్చరిక)
                  </span>
                  <span className="text-[8px] text-slate-400 font-mono">11:30 AM</span>
                </div>
                <p className="text-xs text-slate-200 leading-normal">
                  నేడు మధ్యాహ్నం 1 గంట నుండి 4 గంటల మధ్య ఎండ తీవ్రత ఎక్కువగా ఉంటుంది. వర్కర్లు నీడన విశ్రాంతి తీసుకోవాల్సిందిగా కోరుతున్నాము.
                </p>
                <p className="text-[9.5px] text-slate-400 leading-snug">
                  High temperature forecast this afternoon. Outdoor workers are advised to rest under shade periodically and stay hydrated.
                </p>
              </div>

              <div className="bg-emerald-500/10 border border-emerald-500/20 p-2.5 rounded-2xl text-[10px] text-emerald-400 flex items-center gap-2">
                <span className="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
                <span>వర్ష సూచన లేదు. పనులు సజావుగా సాగవచ్చు. (No immediate rain forecast. Perfect for outdoor work.)</span>
              </div>
            </div>

            <div className="flex gap-2">
              <button 
                onClick={() => {
                  if (typeof window !== 'undefined') {
                    const utterance = new SpeechSynthesisUtterance("వాతావరణ రేడియో సింక్ పూర్తయింది. వాతావరణం పాక్షికంగా మేఘావృతం.");
                    utterance.lang = "te-IN";
                    window.speechSynthesis?.speak(utterance);
                  }
                  alert("వాతావరణ సమాచారం రేడియో వేవ్స్ ద్వారా విజయవంతంగా అప్‌డేట్ చేయబడింది! / Weather synced over RF!");
                }}
                className="flex-1 py-2.5 bg-gradient-to-r from-sky-600 to-sky-500 hover:from-sky-500 hover:to-sky-400 rounded-xl text-white font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-sky-500/10 transition-all active:scale-[0.98]"
              >
                <RotateCcw className="w-3.5 h-3.5 animate-spin-slow" />
                అప్‌డేట్ చేయి (Sync over RF)
              </button>

              <button
                onClick={() => setShowWeatherModal(false)}
                className="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold rounded-xl text-xs transition"
              >
                మూసివేయి / Close
              </button>
            </div>
          </div>
        </div>
      )}

      {/* 3. FEATURE 7: SOS Emergency Modal popup */}
      {sosActive && (
        <div className="fixed inset-0 z-50 bg-black/75 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-[#082c75] text-white rounded-3xl p-6 max-w-md w-full border-4 border-rose-600 shadow-2xl text-center relative">
            
            {/* Top Bar Back Button */}
            <button
              onClick={() => setSosActive(false)}
              className="absolute top-4 left-4 p-2 bg-white/10 hover:bg-white/20 rounded-full transition flex items-center justify-center focus:outline-hidden"
              title="వెనక్కి వెళ్ళండి / Go Back"
              id="sos-back-btn"
            >
              <ArrowLeft className="w-5 h-5 text-white" />
            </button>

            <div className="w-20 h-20 bg-rose-600 rounded-full flex items-center justify-center mx-auto mb-4 animate-ping shadow-[0_0_20px_rgba(220,38,38,0.5)]">
              <ShieldAlert className="w-10 h-10 text-white" />
            </div>

            <h3 className="text-2xl font-black text-rose-500 uppercase tracking-widest">SOS అత్యవసర అభ్యర్థన</h3>
            <p className="text-xs text-gray-300">SOS Emergency Triggered</p>

            <div className="my-5 p-4 bg-white/5 rounded-2xl text-left text-xs space-y-2.5 border border-white/10">
              <div>
                <strong className="text-rose-400 block mb-0.5">నా తాజా లొకేషన్ / Current GPS Location:</strong>
                <span className="font-mono text-gray-100 text-[11px] bg-slate-900 p-1.5 rounded block">{sosLocation}</span>
              </div>
              <div className="text-[10px] text-gray-400">
                ఈ సిగ్నల్ మీ లొకేషన్ తో పాటు సహాయక నంబర్లకు పంపబడుతుంది.
              </div>
            </div>

            <div className="space-y-2.5">
              <span className="text-xs font-bold text-gray-300 block">అత్యవసర డైరెక్ట్ నంబర్లు / Hotlines:</span>
              <div className="grid grid-cols-3 gap-2">
                <a href="tel:100" className="bg-rose-950 hover:bg-rose-900 border border-rose-500/30 p-2.5 rounded-xl text-center">
                  <div className="text-lg font-black font-mono text-rose-400">100</div>
                  <div className="text-[8px] text-gray-400 font-bold">పోలీస్ / Police</div>
                </a>
                <a href="tel:101" className="bg-rose-950 hover:bg-rose-900 border border-rose-500/30 p-2.5 rounded-xl text-center">
                  <div className="text-lg font-black font-mono text-rose-400">101</div>
                  <div className="text-[8px] text-gray-400 font-bold">ఫైర్ / Fire</div>
                </a>
                <a href="tel:108" className="bg-rose-950 hover:bg-rose-900 border border-rose-500/30 p-2.5 rounded-xl text-center">
                  <div className="text-lg font-black font-mono text-rose-400">108</div>
                  <div className="text-[8px] text-gray-400 font-bold">అంబులెన్స్ / Medical</div>
                </a>
              </div>
            </div>

            <button
              onClick={() => setSosActive(false)}
              className="mt-6 w-full py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl text-xs transition"
            >
              సిగ్నల్ రద్దు చేయండి / Cancel SOS
            </button>

          </div>
        </div>
      )}

      {/* 4. FEATURE 10: Ratings Feedback Modal popup with swipe rating */}
      {activeRatingBooking && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white text-gray-800 rounded-3xl p-6 max-w-sm w-full shadow-2xl relative border border-gray-100">
            
            <h3 className="text-lg font-extrabold text-[#082c75] text-center mb-1">
              {activeRatingBooking.serviceName} రేటింగ్
            </h3>
            <p className="text-xs text-gray-500 text-center mb-4">వర్కర్ కి మీ అభిప్రాయాన్ని అందించండి</p>

            {/* Gesture-Based Slide Rating emulation */}
            <div className="space-y-2 mb-5">
              <span className="text-xs font-bold text-gray-600 block">స్టార్ రేటింగ్ ఇవ్వండి / Swipe to Rate:</span>
              
              <div className="bg-amber-50 p-4 rounded-2xl border border-amber-100 flex flex-col items-center justify-center">
                <div className="flex gap-1.5">
                  {[1, 2, 3, 4, 5].map((star) => (
                    <button
                      key={star}
                      type="button"
                      onClick={() => setStarRating(star)}
                      className="p-1 focus:outline-none transition-transform active:scale-125"
                    >
                      <Star className={`w-8 h-8 ${
                        star <= starRating ? 'text-[#FFC000] fill-[#FFC000]' : 'text-gray-300'
                      }`} />
                    </button>
                  ))}
                </div>
                <div className="text-xs font-black text-[#082c75] mt-2 font-mono">
                  {starRating === 5 ? 'అద్భుతం! / Excellent (5/5)' :
                   starRating === 4 ? 'చాలా బాగుంది / Very Good (4/5)' :
                   starRating === 3 ? 'పర్వాలేదు / Good (3/5)' :
                   starRating === 2 ? 'బాగాలేదు / Average (2/5)' : 'చాలా బాగాలేదు / Poor (1/5)'}
                </div>
              </div>
            </div>

            {/* Comment block */}
            <div className="space-y-1.5 mb-5">
              <label className="text-xs font-bold text-gray-600 block">ఫీడ్బ్యాక్ రాయండి / Comments:</label>
              <textarea
                placeholder="మీ అభిప్రాయాన్ని ఇక్కడ తెలపండి"
                value={feedbackComment}
                onChange={(e) => setFeedbackComment(e.target.value)}
                className="w-full p-3 border border-gray-200 rounded-xl text-xs bg-white focus:outline-none focus:ring-1 focus:ring-[#082c75] h-20 resize-none"
              />
            </div>

            <div className="flex gap-3">
              <button
                onClick={() => setActiveRatingBooking(null)}
                className="flex-1 py-2 bg-gray-100 text-gray-600 rounded-xl font-bold text-xs hover:bg-gray-200"
              >
                రద్దు / Cancel
              </button>
              <button
                onClick={() => {
                  alert('Thank you for your rating! ధన్యవాదాలు!');
                  setActiveRatingBooking(null);
                }}
                className="flex-1 py-2 bg-[#082c75] text-[#FFC000] rounded-xl font-bold text-xs hover:bg-[#082c75]/90 shadow-md"
              >
                సమర్పించండి / Submit Review
              </button>
            </div>

          </div>
        </div>
      )}

      {/* 5. Support Contacts Selector Overlay Modal */}
      {showSupportContactsModal && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white text-gray-800 rounded-3xl p-6 max-w-sm w-full shadow-2xl relative border border-gray-100">
            <div className="w-12 h-12 rounded-full bg-emerald-50 flex items-center justify-center mx-auto mb-3 border border-emerald-100">
              <Phone className="w-6 h-6 text-emerald-600" />
            </div>

            <h3 className="text-base font-extrabold text-[#082c75] text-center mb-1">
              📞 కస్టమర్ కేర్ & సపోర్ట్
            </h3>
            <p className="text-[10px] text-gray-500 text-center mb-4">మమ్మల్ని సంప్రదించడానికి నంబర్ ఎంచుకోండి / Select Contact</p>

            <div className="space-y-3 max-h-[250px] overflow-y-auto pr-1 mb-5">
              {customerCarePhone && (
                <a
                  href={`tel:${customerCarePhone}`}
                  className="flex items-center justify-between p-3 bg-blue-50/70 hover:bg-blue-50 border border-blue-100 rounded-2xl transition group"
                >
                  <div className="text-left">
                    <span className="text-[9px] font-bold text-blue-600 uppercase tracking-wider block mb-0.5">ప్రధాన సపోర్ట్ / Primary</span>
                    <span className="text-xs font-black text-slate-800">కస్టమర్ కేర్ (Customer Care)</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className="text-xs font-mono font-bold text-gray-600">{customerCarePhone}</span>
                    <div className="w-7 h-7 rounded-full bg-[#082c75] text-white flex items-center justify-center group-hover:scale-115 transition">
                      <Phone className="w-3.5 h-3.5" />
                    </div>
                  </div>
                </a>
              )}

              {supportNumbersList.length > 0 && (
                <div className="pt-2 border-t border-gray-100 space-y-2">
                  <span className="text-[10px] font-bold text-gray-400 uppercase tracking-wider block">ఇతర సహాయక నంబర్లు / Others</span>
                  {supportNumbersList.map((contact) => (
                    <a
                      key={contact.id}
                      href={`tel:${contact.phone}`}
                      className="flex items-center justify-between p-2.5 bg-slate-50 hover:bg-slate-100 border border-slate-200/60 rounded-xl transition group"
                    >
                      <div className="text-left">
                        <span className="text-xs font-bold text-slate-800">{contact.name}</span>
                      </div>
                      <div className="flex items-center gap-2">
                        <span className="text-xs font-mono text-gray-500">{contact.phone}</span>
                        <div className="w-6.5 h-6.5 rounded-full bg-emerald-600 text-white flex items-center justify-center group-hover:scale-115 transition">
                          <Phone className="w-3 h-3" />
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              )}
            </div>

            <button
              onClick={() => setShowSupportContactsModal(false)}
              className="w-full py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-extrabold rounded-xl text-xs transition text-center"
            >
              రద్దు / Close
            </button>
          </div>
        </div>
      )}

      {/* PROFILE HAMBURGER DRAWER MENU */}
      <AnimatePresence>
        {showProfileMenu && (
          <div className="fixed inset-0 z-50 flex justify-end">
            {/* Backdrop */}
            <div 
              onClick={() => setShowProfileMenu(false)}
              className="absolute inset-0 bg-black/60 backdrop-blur-xs cursor-pointer"
            />

            {/* Slide-out Panel */}
            <div 
              className="relative w-72 max-w-full h-full bg-white shadow-2xl flex flex-col z-10 border-l border-gray-150"
            >
              {/* Header */}
              <div className="bg-[#082c75] text-white p-4 flex justify-between items-center shrink-0">
                <div className="flex items-center gap-2">
                  <div className="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-[#FFC000] font-black text-xs">
                    👤
                  </div>
                  <div>
                    <h4 className="font-extrabold text-xs text-white">మెనూ / Profile Menu</h4>
                    <p className="text-[9px] text-[#FFC000] font-bold">CWRB సివిల్ వర్కర్ బుక్</p>
                  </div>
                </div>
                <button 
                  onClick={() => setShowProfileMenu(false)}
                  className="p-1.5 rounded-lg hover:bg-white/10 text-white transition active:scale-95 text-xs font-bold font-mono cursor-pointer"
                >
                  ✕
                </button>
              </div>

              {/* Menu Options */}
              <div className="flex-1 overflow-y-auto p-4 space-y-3">
                {/* Option 1: Profile Details */}
                <button
                  onClick={() => {
                    setShowProfileMenu(false);
                    setCurrentWorkerScreen('dashboard');
                    alert("మీ ప్రొఫైల్ వివరాలు మరియు గుర్తింపు పత్రాలు క్రింది 'KYC వెరిఫికేషన్' కార్డ్ లో చూడవచ్చు!");
                  }}
                  className="w-full p-3 bg-slate-50 hover:bg-slate-100 border border-gray-150 rounded-xl flex items-center gap-3 transition text-left group active:scale-98 cursor-pointer"
                >
                  <div className="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold shrink-0">
                    👤
                  </div>
                  <div className="min-w-0">
                    <div className="text-xs font-black text-gray-800">ప్రొఫైల్ వివరాలు</div>
                    <div className="text-[10px] text-gray-400 font-bold truncate">Profile Details & KYC Info</div>
                  </div>
                </button>

                {/* Option 2: Subscription */}
                <button
                  onClick={() => {
                    setShowProfileMenu(false);
                    setCurrentWorkerScreen('dashboard');
                    alert("సబ్స్క్రిప్షన్ ప్యాకేజీల వివరాలు మరియు బిల్లింగ్ కార్డ్ క్రింద లభిస్తుంది. మీ ప్రస్తుత ప్లాన్: ఉచిత ట్రయల్!");
                  }}
                  className="w-full p-3 bg-slate-50 hover:bg-slate-100 border border-gray-150 rounded-xl flex items-center gap-3 transition text-left group active:scale-98 cursor-pointer"
                >
                  <div className="w-8 h-8 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center font-bold shrink-0">
                    ⭐
                  </div>
                  <div className="min-w-0">
                    <div className="text-xs font-black text-gray-800">సబ్స్క్రిప్షన్ ప్లాన్స్</div>
                    <div className="text-[10px] text-gray-400 font-bold truncate">Subscription Tiers</div>
                  </div>
                </button>

                {/* Option 3: Wallet */}
                <button
                  onClick={() => {
                    setShowProfileMenu(false);
                    setCurrentWorkerScreen('wallet');
                  }}
                  className="w-full p-3 bg-slate-50 hover:bg-slate-100 border border-gray-150 rounded-xl flex items-center gap-3 transition text-left group active:scale-98 cursor-pointer"
                >
                  <div className="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold shrink-0">
                    💳
                  </div>
                  <div className="min-w-0">
                    <div className="text-xs font-black text-gray-800">వాలెట్ బ్యాలెన్స్</div>
                    <div className="text-[10px] text-gray-400 font-bold truncate">Wallet & Expense Diary</div>
                  </div>
                </button>

                {/* Option 4: Postpaid Bills */}
                <button
                  onClick={() => {
                    setShowProfileMenu(false);
                    setShowPostpaidBillsModal(true);
                  }}
                  className="w-full p-3 bg-slate-50 hover:bg-slate-100 border border-gray-150 rounded-xl flex items-center gap-3 transition text-left group active:scale-98 cursor-pointer"
                >
                  <div className="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold shrink-0">
                    🧾
                  </div>
                  <div className="min-w-0">
                    <div className="text-xs font-black text-gray-800">పోస్ట్పెయిడ్ బిల్లులు</div>
                    <div className="text-[10px] text-gray-400 font-bold truncate">Postpaid Bills & Invoices</div>
                  </div>
                </button>

                {/* Option 5: Settings */}
                <button
                  onClick={() => {
                    setShowProfileMenu(false);
                    setShowMobileSettings(true);
                  }}
                  className="w-full p-3 bg-slate-50 hover:bg-slate-100 border border-gray-150 rounded-xl flex items-center gap-3 transition text-left group active:scale-98 cursor-pointer"
                >
                  <div className="w-8 h-8 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center font-bold shrink-0">
                    ⚙️
                  </div>
                  <div className="min-w-0">
                    <div className="text-xs font-black text-gray-800">యాప్ సెట్టింగ్స్</div>
                    <div className="text-[10px] text-gray-400 font-bold truncate">System Settings & Controls</div>
                  </div>
                </button>
              </div>

              {/* Bottom Brand Stamp */}
              <div className="p-4 bg-slate-50 border-t border-gray-150 text-center text-[10px] text-gray-400 font-black tracking-wider shrink-0 font-mono">
                CWRB v2.1 • SECURE CORE
              </div>
            </div>
          </div>
        )}
      </AnimatePresence>

      {/* POSTPAID BILLS MODAL POPUP */}
      <AnimatePresence>
        {showPostpaidBillsModal && (
          <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
            <div 
              className="bg-white rounded-3xl p-5 max-w-md w-full border border-gray-100 shadow-2xl space-y-4 max-h-[90vh] flex flex-col"
            >
              {/* Header */}
              <div className="flex justify-between items-center border-b border-gray-100 pb-3 shrink-0">
                <div className="flex items-center gap-2">
                  <span className="text-xl">🧾</span>
                  <div>
                    <h4 className="font-extrabold text-sm text-[#082c75]">పోస్ట్‌పెయిడ్ బిల్లుల జాబితా</h4>
                    <p className="text-[10px] text-gray-500 font-bold">Postpaid Ledger & Receipts</p>
                  </div>
                </div>
                <button 
                  onClick={() => setShowPostpaidBillsModal(false)}
                  className="w-7 h-7 rounded-full bg-slate-100 hover:bg-slate-200 text-gray-500 flex items-center justify-center font-black text-xs transition cursor-pointer"
                >
                  ✕
                </button>
              </div>

              {/* Content List */}
              <div className="flex-1 overflow-y-auto space-y-3 pr-1 py-1">
                {postpaidBills.length === 0 ? (
                  <div className="text-center py-8 text-gray-400">
                    <p className="text-xs font-bold">ఎటువంటి బిల్లులు లేవు!</p>
                    <p className="text-[10px] mt-1">ఇన్‌వాయిస్ జనరేటర్ ద్వారా కొత్త బిల్లులను సృష్టించండి.</p>
                  </div>
                ) : (
                  postpaidBills.map((bill) => (
                    <div 
                      key={bill.id}
                      className="p-3.5 bg-slate-50 border border-gray-150 rounded-2xl flex flex-col gap-2.5 relative hover:border-gray-300 transition"
                    >
                      <div className="flex justify-between items-start">
                        <div>
                          <span className="text-[9px] font-black font-mono text-gray-400 block uppercase">BILL ID: {bill.id}</span>
                          <span className="text-xs font-black text-[#082c75]">{bill.customerName}</span>
                        </div>
                        <span className={`px-2 py-0.5 rounded-full text-[8px] font-black uppercase tracking-wider ${
                          bill.status === 'paid' 
                            ? 'bg-emerald-50 text-emerald-600 border border-emerald-200' 
                            : 'bg-amber-50 text-amber-600 border border-amber-200'
                        }`}>
                          {bill.status === 'paid' ? '• చెల్లించబడింది' : '• బాకీ / PENDING'}
                        </span>
                      </div>

                      <div className="text-[11px] text-gray-600 space-y-1 bg-white p-2.5 rounded-xl border border-gray-100 font-medium">
                        <div className="flex justify-between">
                          <span className="text-gray-400 font-bold">పని:</span>
                          <span className="font-extrabold text-gray-800 text-right max-w-[180px] truncate">{bill.workDescription}</span>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-gray-400 font-bold">ఫోన్:</span>
                          <span className="font-mono font-extrabold text-gray-800">{bill.customerPhone}</span>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-gray-400 font-bold">గడువు:</span>
                          <span className="font-extrabold text-red-600">{bill.dueDate}</span>
                        </div>
                      </div>

                      <div className="flex justify-between items-center border-t border-dashed border-gray-200 pt-2 text-xs">
                        <div className="font-black text-gray-800">
                          మొత్తం: <span className="text-[#082c75]">₹ {bill.amount}</span>
                        </div>
                        
                        <div className="flex gap-1.5 shrink-0">
                          {bill.status === 'pending' && (
                            <button
                              onClick={() => {
                                setPostpaidBills(prev => prev.map(b => b.id === bill.id ? { ...b, status: 'paid' } : b));
                              }}
                              className="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white text-[9px] font-extrabold rounded-lg transition active:scale-95 cursor-pointer"
                            >
                              చెల్లింపు పూర్తి
                            </button>
                          )}
                          <button
                            onClick={() => {
                              const text = `CWRB బిల్ రిమైండర్: హలో ${bill.customerName}, మీ పనికి సంబంధించి ₹ ${bill.amount} పోస్ట్‌పెయిడ్ బిల్లు బాకీ ఉంది. గడువు తేదీ: ${bill.dueDate}. దయచేసి త్వరగా చెల్లించండి.`;
                              window.open(`https://api.whatsapp.com/send?phone=91${bill.customerPhone}&text=${encodeURIComponent(text)}`, '_blank');
                            }}
                            className="px-2 py-1 bg-slate-100 hover:bg-slate-200 border border-gray-200 text-slate-700 font-bold rounded-lg text-[9px] flex items-center gap-1 active:scale-95 cursor-pointer"
                            title="WhatsApp Reminder"
                          >
                            💬 రిమైండర్
                          </button>
                        </div>
                      </div>
                    </div>
                  ))
                )}
              </div>

              {/* Bottom Actions */}
              <div className="pt-2 shrink-0">
                <button
                  onClick={() => setShowPostpaidBillsModal(false)}
                  className="w-full py-2.5 bg-[#082c75] text-[#FFC000] rounded-xl font-extrabold text-xs hover:bg-blue-900 transition active:scale-95 text-center cursor-pointer"
                >
                  మూసివేయి / Close
                </button>
              </div>
            </div>
          </div>
        )}
      </AnimatePresence>

      {/* PWA Manual Installation Guide Modal */}
      {showManualInstallModal && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white text-gray-800 rounded-3xl p-6 max-w-md w-full shadow-2xl relative border border-gray-100 overflow-hidden">
            <div className="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-[#082c75] to-[#FFC000]"></div>
            
            <div className="flex justify-between items-center mb-4 mt-2">
              <h3 className="text-base font-extrabold text-[#082c75] flex items-center gap-1.5">
                <span>📲 యాప్ ఇన్‌స్టాల్ గైడ్ (Install Guide)</span>
              </h3>
              <button 
                onClick={() => setShowManualInstallModal(false)}
                className="p-1 rounded-full hover:bg-gray-100 text-gray-400 hover:text-gray-600 transition-colors"
              >
                ✕
              </button>
            </div>

            <p className="text-xs text-gray-600 mb-4 leading-relaxed">
              మీ మొబైల్ హోమ్ స్క్రీన్‌పై బ్రౌజర్ అడ్రస్ బార్ లేకుండా, సింగిల్ క్లిక్‌తో డైరెక్ట్ యాప్ లాగా దీనిని వాడుకోవచ్చు. కింద పేర్కొన్న సాధారణ సూచనలను పాటించండి:
            </p>

            <div className="space-y-4">
              {/* Android Guide */}
              <div className="bg-emerald-50/50 p-3.5 rounded-2xl border border-emerald-100/80">
                <div className="flex items-center gap-2 mb-2 font-black text-xs text-emerald-800">
                  <span className="px-2 py-0.5 rounded-md bg-emerald-600 text-white text-[10px]">Android</span>
                  <span>గూగుల్ క్రోమ్ (Google Chrome)</span>
                </div>
                <ol className="list-decimal list-inside text-xs text-gray-700 space-y-1.5 pl-1 leading-relaxed">
                  <li>మీ బ్రౌజర్ పైన కుడివైపున ఉన్న <strong className="text-emerald-700">3 చుక్కలు (Menu)</strong> ని నొక్కండి.</li>
                  <li>కిందికి స్క్రోల్ చేసి <strong className="text-emerald-700">"Add to Home screen"</strong> లేదా <strong className="text-emerald-700">"Install app"</strong> ని ఎంచుకోండి.</li>
                  <li>పాప్-అప్ వచ్చినప్పుడు <strong className="text-emerald-700">"Install"</strong> పై క్లిక్ చేయండి.</li>
                </ol>
              </div>

              {/* iOS / iPhone Guide */}
              <div className="bg-blue-50/50 p-3.5 rounded-2xl border border-blue-100/80">
                <div className="flex items-center gap-2 mb-2 font-black text-xs text-blue-800">
                  <span className="px-2 py-0.5 rounded-md bg-blue-600 text-white text-[10px]">iOS / iPhone</span>
                  <span>సఫారి బ్రౌజర్ (Safari)</span>
                </div>
                <ol className="list-decimal list-inside text-xs text-gray-700 space-y-1.5 pl-1 leading-relaxed">
                  <li>సఫారి బ్రౌజర్ కింద ఉండే <strong className="text-blue-700">"Share" ఐకాన్ (పైకి బాణం గుర్తు 📤)</strong> ని నొక్కండి.</li>
                  <li>లిస్టు లో కిందికి స్క్రోల్ చేసి <strong className="text-blue-700">"Add to Home Screen" (హోమ్ స్క్రీన్‌కి జోడించు)</strong> ని ఎంచుకోండి.</li>
                  <li>పైన కుడివైపున ఉన్న <strong className="text-blue-700">"Add" (జోడించు)</strong> బటన్ నొక్కండి.</li>
                </ol>
              </div>
            </div>

            <div className="mt-5 flex gap-3">
              <button
                onClick={() => setShowManualInstallModal(false)}
                className="w-full py-2.5 bg-[#082c75] text-[#FFC000] rounded-xl font-extrabold text-xs hover:bg-[#001040] shadow-md transition-all active:scale-95 text-center"
              >
                అర్థమైంది (Understood)
              </button>
            </div>

          </div>
        </div>
      )}

      {showAppWalkthrough && (
        <AppGuideWalkthrough 
          onClose={() => {
            setShowAppWalkthrough(false);
            localStorage.setItem('cwb_onboarding_shown', 'true');
          }} 
          accentColor={accentColor}
        />
      )}




      {/* Footer copyright */}
      {!isStandaloneOrMobile && (
        <footer className="bg-[#082c75] text-white/60 text-center py-4 text-xs mt-auto border-t border-white/10 font-mono">
          <div>© 2026 Civil Worker Relation Book (CWRB). Designed with Dual Control & 44 UI/UX Blueprint Mandates.</div>
          <div className="text-[10px] text-[#FFC000]/60 mt-1">అన్ని హక్కులూ రిజర్వ్ చేయబడ్డాయి • All Rights Reserved.</div>
        </footer>
      )}

      {/* Custom Toasts for smooth button interactions */}
      <div className="fixed bottom-24 left-1/2 -translate-x-1/2 z-[9999] flex flex-col gap-2 pointer-events-none w-full max-w-sm px-4">
        {toasts.map(t => (
          <div key={t.id} className="bg-slate-900 text-white text-[11px] sm:text-xs font-bold px-4 py-3 rounded-xl shadow-2xl  text-center border border-slate-700">
            {t.message}
          </div>
        ))}
      </div>


    </div>
      );
}

// =========================================================
// INVOICE GENERATOR COMPONENT (FEATURE 15)
// =========================================================
function InvoiceGeneratorComponent({ 
  isUpgraded, 
  onAddPostpaidBill 
}: { 
  isUpgraded: boolean; 
  postpaidBills: PostpaidBill[]; 
  onAddPostpaidBill: (bill: PostpaidBill) => void;
}) {
  const [customerName, setCustomerName] = useState('');
  const [customerPhone, setCustomerPhone] = useState('');
  const [workDescription, setWorkDescription] = useState('');
  const [amount, setAmount] = useState('');
  const [dueDate, setDueDate] = useState(() => {
    const d = new Date();
    d.setDate(d.getDate() + 7);
    return d.toISOString().split('T')[0];
  });
  
  const [lastGeneratedBill, setLastGeneratedBill] = useState<PostpaidBill | null>(null);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!customerName.trim() || !customerPhone.trim() || !workDescription.trim() || !amount) {
      alert("దయచేసి అన్ని వివరాలను పూరించండి!");
      return;
    }
    
    const phoneRegex = /^[6-9]\d{9}$/;
    if (!phoneRegex.test(customerPhone.trim())) {
      alert("దయచేసి సరైన 10 అంకెల మొబైల్ నెంబర్ ఎంటర్ చేయండి!");
      return;
    }

    const billAmt = parseFloat(amount);
    if (isNaN(billAmt) || billAmt <= 0) {
      alert("దయచేసి సరైన బిల్లు మొత్తాన్ని నమోదు చేయండి!");
      return;
    }

    const newBill: PostpaidBill = {
      id: `CWRB-PB-${Math.floor(100 + Math.random() * 900)}`,
      customerName: customerName.trim(),
      customerPhone: customerPhone.trim(),
      workDescription: workDescription.trim(),
      amount: billAmt,
      date: new Date().toISOString().split('T')[0],
      dueDate: dueDate,
      status: 'pending'
    };

    onAddPostpaidBill(newBill);
    setLastGeneratedBill(newBill);

    // Reset form
    setCustomerName('');
    setCustomerPhone('');
    setWorkDescription('');
    setAmount('');
  };

  if (lastGeneratedBill) {
    return (
      <div className={`bg-white rounded-2xl p-5 shadow-lg border border-emerald-100 space-y-4  ${
        isUpgraded ? 'ring-2 ring-[#FFC000]' : ''
      }`}>
        <div className="text-center space-y-1">
          <div className="w-12 h-12 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-600 mx-auto border border-emerald-100 shadow-sm animate-bounce">
            <Check className="w-6 h-6 stroke-[3]" />
          </div>
          <h4 className="font-extrabold text-sm text-[#082c75] mt-2">పోస్ట్‌పెయిడ్ బిల్లు సృష్టించబడింది!</h4>
          <p className="text-[10px] text-gray-500 font-semibold uppercase tracking-wider">Bill Registered Under Postpaid</p>
        </div>

        {/* Realistic Invoice Slip */}
        <div className="bg-slate-50 rounded-xl p-4 border border-gray-200/60 font-mono text-xs space-y-3 shadow-inner relative overflow-hidden">
          {/* Top aesthetic dashed line separator */}
          <div className="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500" />
          
          <div className="flex justify-between items-center text-[10px] text-gray-400 font-bold">
            <span>INVOICE ID: {lastGeneratedBill.id}</span>
            <span>తేదీ: {lastGeneratedBill.date}</span>
          </div>

          <div className="border-b border-dashed border-gray-300 pb-2.5">
            <div className="font-black text-[#082c75] text-[11px] mb-1">CWRB సివిల్ వర్కర్ బుక్</div>
            <div className="text-[9px] text-gray-400 font-bold leading-normal">Civil Worker Customer Relation Book</div>
          </div>

          <div className="space-y-1.5 text-[11px] text-gray-700">
            <div className="flex justify-between">
              <span className="text-gray-400 font-bold">కస్టమర్ పేరు:</span>
              <span className="font-bold text-gray-900">{lastGeneratedBill.customerName}</span>
            </div>
            <div className="flex justify-between">
              <span className="text-gray-400 font-bold">మొబైల్ నెంబర్:</span>
              <span className="font-bold text-gray-900">{lastGeneratedBill.customerPhone}</span>
            </div>
            <div className="flex justify-between">
              <span className="text-gray-400 font-bold">పని వివరాలు:</span>
              <span className="font-bold text-gray-900 text-right max-w-[150px] truncate">{lastGeneratedBill.workDescription}</span>
            </div>
            <div className="flex justify-between">
              <span className="text-gray-400 font-bold">చెల్లింపు గడువు:</span>
              <span className="font-bold text-red-600">{lastGeneratedBill.dueDate}</span>
            </div>
          </div>

          <div className="border-t border-dashed border-gray-300 pt-2.5 flex justify-between items-center">
            <span className="font-black text-gray-900">బిల్లు మొత్తం / Total:</span>
            <span className="text-base font-black text-[#082c75]">₹ {lastGeneratedBill.amount} /-</span>
          </div>
        </div>

        {/* Action Buttons */}
        <div className="grid grid-cols-2 gap-2">
          <button
            onClick={() => {
              alert(`ఇన్‌వాయిస్ ${lastGeneratedBill.id} ప్రింట్ చెయ్యడానికి పంపబడింది!`);
            }}
            className="py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 text-[10px] font-bold rounded-xl border border-slate-200 transition active:scale-95 text-center flex items-center justify-center gap-1.5"
          >
            🖨️ ప్రింట్ చేయi / Print
          </button>
          <button
            onClick={() => {
              const text = `CWRB పోస్ట్‌పెయిడ్ బిల్లు: హలో ${lastGeneratedBill.customerName}, మీ పనికి సంబంధించి ₹ ${lastGeneratedBill.amount} కి బిల్లు జనరేట్ చేయబడింది. గడువు తేదీ: ${lastGeneratedBill.dueDate}. సివిల్ వర్కర్ బుక్.`;
              window.open(`https://api.whatsapp.com/send?phone=91${lastGeneratedBill.customerPhone}&text=${encodeURIComponent(text)}`, '_blank');
            }}
            className="py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-[10px] font-bold rounded-xl shadow-sm transition active:scale-95 text-center flex items-center justify-center gap-1.5"
          >
            💬 వాట్సాప్ షేర్ / WhatsApp
          </button>
        </div>

        <button
          onClick={() => setLastGeneratedBill(null)}
          className="w-full py-2 bg-slate-50 hover:bg-slate-100 text-slate-500 hover:text-slate-700 text-[10px] font-bold rounded-xl border border-gray-150 transition active:scale-95 text-center block mt-2"
        >
          మరొక ఇన్‌వాయిస్ సృష్టించండి / New Invoice
        </button>
      </div>
    );
  }

  return (
    <div className={`bg-white rounded-2xl p-5 shadow-lg border border-gray-100 space-y-4 ${
      isUpgraded ? 'ring-2 ring-[#FFC000]' : ''
    }`}>
      <div>
        <h4 className="font-bold text-sm text-[#082c75] flex items-center gap-1.5">
          <FileText className="w-4.5 h-4.5 text-[#082c75]" />
          <span>ఇన్‌వాయిస్ జనరేటర్ (Invoice Generator & Postpaid System)</span>
        </h4>
        <p className="text-xs text-gray-500">కస్టమర్ల కొరకు ఉచిత పోస్ట్‌పెయిడ్ ఇన్‌వాయిస్ బిల్లులు సృష్టించండి</p>
      </div>

      <form onSubmit={handleSubmit} className="space-y-3.5">
        <div className="grid grid-cols-2 gap-2.5">
          <div className="space-y-1">
            <label className="block text-[10px] font-bold text-gray-500 uppercase tracking-wide">కస్టమర్ పేరు / Cust Name</label>
            <input
              type="text"
              value={customerName}
              onChange={(e) => setCustomerName(e.target.value)}
              placeholder="కస్టమర్ పూర్తి పేరు"
              className="w-full p-2 bg-slate-50 border border-gray-200 rounded-xl text-xs focus:ring-1 focus:ring-[#082c75] focus:outline-none text-gray-800 font-bold"
            />
          </div>

          <div className="space-y-1">
            <label className="block text-[10px] font-bold text-gray-500 uppercase tracking-wide">మొబైల్ నెంబర్ / Mobile</label>
            <input
              type="tel"
              value={customerPhone}
              onChange={(e) => setCustomerPhone(e.target.value)}
              placeholder="10 అంకెల ఫోన్ నెంబర్"
              maxLength={10}
              className="w-full p-2 bg-slate-50 border border-gray-200 rounded-xl text-xs font-mono focus:ring-1 focus:ring-[#082c75] focus:outline-none text-gray-800 font-bold"
            />
          </div>
        </div>

        <div className="space-y-1">
          <label className="block text-[10px] font-bold text-gray-500 uppercase tracking-wide">పని వివరాలు / Work Description</label>
          <input
            type="text"
            value={workDescription}
            onChange={(e) => setWorkDescription(e.target.value)}
            placeholder="ఉదా: కొత్త రూమ్ ప్లాస్టరింగ్ / వాల్ పెయింటింగ్"
            className="w-full p-2 bg-slate-50 border border-gray-200 rounded-xl text-xs focus:ring-1 focus:ring-[#082c75] focus:outline-none text-gray-800 font-bold"
          />
        </div>

        <div className="grid grid-cols-2 gap-2.5">
          <div className="space-y-1">
            <label className="block text-[10px] font-bold text-gray-500 uppercase tracking-wide">బిల్లు మొత్తం / Amount (₹)</label>
            <input
              type="number"
              value={amount}
              onChange={(e) => setAmount(e.target.value)}
              placeholder="మొత్తం (రూపాయలు)"
              className="w-full p-2 bg-slate-50 border border-gray-200 rounded-xl text-xs font-mono focus:ring-1 focus:ring-[#082c75] focus:outline-none text-gray-800 font-black text-[#082c75]"
            />
          </div>

          <div className="space-y-1">
            <label className="block text-[10px] font-bold text-gray-500 uppercase tracking-wide">చెల్లింపు గడువు / Due Date</label>
            <input
              type="date"
              value={dueDate}
              onChange={(e) => setDueDate(e.target.value)}
              className="w-full p-2 bg-slate-50 border border-gray-200 rounded-xl text-xs font-mono focus:ring-1 focus:ring-[#082c75] focus:outline-none text-gray-800 font-bold"
            />
          </div>
        </div>

        <button
          type="submit"
          className="w-full py-3 bg-[#082c75] hover:bg-opacity-90 text-white font-extrabold text-[11px] rounded-xl border border-blue-900/45 transition active:scale-95 flex items-center justify-center gap-1.5 shadow-sm cursor-pointer mt-1"
        >
          <span>🧾</span>
          <span>బిల్లును జనరేట్ చేయి & పోస్ట్‌పెయిడ్‌కి జోడించు</span>
        </button>
      </form>
    </div>
  );
}
