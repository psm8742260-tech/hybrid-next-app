                <div className="p-1 rounded-lg bg-yellow-100 text-yellow-800 border border-yellow-300">
                  <div>పర్మనెంట్ అప్గ్రేడ్</div>
                  <div className="text-[7px] opacity-80 mt-0.5">P-UPG</div>
                </div>
                <div className="p-1 rounded-lg bg-teal-100 text-teal-800 border border-teal-300">
                  <div>పర్మనెంట్ ఆన్</div>
                  <div className="text-[7px] opacity-80 mt-0.5">P-ON</div>
                </div>
