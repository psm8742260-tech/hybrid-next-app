                        </div>
                        <span className={`text-[8px] mt-1 tracking-tight transition-all ${currentWorkerScreen === 'wallet' ? 'text-[#082c75] font-black' : 'text-gray-400 font-bold'}`}>{t('wallet', language)}</span>
