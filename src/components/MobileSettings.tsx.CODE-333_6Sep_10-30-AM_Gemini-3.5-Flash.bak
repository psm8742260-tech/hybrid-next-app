import React, { useState } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { 
  Settings, User, Bell, Shield, Database, HelpCircle, X, ChevronRight, 
  Sparkles, Check, Trash2, Fingerprint, Key, ShieldAlert, ShieldCheck, RefreshCw, Volume2, Globe,
  Eye, EyeOff
} from 'lucide-react';
import { t, Language, translations } from '../lib/translations';

interface MobileSettingsProps {
  isOpen: boolean;
  onClose: () => void;
  onOpenAdminPanel: () => void;
  userEmail: string;
  userPhone: string;
  accentColor: string;
  onAccentColorChange: (color: string) => void;
  language: Language;
  onLanguageChange: (lang: Language) => void;
  soundOn: boolean;
  onSoundToggle: (on: boolean) => void;
  smsOn: boolean;
  onSmsToggle: (on: boolean) => void;
  showPhoneOnMap: boolean;
  onShowPhoneOnMapToggle: (show: boolean) => void;
  onLogout: () => void;
  onForceUpdate: () => void;
}

export default function MobileSettings({
  isOpen,
  onClose,
  onOpenAdminPanel,
  userEmail,
  userPhone,
  accentColor,
  onAccentColorChange,
  language,
  onLanguageChange,
  soundOn,
  onSoundToggle,
  smsOn,
  onSmsToggle,
  showPhoneOnMap,
  onShowPhoneOnMapToggle,
  onLogout,
  onForceUpdate
}: MobileSettingsProps) {
  const [activeSection, setActiveSection] = useState<'main' | 'profile' | 'notifications' | 'privacy' | 'storage' | 'help' | 'admin_lock'>('main');

  const cleanUserPhone = userPhone ? userPhone.replace(/\s+/g, '').trim() : '';
  const isUserAdmin = ['psm8742260@gmail.com', '+918466062260', '8466062260', '+91 8466062260', 'psm8742260'].includes(cleanUserPhone);

  // Cache Cleaner state
  const [cacheSize, setCacheSize] = useState<number>(12.4);
  const [isCleaning, setIsCleaning] = useState(false);
  const [cleanFinished, setCleanFinished] = useState(false);

  // Admin PIN & Biometrics locks
  const [password, setPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [showPinHint, setShowPinHint] = useState(false);
  const [fingerprintScanning, setFingerprintScanning] = useState(false);
  const [fingerprintScanned, setFingerprintScanned] = useState(false);
  const [adminError, setAdminError] = useState('');

  const accents: { id: string; nameKey: keyof typeof translations; hex: string; border: string }[] = [
    { id: 'blue', nameKey: 'royal_blue', hex: '#082c75', border: 'border-blue-900 bg-[#082c75]' },
    { id: 'gold', nameKey: 'golden_yellow', hex: '#FFC000', border: 'border-yellow-600 bg-[#FFC000]' },
    { id: 'green', nameKey: 'emerald_green', hex: '#10b981', border: 'border-emerald-700 bg-[#10b981]' },
    { id: 'crimson', nameKey: 'crimson_red', hex: '#e11d48', border: 'border-rose-700 bg-[#e11d48]' },
  ];

  if (!isOpen) return null;

  const handleCleanCache = () => {
    setIsCleaning(true);
    setCleanFinished(false);
    setTimeout(() => {
      setIsCleaning(false);
      setCleanFinished(true);
      setCacheSize(0);
      setTimeout(() => {
        setCleanFinished(false);
      }, 3000);
    }, 2000);
  };

  const handleFingerprintTouch = () => {
    if (fingerprintScanned || fingerprintScanning) return;
    setFingerprintScanning(true);
    setAdminError('');

    setTimeout(() => {
      setFingerprintScanning(false);
      setFingerprintScanned(true);
    }, 1500);
  };

  const handleVerifyAdminAccess = (e: React.FormEvent) => {
    e.preventDefault();
    setAdminError('');

    const savedAdminPwd = localStorage.getItem('cwb_admin_pwd') || '1234';

    if (password !== savedAdminPwd) {
      setAdminError(`తప్పుడు పాస్‌వర్డ్! దయచేసి సరైన కోడ్ ఎంటర్ చేయండి. (PIN: ${savedAdminPwd})`);
      return;
    }

    if (!fingerprintScanned) {
      setAdminError('దయచేసి బయోమెట్రిక్ వెరిఫికేషన్ కోసం ఫింగర్‌ప్రింట్ ఐకాన్ నొక్కండి!');
      return;
    }

    // Success! Unlock master admin switchboard panel
    onOpenAdminPanel();
    onClose();
  };

  return (
    <div className="absolute inset-0 bg-slate-900/85 backdrop-blur-xs z-50 flex flex-col justify-end">
      
      {/* Phone Settings Sheet */}
      <div className="bg-white rounded-t-[32px] max-h-[92%] overflow-hidden flex flex-col shadow-2xl border-t-4 border-[#082c75]">
        
        {/* Settings Header Bar */}
        <div className="bg-slate-50 border-b border-gray-150 py-3.5 px-5 flex justify-between items-center shrink-0">
          <div className="flex items-center gap-2">
            <Settings className="w-5 h-5 text-[#082c75] animate-spin" style={{ animationDuration: '10s' }} />
            <div>
              <h3 className="text-xs font-black text-[#082c75] uppercase">{t('app_settings_header', language)}</h3>
              <p className="text-[8px] text-gray-500 font-bold">{t('preferences_panel', language)}</p>
            </div>
          </div>
          <button 
            onClick={onClose}
            className="p-1.5 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 transition"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Dynamic Nested Screen Sections Container */}
        <div className="flex-1 overflow-y-auto p-5">
          <AnimatePresence mode="wait">
            
            {activeSection === 'main' && (
              /* MAIN PREFERENCES HOME VIEW */
              <motion.div
                key="settings-main"
                initial={{ opacity: 0, x: -15 }}
                animate={{ opacity: 1, x: 0 }}
                exit={{ opacity: 0, x: 15 }}
                className="space-y-4"
              >
                {/* User Profile Header bar */}
                <div 
                  onClick={() => setActiveSection('profile')}
                  className="bg-gradient-to-r from-[#082c75]/5 to-slate-100 p-3.5 rounded-2xl border border-[#082c75]/10 flex items-center justify-between cursor-pointer hover:brightness-98 transition"
                >
                  <div className="flex items-center gap-3">
                    <div className="w-11 h-11 rounded-full bg-[#082c75] text-white flex items-center justify-center font-black text-xs border-2 border-white shadow-md">
                      {isUserAdmin ? 'AD' : (userPhone && userPhone.includes('@') ? userPhone.slice(0, 2).toUpperCase() : 'CW')}
                    </div>
                    <div>
                      <h4 className="font-extrabold text-xs text-gray-800 truncate max-w-[170px]">
                        {isUserAdmin ? 'హాయ్ అడ్మిన్ గారు! / Hi Admin!' : t('civil_worker_member', language)}
                      </h4>
                      <p className="text-[9px] text-gray-500 font-mono mt-0.5">
                        {isUserAdmin ? 'సివిల్ వర్కర్ అడ్మిన్ / App Owner' : t('privacy_hidden', language)}
                      </p>
                    </div>
                  </div>
                  <ChevronRight className="w-4 h-4 text-gray-400" />
                </div>

                {/* Accent Color Switcher Section */}
                <div className="bg-slate-50 p-3.5 rounded-2xl border border-gray-150 space-y-2">
                  <div className="flex items-center justify-between">
                    <span className="text-[10px] font-black text-gray-500 uppercase">{t('appearance_themes', language)}</span>
                    <span className="text-[9px] text-gray-400 font-bold">{t('dynamic_accent', language)}</span>
                  </div>
                  <div className="grid grid-cols-4 gap-2 pt-1">
                    {accents.map((acc) => {
                      const active = accentColor === acc.id;
                      return (
                        <button
                          key={acc.id}
                          onClick={() => onAccentColorChange(acc.id)}
                          className={`p-1.5 rounded-xl border flex flex-col items-center justify-center gap-1.5 transition-all hover:bg-white ${
                            active ? 'border-[#082c75] bg-white ring-1 ring-[#082c75]/30 scale-105' : 'border-gray-100 bg-slate-100'
                          }`}
                        >
                          <span className={`w-5.5 h-5.5 rounded-full ${acc.border} flex items-center justify-center text-white`}>
                            {active && <Check className="w-3.5 h-3.5 stroke-[3.5]" />}
                          </span>
                          <span className="text-[8px] font-bold text-gray-600 truncate max-w-[55px]">{t(acc.nameKey, language)}</span>
                        </button>
                      );
                    })}
                  </div>
                </div>

                {/* Language Switcher Section */}
                <div className="bg-slate-50 p-3.5 rounded-2xl border border-gray-150 space-y-3">
                  <div className="flex items-center gap-2">
                    <Globe className="w-4 h-4 text-[#082c75]" />
                    <div>
                      <span className="text-[11px] font-extrabold text-gray-700 block">
                        {t('language_selection', language)}
                      </span>
                      <span className="text-[8px] text-gray-400 font-bold">{t('switch_preference', language)}</span>
                    </div>
                  </div>
                  
                  <div className="grid grid-cols-3 gap-2">
                    {[
                      { id: 'te', label: 'తెలుగు' },
                      { id: 'en', label: 'English' },
                      { id: 'hi', label: 'हिन्दी' },
                      { id: 'kn', label: 'ಕನ್ನಡ' },
                      { id: 'ta', label: 'தமிழ்' }
                    ].map((lang) => {
                      const active = language === lang.id;
                      return (
                        <button
                          key={lang.id}
                          onClick={() => onLanguageChange(lang.id as any)}
                          className={`py-2 px-1 rounded-xl border text-[10px] font-black transition-all flex flex-col items-center justify-center gap-1 ${
                            active 
                              ? 'bg-[#082c75] text-[#FFC000] border-[#082c75] shadow-sm' 
                              : 'bg-white text-gray-500 border-gray-200 hover:border-[#082c75]/30'
                          }`}
                        >
                          <span>{lang.label}</span>
                          {active && <div className="w-1 h-1 rounded-full bg-[#FFC000]" />}
                        </button>
                      );
                    })}
                  </div>
                </div>

                {/* List Menu Options */}
                <div className="bg-white rounded-2xl border border-gray-150 overflow-hidden divide-y divide-gray-100">
                  {/* Notifications Switch link */}
                  <div 
                    onClick={() => setActiveSection('notifications')}
                    className="p-3.5 flex items-center justify-between hover:bg-slate-50 cursor-pointer transition text-xs"
                  >
                    <div className="flex items-center gap-3">
                      <div className="p-1.5 bg-blue-50 text-[#082c75] rounded-lg">
                        <Bell className="w-4.5 h-4.5" />
                      </div>
                      <div>
                        <span className="font-extrabold text-gray-800 block">{t('notifications', language)}</span>
                        <span className="text-[8px] text-gray-400 font-semibold">{t('notifications_desc', language)}</span>
                      </div>
                    </div>
                    <ChevronRight className="w-4 h-4 text-gray-400" />
                  </div>

                  {/* Security & Privacy Switch link */}
                  <div 
                    onClick={() => setActiveSection('privacy')}
                    className="p-3.5 flex items-center justify-between hover:bg-slate-50 cursor-pointer transition text-xs"
                  >
                    <div className="flex items-center gap-3">
                      <div className="p-1.5 bg-emerald-50 text-emerald-600 rounded-lg">
                        <Shield className="w-4.5 h-4.5" />
                      </div>
                      <div>
                        <span className="font-extrabold text-gray-800 block">{t('security_privacy', language)}</span>
                        <span className="text-[8px] text-gray-400 font-semibold">{t('security_privacy_desc', language)}</span>
                      </div>
                    </div>
                    <ChevronRight className="w-4 h-4 text-gray-400" />
                  </div>

                  {/* Storage / Diagnostics link */}
                  <div 
                    onClick={() => setActiveSection('storage')}
                    className="p-3.5 flex items-center justify-between hover:bg-slate-50 cursor-pointer transition text-xs"
                  >
                    <div className="flex items-center gap-3">
                      <div className="p-1.5 bg-indigo-50 text-indigo-600 rounded-lg">
                        <Database className="w-4.5 h-4.5" />
                      </div>
                      <div>
                        <span className="font-extrabold text-gray-800 block">{t('memory_diagnostics', language)}</span>
                        <span className="text-[8px] text-gray-400 font-semibold">{t('memory_diagnostics_desc', language)}</span>
                      </div>
                    </div>
                    <ChevronRight className="w-4 h-4 text-gray-400" />
                  </div>

                  {/* Help Support Helpdesk */}
                  <div 
                    onClick={() => setActiveSection('help')}
                    className="p-3.5 flex items-center justify-between hover:bg-slate-50 cursor-pointer transition text-xs"
                  >
                    <div className="flex items-center gap-3">
                      <div className="p-1.5 bg-amber-50 text-amber-600 rounded-lg">
                        <HelpCircle className="w-4.5 h-4.5" />
                      </div>
                      <div>
                        <span className="font-extrabold text-gray-800 block">{t('helpline_support', language)}</span>
                        <span className="text-[8px] text-gray-400 font-semibold">{t('helpline_support_desc', language)}</span>
                      </div>
                    </div>
                    <ChevronRight className="w-4 h-4 text-gray-400" />
                  </div>
                </div>

                {/* LOCKED MASTER ADMIN ACCESS BUTTON - REPLACED WITH SINGLE SETTINGS ICON */}
                {isUserAdmin && (
                  <div className="flex justify-end pr-4 pt-2">
                    <button 
                      onClick={() => setActiveSection('admin_lock')}
                      className="p-3 bg-slate-100 hover:bg-slate-200 text-[#082c75] rounded-full transition shadow-xs hover:scale-110 active:scale-95 inline-flex items-center justify-center cursor-pointer border border-gray-200"
                      title="అడ్మిన్ సెట్టింగ్స్ / Admin Settings"
                    >
                      <Settings className="w-5 h-5 hover:rotate-90 transition-transform duration-300" />
                    </button>
                  </div>
                )}
              </motion.div>
            )}

            {activeSection === 'profile' && (
              /* NESTED PAGE: PROFILE INFO */
              <motion.div
                key="settings-profile"
                initial={{ opacity: 0, x: 15 }}
                animate={{ opacity: 1, x: 0 }}
                exit={{ opacity: 0, x: -15 }}
                className="space-y-4"
              >
                <button onClick={() => setActiveSection('main')} className="text-xs font-black text-[#082c75] hover:underline flex items-center gap-1 mb-2">
                  ← {t('go_back', language)}
                </button>

                <h4 className="font-extrabold text-xs text-gray-800 border-b border-gray-150 pb-2">{t('member_profile', language)}</h4>
                
                <div className="space-y-3 bg-slate-50 p-4 rounded-2xl border border-gray-150 text-xs">
                  <div className="space-y-0.5">
                    <span className="text-[9px] font-bold text-gray-400 block uppercase">{t('account_email', language)}:</span>
                    <span className="font-black text-gray-800 break-all">{isUserAdmin ? (userPhone && userPhone.includes('@') ? userPhone : 'psm8742260@gmail.com') : t('privacy_hidden', language)}</span>
                  </div>

                  <div className="space-y-0.5">
                    <span className="text-[9px] font-bold text-gray-400 block uppercase">{t('registered_phone', language)}:</span>
                    <span className="font-black text-gray-800 font-mono">{isUserAdmin ? (!userPhone.includes('@') ? userPhone : '+91 8466062260') : t('privacy_hidden', language)}</span>
                  </div>

                  <div className="space-y-0.5">
                    <span className="text-[9px] font-bold text-gray-400 block uppercase">సిస్టమ్ క్యాపబిలిటీ (Capability Level):</span>
                    <span className="font-black text-emerald-700">SUPER USER MODE (Dual Controller)</span>
                  </div>

                  <div className="space-y-0.5">
                    <span className="text-[9px] font-bold text-gray-400 block uppercase">నమోదైన తేదీ (Registration Date):</span>
                    <span className="font-mono text-gray-700">July 16, 2026</span>
                  </div>
                </div>

                <button
                  type="button"
                  onClick={onLogout}
                  className="w-full py-2.5 bg-rose-600 hover:bg-rose-500 text-white font-extrabold rounded-xl text-xs transition active:scale-95"
                >
                  {language === 'en' ? 'Logout Member' : language === 'hi' ? 'सदस्य लॉग आउट करें' : language === 'kn' ? 'ಸದಸ್ಯ ಲಾಗ್ ಔಟ್ ಮಾಡಿ' : language === 'ta' ? 'உறுப்பினர் வெளியேறு' : 'మెంబర్ లాగ్ అవుట్ చేయి'}
                </button>
              </motion.div>
            )}

            {activeSection === 'notifications' && (
              /* NESTED PAGE: NOTIFICATIONS PREFERENCES */
              <motion.div
                key="settings-notif"
                initial={{ opacity: 0, x: 15 }}
                animate={{ opacity: 1, x: 0 }}
                exit={{ opacity: 0, x: -15 }}
                className="space-y-4"
              >
                <button onClick={() => setActiveSection('main')} className="text-xs font-black text-[#082c75] hover:underline flex items-center gap-1 mb-2">
                  ← వెనుకకు / Go Back
                </button>

                <h4 className="font-extrabold text-xs text-gray-800 border-b border-gray-150 pb-2">నోటిఫికేషన్ నియంత్రణలు / Notifications</h4>

                <div className="space-y-3 bg-white border border-gray-150 rounded-2xl p-4 divide-y divide-gray-150 text-xs">
                  {/* Sound on/off switch */}
                  <div className="flex items-center justify-between py-2">
                    <div>
                      <span className="font-extrabold text-gray-800 block">సౌండ్స్ & అలర్ట్ శబ్దాలు (Sounds)</span>
                      <span className="text-[9px] text-gray-400 font-semibold">Play audio clicks and alarms effects</span>
                    </div>
                    <button
                      onClick={() => onSoundToggle(!soundOn)}
                      className={`w-12 h-6 rounded-full p-0.5 transition-all duration-300 ${
                        soundOn ? 'bg-emerald-500' : 'bg-gray-300'
                      }`}
                    >
                      <div className={`w-5 h-5 rounded-full bg-white shadow-md transform transition-all duration-300 ${
                        soundOn ? 'translate-x-6' : 'translate-x-0'
                      }`} />
                    </button>
                  </div>

                  {/* SMS alerts */}
                  <div className="flex items-center justify-between py-2.5">
                    <div>
                      <span className="font-extrabold text-gray-800 block">SMS బుకింగ్స్ నోటిఫికేషన్లు (SMS)</span>
                      <span className="text-[9px] text-gray-400 font-semibold">Receive direct SMS summaries on alerts</span>
                    </div>
                    <button
                      onClick={() => onSmsToggle(!smsOn)}
                      className={`w-12 h-6 rounded-full p-0.5 transition-all duration-300 ${
                        smsOn ? 'bg-emerald-500' : 'bg-gray-300'
                      }`}
                    >
                      <div className={`w-5 h-5 rounded-full bg-white shadow-md transform transition-all duration-300 ${
                        smsOn ? 'translate-x-6' : 'translate-x-0'
                      }`} />
                    </button>
                  </div>

                  {/* Job alert alerts */}
                  <div className="flex items-center justify-between py-2.5">
                    <div>
                      <span className="font-extrabold text-gray-800 block">లైవ్ పని అలర్ట్ రిమైండర్లు</span>
                      <span className="text-[9px] text-gray-400 font-semibold">Immediate push triggers for local lead bookings</span>
                    </div>
                    <span className="text-[9px] font-black text-[#082c75] bg-[#FFC000]/20 py-0.5 px-2 rounded-full border border-[#FFC000]">
                      ALWAYS ACTIVE
                    </span>
                  </div>
                </div>
              </motion.div>
            )}

            {activeSection === 'privacy' && (
              /* NESTED PAGE: SECURITY & PRIVACY PREFERENCES */
              <motion.div
                key="settings-privacy"
                initial={{ opacity: 0, x: 15 }}
                animate={{ opacity: 1, x: 0 }}
                exit={{ opacity: 0, x: -15 }}
                className="space-y-4"
              >
                <button onClick={() => setActiveSection('main')} className="text-xs font-black text-[#082c75] hover:underline flex items-center gap-1 mb-2">
                  ← వెనుకకు / Go Back
                </button>

                <h4 className="font-extrabold text-xs text-gray-800 border-b border-gray-150 pb-2">భద్రత మరియు ప్రైవసీ / Security & Privacy</h4>

                <div className="space-y-3 bg-white border border-gray-150 rounded-2xl p-4 divide-y divide-gray-150 text-xs">
                  {/* Hide Number on Map */}
                  <div className="flex items-center justify-between py-2">
                    <div>
                      <span className="font-extrabold text-gray-800 block">మ్యాప్‌లో మొబైల్ చూపించు (Show Phone)</span>
                      <span className="text-[9px] text-gray-400 font-semibold">Expose phone number to nearby public on map</span>
                    </div>
                    <button
                      onClick={() => onShowPhoneOnMapToggle(!showPhoneOnMap)}
                      className={`w-12 h-6 rounded-full p-0.5 transition-all duration-300 ${
                        showPhoneOnMap ? 'bg-emerald-500' : 'bg-gray-300'
                      }`}
                    >
                      <div className={`w-5 h-5 rounded-full bg-white shadow-md transform transition-all duration-300 ${
                        showPhoneOnMap ? 'translate-x-6' : 'translate-x-0'
                      }`} />
                    </button>
                  </div>

                  {/* Location tracking Accuracy */}
                  <div className="flex items-center justify-between py-2.5">
                    <div>
                      <span className="font-extrabold text-gray-800 block">హై-ఆక్యురసీ GPS కేటాయింపు</span>
                      <span className="text-[9px] text-gray-400 font-semibold">Use high precision hardware GPS tracking</span>
                    </div>
                    <span className="text-[8px] bg-indigo-50 border border-indigo-200 text-indigo-700 px-2 py-0.5 rounded-full font-black">
                      ENABLED (HIGH)
                    </span>
                  </div>

                  {/* Device session encryption */}
                  <div className="flex items-center justify-between py-2.5">
                    <div>
                      <span className="font-extrabold text-gray-800 block">ఎండ్-టు-ఎండ్ సెషన్ ఎన్‌క్రిప్షన్</span>
                      <span className="text-[9px] text-gray-400 font-semibold">Your bookings and ledger logs are offline-encrypted</span>
                    </div>
                    <span className="text-[8px] bg-emerald-50 border border-emerald-200 text-emerald-700 px-2 py-0.5 rounded-full font-black flex items-center gap-0.5">
                      🔒 SECURE
                    </span>
                  </div>
                </div>
              </motion.div>
            )}

            {activeSection === 'storage' && (
              /* NESTED PAGE: STORAGE & DIAGNOSTICS (CACHE CLEANER) */
              <motion.div
                key="settings-storage"
                initial={{ opacity: 0, x: 15 }}
                animate={{ opacity: 1, x: 0 }}
                exit={{ opacity: 0, x: -15 }}
                className="space-y-4"
              >
                <button onClick={() => setActiveSection('main')} className="text-xs font-black text-[#082c75] hover:underline flex items-center gap-1 mb-2">
                  ← వెనుకకు / Go Back
                </button>

                <h4 className="font-extrabold text-xs text-gray-800 border-b border-gray-150 pb-2">స్టోరేజ్ & మెమరీ నిర్వహణ / Storage Cleaner</h4>

                <div className="bg-slate-50 border border-gray-150 rounded-2xl p-4 text-center space-y-4 text-xs">
                  <Database className="w-10 h-10 text-indigo-600 mx-auto animate-bounce" />
                  
                  <div className="space-y-1">
                    <span className="text-gray-500 font-bold block uppercase text-[10px]">CWRB యాప్ ఆక్యుపైడ్ డేటా:</span>
                    <span className="text-2xl font-black text-indigo-950 font-mono">
                      {cacheSize.toFixed(1)} MB
                    </span>
                  </div>

                  <p className="text-[10px] text-gray-500 max-w-xs mx-auto leading-relaxed">
                    యాప్ ఇమేజ్ క్యాష్, లాగిన్ సెషన్ తాత్కాలిక డూప్లికేట్ ఫైళ్లు మరియు ఇంటర్ఫేస్ డస్ట్ స్టోరేజీని వెంటనే క్లీన్ చేసి ఫోన్ వేగాన్ని పెంచండి.
                  </p>

                  {isCleaning ? (
                    <div className="space-y-2">
                      <div className="w-full h-2 bg-gray-200 rounded-full overflow-hidden relative">
                        <motion.div
                          initial={{ width: '0%' }}
                          animate={{ width: '100%' }}
                          transition={{ duration: 1.8, ease: 'easeInOut' }}
                          className="absolute top-0 bottom-0 left-0 bg-indigo-600 rounded-full shadow-[0_0_8px_#4f46e5]"
                        />
                      </div>
                      <span className="text-[10px] font-black text-indigo-600 animate-pulse block">మెమరీ డస్ట్ ఫైళ్లను క్లీన్ చేస్తోంది...</span>
                    </div>
                  ) : cleanFinished ? (
                    <div className="py-2 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded-xl font-bold flex items-center justify-center gap-1.5 animate-pulse">
                      <ShieldCheck className="w-4.5 h-4.5 text-emerald-600" />
                      <span>యాప్ స్టోరేజ్ క్లీన్ అయింది! (0.0 MB)</span>
                    </div>
                  ) : (
                    <button
                      onClick={handleCleanCache}
                      disabled={cacheSize === 0}
                      className="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 disabled:bg-gray-300 text-white font-extrabold rounded-xl transition shadow-md active:scale-95 flex items-center justify-center gap-1.5"
                    >
                      <Trash2 className="w-4 h-4" />
                      <span>మెమరీ క్లీన్ చేయి (Clean Cache Now)</span>
                    </button>
                  )}
                </div>
              </motion.div>
            )}

            {activeSection === 'help' && (
              /* NESTED PAGE: HELPDESK HELPLINE CHATBOT */
              <motion.div
                key="settings-help"
                initial={{ opacity: 0, x: 15 }}
                animate={{ opacity: 1, x: 0 }}
                exit={{ opacity: 0, x: -15 }}
                className="space-y-4"
              >
                <button onClick={() => setActiveSection('main')} className="text-xs font-black text-[#082c75] hover:underline flex items-center gap-1 mb-2">
                  ← వెనుకకు / Go Back
                </button>

                <h4 className="font-extrabold text-xs text-gray-800 border-b border-gray-150 pb-2">కస్టమర్ హెల్ప్‌లైన్ / Support Chat</h4>

                <div className="bg-slate-50 rounded-2xl border border-gray-150 p-3.5 space-y-3.5 text-xs text-gray-700">
                  <div className="bg-[#082c75] text-white p-3 rounded-2xl border border-[#FFC000]/30 space-y-1">
                    <div className="font-black flex items-center gap-1.5 text-[11px]">
                      <Sparkles className="w-3.5 h-3.5 text-[#FFC000]" />
                      <span>CWRB ఇంటరాక్టివ్ సపోర్ట్ అసిస్టెంట్</span>
                    </div>
                    <p className="text-[10px] text-gray-300 leading-relaxed">
                      మీకు ఏవైనా సాంకేతిక సమస్యలు ఉంటే కింద ఉన్న సపోర్ట్ గ్రూప్ కి కాల్ చేయండి లేదా మా వాట్సాప్ హెల్ప్‌లైన్ సంప్రదించండి.
                    </p>
                  </div>

                  <div className="space-y-2">
                    <a
                      href="tel:1800123456"
                      className="block w-full py-2.5 bg-white border border-gray-200 text-center rounded-xl hover:bg-slate-100 font-extrabold text-[#082c75] transition-colors active:scale-95 text-[11px]"
                    >
                      📞 టోల్ ఫ్రీ హెల్ప్‌లైన్: 1800-123-456
                    </a>
                    
                    <a
                      href="https://wa.me/919999999999?text=CWRB%20Support%20Help"
                      target="_blank"
                      rel="noopener noreferrer"
                      className="block w-full py-2.5 bg-emerald-600 text-white text-center rounded-xl hover:bg-emerald-500 font-black transition-colors active:scale-95 text-[11px]"
                    >
                      💬 వాట్సాప్ సహాయం (WhatsApp Direct Helpline)
                    </a>
                  </div>
                </div>
              </motion.div>
            )}

            {activeSection === 'admin_lock' && (
              /* SECURITY LOCK ACCESS PAGE FOR SWITCHBOARD */
              <motion.div
                key="settings-admin-lock"
                initial={{ opacity: 0, scale: 0.95 }}
                animate={{ opacity: 1, scale: 1 }}
                exit={{ opacity: 0, scale: 0.95 }}
                className="space-y-4"
              >
                <button onClick={() => setActiveSection('main')} className="text-xs font-black text-[#082c75] hover:underline flex items-center gap-1 mb-2">
                  ← వెనుకకు / Go Back
                </button>

                <div className="text-center space-y-2 py-1">
                  <div className="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center mx-auto text-amber-500 border border-amber-200 shadow-sm">
                    <ShieldAlert className="w-7 h-7 animate-pulse" />
                  </div>
                  <div className="space-y-0.5">
                    <h4 className="font-extrabold text-xs text-gray-800">అడ్మిన్ అథెంటికేషన్ అవసరం</h4>
                    <p className="text-[9px] text-gray-500 leading-relaxed">
                      మాస్టర్ కంట్రోల్ ప్యానెల్ లోని ఫీచర్లు మార్చడానికి వెరిఫై చేసుకోండి.
                    </p>
                  </div>
                </div>

                <form onSubmit={handleVerifyAdminAccess} className="space-y-3.5 text-xs">
                  {/* Pin field */}
                  <div className="space-y-1.5">
                    <label className="block text-[10px] font-extrabold text-gray-500 uppercase">పాస్‌వర్డ్ నమోదు చేయండి (Enter Passcode)</label>
                    <div className="relative flex items-center">
                      <Key className="absolute left-3 w-4 h-4 text-gray-400" />
                      <input 
                        type={showPassword ? "text" : "password"}
                        maxLength={32}
                        placeholder="పిన్ ఎంటర్ చేయండి"
                        value={password}
                        onChange={(e) => setPassword(e.target.value)}
                        className="w-full bg-slate-50 border border-gray-200 rounded-xl py-2 pl-9 pr-10 text-xs font-semibold text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-[#082c75]"
                      />
                      <button
                        type="button"
                        onClick={() => setShowPassword(!showPassword)}
                        className="absolute right-3 p-1 text-gray-400 hover:text-gray-600 transition"
                      >
                        {showPassword ? <EyeOff className="w-3.5 h-3.5" /> : <Eye className="w-3.5 h-3.5" />}
                      </button>
                    </div>
                    <div className="flex items-center gap-2 mt-1">
                      <button
                        type="button"
                        onClick={() => setShowPinHint(!showPinHint)}
                        className="text-gray-500 hover:text-[#082c75] p-1.5 rounded-lg border border-gray-200 bg-white cursor-pointer shadow-xs transition hover:scale-105 active:scale-95 inline-flex items-center justify-center"
                        title="పిన్ వివరాలు"
                      >
                        <Settings className="w-4 h-4 hover:rotate-90 transition-transform duration-300" />
                      </button>
                      {showPinHint && (
                        <span className="text-[10px] font-black text-emerald-600 font-mono animate-pulse bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                          PIN: {localStorage.getItem('cwb_admin_pwd') || '1234'}
                        </span>
                      )}
                    </div>
                  </div>

                  {/* Fingerprint area */}
                  <div className="space-y-1.5">
                    <label className="block text-[10px] font-extrabold text-gray-500 uppercase text-center">బయోమెట్రిక్ వేలిముద్ర (Touch Biometrics)</label>
                    <div className="flex flex-col items-center justify-center p-3.5 bg-slate-50 rounded-2xl border border-gray-100 relative overflow-hidden">
                      {fingerprintScanning && (
                        <motion.div 
                          initial={{ top: '0%' }}
                          animate={{ top: '100%' }}
                          transition={{ repeat: Infinity, duration: 1.2 }}
                          className="absolute left-0 right-0 h-0.5 bg-emerald-500 shadow-[0_0_8px_#10b981] z-10"
                        />
                      )}

                      <button
                        type="button"
                        onClick={handleFingerprintTouch}
                        className={`w-16 h-16 rounded-full border flex items-center justify-center transition-all ${
                          fingerprintScanned 
                            ? 'bg-emerald-50 border-emerald-400 text-emerald-600 shadow-[0_0_12px_rgba(16,185,129,0.15)]' 
                            : fingerprintScanning 
                              ? 'bg-cyan-50 border-cyan-400 text-cyan-500 animate-pulse'
                              : 'bg-white border-gray-200 text-[#082c75] hover:border-[#082c75]'
                        } active:scale-95`}
                      >
                        {fingerprintScanned ? <ShieldCheck className="w-9 h-9" /> : <Fingerprint className="w-9 h-9" />}
                      </button>

                      <span className="text-[9px] font-extrabold text-gray-400 mt-2">
                        {fingerprintScanned ? 'వెరిఫై అయింది!' : 'స్కాన్ కోసం పైన బటన్ నొక్కండి'}
                      </span>
                    </div>
                  </div>

                  {adminError && (
                    <p className="text-[9px] font-bold text-rose-500 leading-tight">{adminError}</p>
                  )}

                  <button
                    type="submit"
                    className="w-full py-2.5 bg-[#082c75] text-white font-extrabold rounded-xl transition active:scale-95"
                  >
                    అడ్మిన్ ప్యానెల్ అన్‌లాక్ చేయి
                  </button>
                </form>
              </motion.div>
            )}

          </AnimatePresence>
        </div>

        {/* Persistently aligned Bottom navigation action buttons */}
        <div className="p-4 bg-slate-50 border-t border-gray-100 shrink-0 flex items-center justify-between">
          <button
            onClick={onLogout}
            className="px-3.5 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 text-[10px] font-black rounded-xl border border-rose-200 flex items-center gap-1.5 transition active:scale-95"
          >
            {t('logout', language)}
          </button>

          <button
            onClick={onClose}
            className="px-5 py-2.5 bg-[#082c75] hover:bg-[#001040] text-[#FFC000] text-[10px] font-black rounded-xl shadow-md transition active:scale-95"
          >
            {t('close', language)}
          </button>
        </div>

      </div>
      
    </div>
  );
}
